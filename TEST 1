    btn.BackgroundColor3 = initial and Color3.fromRGB(0,200,100) or Color3.fromRGB(200,60,60)
    btn.BorderSizePixel = 0
    btn.Text = initial and "ON" or "OFF"
    btn.TextColor3 = Color3.fromRGB(255,255,255)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = bigText(14)
    btn.Parent = row
    
    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundTransparency = 0.3}):Play()
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundTransparency = 0}):Play()
    end)
    
    return {label = lbl, button = btn, value = initial}
end

local function addSliderRow(parent, labelText, minVal, maxVal, initVal, unit, callback)
    local row = addControl(parent, 48)
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(0.6, 0, 0, s(20))
    lbl.BackgroundTransparency = 1
    lbl.Text = labelText .. ": " .. string.format("%.2f", initVal) .. unit
    lbl.TextColor3 = Color3.fromRGB(200,200,220)
    lbl.Font = Enum.Font.Gotham
    lbl.TextSize = bigText(14)
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = row
    
    local slider = Instance.new("Frame")
    slider.Size = UDim2.new(0.35, 0, 0, s(16))
    slider.Position = UDim2.new(0.6, 0, 0.5, -s(8))
    slider.BackgroundColor3 = Color3.fromRGB(40,40,60)
    slider.BorderSizePixel = 0
    slider.Parent = row
    
    local fill = Instance.new("Frame")
    fill.Size = UDim2.new((initVal - minVal) / (maxVal - minVal), 0, 1, 0)
    fill.BackgroundColor3 = Color3.fromRGB(0, 200, 255)
    fill.BorderSizePixel = 0
    fill.Parent = slider
    
    local valLabel = Instance.new("TextLabel")
    valLabel.Size = UDim2.new(0.15, 0, 1, 0)
    valLabel.Position = UDim2.new(0.85, 0, 0, 0)
    valLabel.BackgroundTransparency = 1
    valLabel.Text = string.format("%.2f", initVal) .. unit
    valLabel.TextColor3 = Color3.fromRGB(255,255,255)
    valLabel.Font = Enum.Font.Gotham
    valLabel.TextSize = bigText(14)
    valLabel.Parent = row
    
    local dragging = false
    
    slider.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
        end
    end)
    
    slider.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local pos = input.Position
            local framePos = slider.AbsolutePosition
            local width = slider.AbsoluteSize.X
            if width > 0 then
                local percent = math.clamp((pos.X - framePos.X) / width, 0, 1)
                local val = minVal + percent * (maxVal - minVal)
                fill.Size = UDim2.new(percent, 0, 1, 0)
                valLabel.Text = string.format("%.2f", val) .. unit
                lbl.Text = labelText .. ": " .. string.format("%.2f", val) .. unit
                callback(val)
            end
        end
    end)
    
    return {slider = slider, fill = fill, valLabel = valLabel}
end

