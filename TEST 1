local function createScroller()
    local scroller = Instance.new("ScrollingFrame")
    scroller.Size = UDim2.new(1, 0, 1, 0)
    scroller.BackgroundTransparency = 1
    scroller.CanvasSize = UDim2.new(0, 0, 0, 0)
    scroller.ScrollBarThickness = s(4)
    scroller.Visible = false
    scroller.ClipsDescendants = false
    scroller.Parent = contentContainer
    
    local layout = Instance.new("UIListLayout")
    layout.Parent = scroller
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Padding = UDim.new(0, s(12))
    
    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        scroller.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + s(10))
    end)
    
    return scroller, layout
end

