    valLabel.TextColor3 = Color3.fromRGB(255,255,255)
    valLabel.Font = Enum.Font.Gotham
    valLabel.TextSize = bigText(14)
    valLabel.Parent = row
    
    local dragging = false
    
    slider.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
        end
    end)
    
    slider.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local pos = input.Position
            local framePos = slider.AbsolutePosition
            local width = slider.AbsoluteSize.X
            if width > 0 then
                local percent = math.clamp((pos.X - framePos.X) / width, 0, 1)
                local val = minVal + percent * (maxVal - minVal)
                fill.Size = UDim2.new(percent, 0, 1, 0)
                valLabel.Text = string.format("%.2f", val) .. unit
                lbl.Text = labelText .. ": " .. string.format("%.2f", val) .. unit
                callback(val)
            end
        end
    end)
    
    return {slider = slider, fill = fill, valLabel = valLabel}
end

