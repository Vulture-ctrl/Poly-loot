local function performClick()
    local x = CONFIG.AutoClickX
    local y = CONFIG.AutoClickY
    pcall(function()
        if mouse1click then
            mouse1click(x, y)
            return
        end
        local center = Vector2.new(x, y)
        local moveInput = Instance.new("InputObject")
        moveInput.UserInputType = UserInputService.TouchEnabled and Enum.UserInputType.Touch or Enum.UserInputType.MouseMovement
        moveInput.Position = center
        moveInput.Delta = Vector2.new(0,0)
        UserInputService:FireInput(moveInput)
        task.wait(0.01)
        
        local downInput = Instance.new("InputObject")
        downInput.UserInputType = UserInputService.TouchEnabled and Enum.UserInputType.Touch or Enum.UserInputType.MouseButton1
        downInput.Position = center
        downInput.Delta = Vector2.new(0,0)
        UserInputService:FireInput(downInput)
        task.wait(0.05)
        
        local upInput = Instance.new("InputObject")
        upInput.UserInputType = downInput.UserInputType
        upInput.Position = center
        upInput.Delta = Vector2.new(0,0)
        upInput.UserInputState = Enum.UserInputState.End
        UserInputService:FireInput(upInput)
    end)
    aimCircle.BackgroundTransparency = 0.1
    task.wait(0.05)
    aimCircle.BackgroundTransparency = 0.3
end

-- ============================================================
--  GARGOYLE FARM – stay behind continuously, no return (FIXED)
-- ============================================================
local gargoyleFarmRunning = false
local gargoyleFarmThread = nil
local gargoyleBtn = nil
local gargoyleStatusLabel = nil

local function getNearestGargoyle()
    local char = player.Character
    if not char then return nil, nil end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return nil, nil end
    local pos = root.Position
    local nearest, nearestDist = nil, math.huge
    
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and string.lower(obj.Name):find("gargoyle") then
            local part = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Head") or obj:FindFirstChildWhichIsA("BasePart")
            if part then
                local d = (part.Position - pos).Magnitude
                if d < nearestDist then
                    nearestDist = d
                    nearest = obj
                end
            end
        end
    end
    return nearest, nearestDist
end

function toggleGargoyleFarm()
    -- TURN OFF
    if gargoyleFarmRunning then
        gargoyleFarmRunning = false
        if gargoyleFarmThread then
            task.cancel(gargoyleFarmThread)
            gargoyleFarmThread = nil
        end
        status.Text = "Gargoyle farm stopped"
        if gargoyleBtn then
            gargoyleBtn.Text = "🧛 Gargoyle Farm (OFF)"
            gargoyleBtn.BackgroundColor3 = Color3.fromRGB(200, 60, 60)
        end
        if gargoyleStatusLabel then
            gargoyleStatusLabel.Text = "Gargoyle farm: OFF"
            gargoyleStatusLabel.TextColor3 = Color3.fromRGB(200,200,200)
        end
        return
    end
    
    -- CHECK PLAYER
    local char = player.Character
    if not char then
        status.Text = "Character not loaded"
        return
    end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then
        status.Text = "RootPart not found"
        return
    end
    
    -- TURN ON
    gargoyleFarmRunning = true
    if gargoyleBtn then
        gargoyleBtn.Text = "🧛 Gargoyle Farm (ON)"
        gargoyleBtn.BackgroundColor3 = Color3.fromRGB(60, 200, 60)
    end
    if gargoyleStatusLabel then
        gargoyleStatusLabel.Text = "Gargoyle farm: ACTIVE (behind)"
        gargoyleStatusLabel.TextColor3 = Color3.fromRGB(0,255,100)
    end
    status.Text = "Gargoyle farming started – staying behind"
    
    gargoyleFarmThread = task.spawn(function()
        while gargoyleFarmRunning do
            -- FIND NEAREST GARGOYLE
            local mob, dist = getNearestGargoyle()
            
            if mob then
                local rootPart = mob:FindFirstChild("HumanoidRootPart") or mob:FindFirstChildWhichIsA("BasePart")
                if rootPart then
                    -- CALCULATE POSITION BEHIND THE MOB (FACING TOWARD IT)
                    local behindOffset = -rootPart.CFrame.LookVector * 6
                    local targetPos = rootPart.Position + behindOffset + Vector3.new(0, 3, 0)
                    local char = player.Character
                    
                    if char then
                        local playerRoot = char:FindFirstChild("HumanoidRootPart")
                        if playerRoot then
                            -- MOVE BEHIND THE GARGOYLE AND FACE TOWARD IT
                            local tweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
                            local tween = TweenService:Create(playerRoot, tweenInfo, {
                                CFrame = CFrame.new(targetPos, rootPart.Position)
                            })
                            tween:Play()
                        end
                    end
                    status.Text = "Following Gargoyle from behind (dist " .. math.floor(dist) .. ")"
                end
            else
                status.Text = "No Gargoyle found, waiting..."
                task.wait(1)
            end
            
            -- CONSTANTLY RESCAN SO IT STAYS BEHIND
            task.wait(0.3)
        end
    end)
end

-- ============================================================
--  STAY BEHIND (bosses)
-- ============================================================
local stayBehindConnection = nil

local function startStayBehind(mobName)
    if stayBehindConnection then
        stayBehindConnection:Disconnect()
    end
    cheats.stayBehind = true
    cheats.stayBehindTarget = mobName
    
    stayBehindConnection = RunService.Heartbeat:Connect(function()
        if not cheats.stayBehind then
            stayBehindConnection:Disconnect()
            stayBehindConnection = nil
            return
        end
        
        local mobModel = Workspace:FindFirstChild(mobName)
        if not mobModel then
            status.Text = mobName .. " not found, stopping follow"
            stopStayBehind()
            return
        end
        
        local rootPart = mobModel:FindFirstChild("HumanoidRootPart") or mobModel:FindFirstChildWhichIsA("BasePart")
        if not rootPart then return end
        
        local behindOffset = -rootPart.CFrame.LookVector * 6
        local targetPos = rootPart.Position + behindOffset + Vector3.new(0, 3, 0)
        
        local char = player.Character
        if char then
            local root = char:FindFirstChild("HumanoidRootPart")
            if root then
                local tweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
                local tween = TweenService:Create(root, tweenInfo, {
                    CFrame = CFrame.new(targetPos, rootPart.Position)
                })
                tween:Play()
            end
        end
    end)
    status.Text = "Following " .. mobName .. " (behind)"
end

local function stopStayBehind()
    cheats.stayBehind = false
    if stayBehindConnection then
        stayBehindConnection:Disconnect()
        stayBehindConnection = nil
    end
    status.Text = "Stopped following"
end

