-- ===== BOSS TRACKER =====
local bossData = {
    Chicken = {modelName = "King ChickenSpawn", cooldown = 300, lastSeenAlive = 0, statusLabel = nil},
    Spider = {modelName = "SpiderSpawn", cooldown = 600, lastSeenAlive = 0, statusLabel = nil}
}

local function updateBossStatus()
    for key, data in pairs(bossData) do
        local model = Workspace:FindFirstChild(data.modelName)
        if model then
            data.lastSeenAlive = tick()
            if data.statusLabel then
                data.statusLabel.Text = "🟢 Alive"
                data.statusLabel.TextColor3 = Color3.fromRGB(0, 255, 100)
            end
        else
            if data.lastSeenAlive == 0 then
                if data.statusLabel then
                    data.statusLabel.Text = "❓ Unknown"
                    data.statusLabel.TextColor3 = Color3.fromRGB(200,200,200)
                end
            else
                local elapsed = tick() - data.lastSeenAlive
                if elapsed < data.cooldown then
                    local remaining = data.cooldown - elapsed
                    local mins = math.floor(remaining / 60)
                    local secs = math.floor(remaining % 60)
                    if data.statusLabel then
                        data.statusLabel.Text = string.format("🔴 Dead – %dm %ds", mins, secs)
                        data.statusLabel.TextColor3 = Color3.fromRGB(255,80,80)
                    end
                else
                    if data.statusLabel then
                        data.statusLabel.Text = "🟡 Respawning..."
                        data.statusLabel.TextColor3 = Color3.fromRGB(255,200,50)
                    end
                end
            end
        end
    end
end

