    if clickConnection then clickConnection:Disconnect(); clickConnection = nil end
    if gargoyleFarmThread then task.cancel(gargoyleFarmThread); gargoyleFarmThread = nil end
    if gargoyleBodyVelocity then gargoyleBodyVelocity:Destroy(); gargoyleBodyVelocity = nil end
    if gargoyleBodyPosition then gargoyleBodyPosition:Destroy(); gargoyleBodyPosition = nil end
    
    for key, data in pairs(bossFarms) do
        if data.running then
            data.running = false
        end
        if bossFarmThreads[key] then
            task.cancel(bossFarmThreads[key])
            bossFarmThreads[key] = nil
        end
        if data.bodyVelocity then
            data.bodyVelocity:Destroy()
            data.bodyVelocity = nil
        end
        if data.bodyPosition then
            data.bodyPosition:Destroy()
            data.bodyPosition = nil
        end
        if data.timerConnection then
            data.timerConnection:Disconnect()
            data.timerConnection = nil
        end
    end
    
    local char = player.Character
    if char then
        local hum = char:FindFirstChild("Humanoid")
        if hum then
            hum.PlatformStand = false
        end
    end
    pcall(function() screenGui:Destroy() end)
end

