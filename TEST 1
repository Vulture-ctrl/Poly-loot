-- ===== LOOT FUNCTION =====
local function getNearestLoot()
    local char = player.Character
    if not char then return nil end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    local pos = root.Position
    local nearest, dist = nil, 50
    
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Parent and obj.Parent:IsA("Model") then
            local name = obj.Name:lower()
            if name:match("drop") or name:match("crate") or name:match("item") or name:match("loot") or name:match("chest") then
                local d = (obj.Position - pos).Magnitude
                if d < dist then
                    dist = d
                    nearest = obj
                end
            end
        end
    end
    return nearest, dist
end

local function instantLoot()
    local char = player.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    local item, dist = getNearestLoot()
    if not item then
        status.Text = "No loot found"
        return
    end
    
    local originalCF = root.CFrame
    tweenToPosition(item.Position + Vector3.new(0, 2, 0), 0.4)
    status.Text = "Looting..."
    task.wait(0.5)
    
    local prompt = nil
    if item.Parent then
        prompt = item.Parent:FindFirstChildWhichIsA("ProximityPrompt")
    end
    if not prompt then
        prompt = item:FindFirstChildWhichIsA("ProximityPrompt")
    end
    
    if prompt then
        prompt:Fire(player)
        status.Text = "Proximity prompt triggered"
    else
        for _, gui in ipairs(player.PlayerGui:GetDescendants()) do
            if gui:IsA("TextButton") or gui:IsA("ImageButton") then
                local txt = (gui.Text or ""):lower()
                if txt:match("collect") or txt:match("pickup") or txt:match("loot") or txt:match("take") then
                    gui:Fire()
                    gui.Activated:Fire()
                    status.Text = "Collect button pressed"
                    break
                end
            end
        end
    end
    
    local pickupRemote = safeFind("Item_Engine", "Remotes", "PickupItem")
    if pickupRemote then
        pickupRemote:FireServer(item.Parent and item.Parent.Name or item.Name)
        status.Text = "Pickup remote fired"
    end
    
    task.wait(CONFIG.LootHoldSeconds)
    tweenToPosition(originalCF.Position, 0.4)
    status.Text = "Loot done"
    task.wait(0.5)
    status.Text = running and "Status: Running" or "Status: Stopped"
end

