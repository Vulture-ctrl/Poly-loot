function toggleAutoClicker()
    if not cheats.autoClick and cheats.autoClickCooldown > tick() then
        local remaining = math.ceil(cheats.autoClickCooldown - tick())
        status.Text = "Cooldown: wait " .. remaining .. "s"
        return
    end
    
    cheats.autoClick = not cheats.autoClick
    
    if cheats.autoClick then
        cheats.autoClickStartTime = tick() + 3
        cheats.autoClickActive = false
        playerToggles.autoClickToggle.label.Text = "Auto Clicker: Starting in 3s..."
        playerToggles.autoClickToggle.button.Text = "Wait"
        playerToggles.autoClickToggle.button.BackgroundColor3 = Color3.fromRGB(200,200,50)
        miniACBtn.Text = "AC: Wait"
        miniACBtn.BackgroundColor3 = Color3.fromRGB(200,200,50)
        aimCircle.BackgroundTransparency = 0.3
    else
        cheats.autoClickStartTime = 0
        cheats.autoClickActive = false
        cheats.autoClickCooldown = tick() + 2
        playerToggles.autoClickToggle.label.Text = "Auto Clicker: OFF (cooldown 2s)"
        playerToggles.autoClickToggle.button.Text = "OFF"
        playerToggles.autoClickToggle.button.BackgroundColor3 = Color3.fromRGB(200,60,60)
        miniACBtn.Text = "AC: CD 2s"
        miniACBtn.BackgroundColor3 = Color3.fromRGB(200,200,50)
        aimCircle.BackgroundTransparency = 0.7
    end
end

