local running = false
local attackCount = 0
local collectCount = 0
local lastCollect = tick()
local lastAFK = tick()

local function doAntiAFK()
    if not cheats.antiAFK then return end
    local char = player.Character
    if char and char:FindFirstChild("Humanoid") then
        local hum = char.Humanoid
        local moveDir = Vector3.new(math.random(-1,1), 0, math.random(-1,1))
        if moveDir.Magnitude > 0 then
            hum:Move(moveDir.Unit, true)
            task.wait(0.15)
            hum:Move(Vector3.new(0,0,0), true)
        end
    end
end

local function collectGold()
    local char = player.Character
    if char then
        local root = char:FindFirstChild("HumanoidRootPart")
        if root then
            local originalCF = root.CFrame
            tweenToPosition(GOLD_MINE_POS + Vector3.new(0,5,0), 0.5)
            task.wait(0.3)
            if collectRequest then
                collectRequest:FireServer(CONFIG.CollectAmount)
                collectCount = collectCount + 1
                status.Text = "Status: Collecting... ("..collectCount..")"
            end
            tweenToPosition(originalCF.Position, 0.4)
            return
        end
    end
    if collectRequest then
        collectRequest:FireServer(CONFIG.CollectAmount)
        collectCount = collectCount + 1
        status.Text = "Status: Collecting... ("..collectCount..")"
    end
end

local function performRarityAction(action, rarityList)
    if not inventoryCache or next(inventoryCache) == nil then
        status.Text = "Inventory empty – press Refresh Inventory"
        return
    end
    
    local processed = 0
    local processAll = false
    for _, r in ipairs(rarityList) do
        if r == "All" then processAll = true; break end
    end
    
    for serial, item in pairs(inventoryCache) do
        local itemRarity = item.rarity or "Common"
        local shouldProcess = false
        
        if processAll then
            shouldProcess = true
        else
            for _, r in ipairs(rarityList) do
                if r == itemRarity then
                    shouldProcess = true
                    break
                end
            end
        end
        
        if shouldProcess then
            if action == "Sell" and sellRequest then
                sellRequest:FireServer({[serial] = 1})
                processed = processed + 1
            elseif action == "Upgrade" and upgradeRequest then
                upgradeRequest:FireServer(serial)
                processed = processed + 1
            elseif action == "Dismantle" and dismantleRequest then
                dismantleRequest:FireServer(serial)
                processed = processed + 1
            end
        end
    end
    
    if processed > 0 then
        status.Text = "Auto-" .. action .. " processed " .. processed .. " items"
    end
end

local function startFarm()
    if running then return end
    if not weaponAttack then
        status.Text = "WeaponAttack remote not found!"
        return
    end
    running = true
    status.Text = "Status: Running"
    status.TextColor3 = Color3.fromRGB(0,255,150)
    attackCount = 0
    collectCount = 0
    lastCollect = tick()
    lastAFK = tick()
    
    task.spawn(function()
        while running do
            if CONFIG.EnableAttack then
                weaponAttack:FireServer(0)
                attackCount = attackCount + 1
                if attackCount % 50 == 0 then
                    status.Text = "Status: "..attackCount.." attacks"
                end
            end
            
            local delay = CONFIG.AttackDelay + math.random() * CONFIG.DelayVariation
            task.wait(delay)
            
            if CONFIG.EnableCollect and collectRequest and tick() - lastCollect > CONFIG.CollectInterval then
                collectGold()
                lastCollect = tick()
            end
            
            if CONFIG.AutoLoot then
                local lootItem, lootDist = getNearestLoot()
                if lootItem and lootDist < 30 then
                    instantLoot()
                end
            end
            
            for _, action in ipairs(autoActions) do
                if actionToggles[action] and actionToggles[action].enabled() then
                    local rarities = actionToggles[action].getRarities()
                    performRarityAction(action, rarities)
                    task.wait(0.3)
                end
            end
            
            if cheats.antiAFK and tick() - lastAFK > CONFIG.AntiAFKInterval then
                doAntiAFK()
                lastAFK = tick()
            end
        end
    end)
end

local function stopFarm()
    running = false
    status.Text = "Status: Stopped"
    status.TextColor3 = Color3.fromRGB(255,100,100)
end

-- ===== LOOT FUNCTION =====
local function getNearestLoot()
    local char = player.Character
    if not char then return nil end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    local pos = root.Position
    local nearest, dist = nil, 50
    
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Parent and obj.Parent:IsA("Model") then
            local name = obj.Name:lower()
            if name:match("drop") or name:match("crate") or name:match("item") or name:match("loot") or name:match("chest") or name:match("bag") then
                local d = (obj.Position - pos).Magnitude
                if d < dist then
                    dist = d
                    nearest = obj
                end
            end
        end
    end
    return nearest, dist
end

local function instantLoot()
    local char = player.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    local item, dist = getNearestLoot()
    if not item then
        return
    end
    
    local originalCF = root.CFrame
    tweenToPosition(item.Position + Vector3.new(0, 2, 0), 0.3)
    task.wait(0.3)
    
    local prompt = nil
    if item.Parent then
        prompt = item.Parent:FindFirstChildWhichIsA("ProximityPrompt")
    end
    if not prompt then
        prompt = item:FindFirstChildWhichIsA("ProximityPrompt")
    end
    
    if prompt then
        prompt:Fire(player)
    end
    
    local pickupRemote = safeFind("Item_Engine", "Remotes", "PickupItem")
    if pickupRemote then
        pickupRemote:FireServer(item.Parent and item.Parent.Name or item.Name)
    end
    
    task.wait(0.5)
    tweenToPosition(originalCF.Position, 0.3)
end

