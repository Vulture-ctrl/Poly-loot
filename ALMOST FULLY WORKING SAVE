    archeryRound3PatternBull = bull
    archeryRound3PatternConfidence = 0
    archeryRound3PatternPeriod = 0
    -- A new target/round must earn a fresh first-shot phase anchor.
    archeryRound3ShotAnchorBull = nil
    archeryRound3ShotAnchorPosition = nil
    archeryRound3ShotAnchorDirection = nil
    archeryRound3ShotAnchorSpeed = 0
    archeryRound3ShotAnchorTime = 0
    archeryRound3ShotAnchorPeriod = 0
end

local function canCarryRound3PatternToReplacement(now, position, velocity)
    local history = archeryRound3History
    if #history < 18 or typeof(position) ~= "Vector3" then
        return false
    end

    local speed = typeof(velocity) == "Vector3" and velocity.Magnitude or 0
    for i = #history, 1, -1 do
        local sample = history[i]
        local age = now - sample.t
        if age > ARCHERY_ROUND3_REPLACEMENT_MAX_SAMPLE_AGE then
            break
        end
        if (sample.p - position).Magnitude <= ARCHERY_ROUND3_REPLACEMENT_POS_TOLERANCE then
            local sampleSpeed = sample.v.Magnitude
            if speed <= 1 or sampleSpeed <= 1
                or velocity.Unit:Dot(sample.v.Unit) >= ARCHERY_ROUND3_REPLACEMENT_DIRECTION_DOT then
                return true
            end
        end
    end
    return false
end

local function round3ReplacementSeedVelocity(now, position, fallbackVelocity)
    local history = archeryRound3History
    local bestVelocity = nil
    local bestMetric = math.huge
    local fallbackSpeed = typeof(fallbackVelocity) == "Vector3" and fallbackVelocity.Magnitude or 0
    local positionTolerance = archeryRound3ShotAnchorPosition
        and math.max(ARCHERY_ROUND3_REPLACEMENT_POS_TOLERANCE, 4.25)
        or ARCHERY_ROUND3_REPLACEMENT_POS_TOLERANCE

    for i = #history, 1, -1 do
        local sample = history[i]
        local age = now - sample.t
        if age > ARCHERY_ROUND3_REPLACEMENT_MAX_SAMPLE_AGE then
            break
        end
        local posError = (sample.p - position).Magnitude
        if posError <= positionTolerance then
            local sampleSpeed = sample.v.Magnitude
            local directionPenalty = 0
            if fallbackSpeed > 1 and sampleSpeed > 1 then
                local dot = math.clamp(fallbackVelocity.Unit:Dot(sample.v.Unit), -1, 1)
                directionPenalty = (1 - dot) * 0.65
            end
            local metric = posError + directionPenalty + age * 0.015
            if metric < bestMetric then
                bestMetric = metric
                bestVelocity = sample.v
            end
        end
    end

    if bestVelocity and bestVelocity.Magnitude > 1 then
        return bestVelocity
    end
    if typeof(fallbackVelocity) == "Vector3" then
        return fallbackVelocity
    end
    return Vector3.zero
end

local function recordRound3PatternSample(bull, now, position, velocity)
    if archeryRound3PatternBull ~= bull then
        if canCarryRound3PatternToReplacement(now, position, velocity) then
            -- Same Round 3 repeating path, new per-shot target Instance. Keep history,
            -- pattern confidence and the first proven 9-phase anchor.
            archeryRound3PatternBull = bull
            archeryRound3Bulls[bull] = true
            archeryRound3ShotAnchorBull = bull
        else
            resetRound3PatternHistory(bull)
        end
    end

    local history = archeryRound3History
    local last = history[#history]
    if last and now - last.t < 0.010 then
        return
    end

    history[#history + 1] = {
        t = now,
        p = position,
        v = typeof(velocity) == "Vector3" and velocity or Vector3.zero,
    }

    local cutoff = now - ARCHERY_ROUND3_PATTERN_HISTORY
    while #history > 2 and history[1].t < cutoff do
        table.remove(history, 1)
    end
end

local function findRound3PatternMatch(rawCenter, velocity, now)
    local history = archeryRound3History
    if #history < 18 then
        archeryRound3PatternConfidence = 0
        return nil, 0
    end

    local currentSpeed = velocity.Magnitude
    local positionTolerance = math.max(
        ARCHERY_ROUND3_PATTERN_POS_TOLERANCE,
        math.min(1.35, 0.25 + currentSpeed * 0.018)
    )
    local bestIndex = nil
    local bestMetric = math.huge
    local bestConfidence = 0
    local bestAge = 0

    for i = #history - 2, 1, -1 do
        local sample = history[i]
        local age = now - sample.t
        if age > ARCHERY_ROUND3_PATTERN_MAX_PERIOD then
            break
        end
        if age >= ARCHERY_ROUND3_PATTERN_MIN_PERIOD then
            local posError = (sample.p - rawCenter).Magnitude
            if posError <= positionTolerance then
                local sampleSpeed = sample.v.Magnitude
                local velocityDot = 1
                if currentSpeed > 1 and sampleSpeed > 1 then
                    velocityDot = math.clamp(velocity.Unit:Dot(sample.v.Unit), -1, 1)
                end
                if velocityDot >= ARCHERY_ROUND3_PATTERN_VELOCITY_DOT then
                    local speedError = math.abs(sampleSpeed - currentSpeed)
                    local metric = posError
                        + (1 - velocityDot) * 0.55
                        + math.min(speedError / 90, 1) * 0.22
                    if metric < bestMetric then
                        bestMetric = metric
                        bestIndex = i
                        bestAge = age
                        bestConfidence = math.clamp(
                            1
                            - (posError / positionTolerance) * 0.62
                            - (1 - velocityDot) * 0.30
                            - math.min(speedError / 120, 1) * 0.08,
                            0,
                            1
                        )
                    end
                end
            end
        end
    end

    if bestIndex and bestConfidence >= ARCHERY_ROUND3_PATTERN_MIN_CONFIDENCE then
        archeryRound3PatternConfidence = bestConfidence
        if archeryRound3PatternPeriod <= 0 then
            archeryRound3PatternPeriod = bestAge
        else
            archeryRound3PatternPeriod = archeryRound3PatternPeriod * 0.80 + bestAge * 0.20
        end
        return bestIndex, bestConfidence
    end

    archeryRound3PatternConfidence = 0
    return nil, 0
end

local function round3PatternPhaseCorrection(matchIndex, rawCenter)
    local sample = archeryRound3History[matchIndex]
    if not sample then return 0, Vector3.zero end
    local delta = rawCenter - sample.p
    local speedSq = sample.v:Dot(sample.v)
    if speedSq <= 4 then
        return 0, delta
    end
    -- Convert along-path position error into a tiny phase-time correction. The
    -- remaining perpendicular error is kept only as a small cycle-to-cycle offset.
    local phase = math.clamp(delta:Dot(sample.v) / speedSq, -0.020, 0.020)
    local residual = delta - sample.v * phase
    if residual.Magnitude > 0.35 then
        residual = residual.Unit * 0.35
    end
    return phase, residual
end

local function round3PatternPositionFromMatch(matchIndex, futureT, offset)
    if not matchIndex or futureT < 0 then
        return nil
    end
    -- If the arrow's look-ahead spans more than one learned cycle, wrap it back to
    -- the same phase of the repeating path instead of abandoning the pattern model.
    if archeryRound3PatternPeriod > 0.05 and futureT >= archeryRound3PatternPeriod then
        futureT = futureT % archeryRound3PatternPeriod
    end
    if futureT > ARCHERY_ROUND3_PATTERN_MAX_LOOKAHEAD then
        return nil
    end
    local history = archeryRound3History
    local base = history[matchIndex]
    if not base then return nil end
    local wanted = base.t + futureT

    local previous = base
    for i = matchIndex + 1, #history do
        local sample = history[i]
        if sample.t >= wanted then
            local span = sample.t - previous.t
            local alpha = span > 0.0001 and math.clamp((wanted - previous.t) / span, 0, 1) or 0
            local p = previous.p:Lerp(sample.p, alpha)
            return p + (offset or Vector3.zero)
        end
        previous = sample
    end
    return nil
end

local function currentRound3PatternPrediction(rawCenter, velocity, futureT, now)
    local matchIndex, confidence = findRound3PatternMatch(rawCenter, velocity, now)
    if not matchIndex then return nil, confidence end
    local matched = archeryRound3History[matchIndex]
    if not matched then return nil, 0 end
    local phaseCorrection, residualOffset = round3PatternPhaseCorrection(matchIndex, rawCenter)
    return round3PatternPositionFromMatch(
        matchIndex,
        math.max(0, futureT + phaseCorrection),
        residualOffset
    ), confidence
end

local function resetRound3TenScan()
    local scan = archeryRound3TenScan
    scan.startedAt = 0
    scan.startPosition = nil
    scan.startDirection = nil
    scan.startSpeed = 0
    scan.loopComplete = false
    scan.loopPeriod = 0
    scan.phaseLocked = false
    scan.bestError = math.huge
    scan.bestPosition = nil
    scan.bestDirection = nil
    scan.bestSpeed = 0
    scan.bestSeenAt = 0
    scan.bestUsedClosest = false
    scan.confirmFrames = 0
end

local function beginOrUpdateRound3TenScan(rawCenter, targetVelocity, now)
    local scan = archeryRound3TenScan
    local speed = typeof(targetVelocity) == "Vector3" and targetVelocity.Magnitude or 0

    if scan.startedAt <= 0 then
        scan.startedAt = now
        scan.startPosition = rawCenter
        scan.startDirection = speed > 1 and targetVelocity.Unit or nil
        scan.startSpeed = speed
        scan.loopComplete = false
        scan.loopPeriod = 0
        scan.phaseLocked = false
        scan.bestError = math.huge
        scan.bestPosition = nil
        scan.bestDirection = nil
        scan.bestSpeed = 0
        scan.bestSeenAt = 0
        scan.bestUsedClosest = false
        scan.confirmFrames = 0
        return scan
    end

    if not scan.loopComplete and scan.startPosition then
        local elapsed = now - scan.startedAt
        if elapsed >= 0.68 then
            -- The target moves fast enough to skip a tiny start corridor between render
            -- samples. Use a speed-aware corridor plus travel direction to recognize
            -- the completed figure-8 without waiting forever.
            local posTolerance = math.max(1.10, math.min(2.25, 0.55 + speed * 0.024))
            local positionMatch = (rawCenter - scan.startPosition).Magnitude <= posTolerance
            local directionMatch = true
            if scan.startDirection and speed > 1 then
                directionMatch = targetVelocity.Unit:Dot(scan.startDirection) >= 0.78
            end

            if positionMatch and directionMatch then
                scan.loopComplete = true
                scan.loopPeriod = elapsed
                scan.phaseLocked = scan.bestPosition ~= nil
            elseif archeryRound3PatternPeriod >= 0.55
                and archeryRound3PatternConfidence >= 0.52
                and elapsed >= archeryRound3PatternPeriod * 0.92 then
                scan.loopComplete = true
                scan.loopPeriod = archeryRound3PatternPeriod
                scan.phaseLocked = scan.bestPosition ~= nil
            elseif elapsed >= 2.80 then
                -- Last-resort scan completion. We still do NOT fire until a deep 10
                -- candidate is actually observed; this only prevents a missed phase
                -- crossing from disabling Auto Shoot forever.
                scan.loopComplete = true
                scan.loopPeriod = math.max(0.68, archeryRound3PatternPeriod)
                scan.phaseLocked = scan.bestPosition ~= nil
            end
        end
    end

    return scan
end

local function considerRound3PureTenPhase(target, bull, rawCenter, targetVelocity, score, errorDistance, trustworthy, usedClosestApproach, now)
    local scan = beginOrUpdateRound3TenScan(rawCenter, targetVelocity, now)
    if scan.phaseLocked then
        return scan
    end
    if not trustworthy or score ~= 10 or not errorDistance then
        return scan
    end

    local radii = getArcheryRingRadii(target, bull)
    local r10 = radii[1]
    if not r10 then
        return scan
    end

    -- V60: V59 starved Auto Shoot because it rejected every closest-approach solve.
    -- Let an extremely deep/straight fallback 10 DISCOVER the repeat phase, but give
    -- it a penalty so a true plane-crossing 10 always wins when both are available.
    local discoveryLimit = r10 * 0.88
    if usedClosestApproach then
        discoveryLimit = r10 * 0.34
        if archeryRound3TurnFactor > 0.20 then
            return scan
        end
    end
    if errorDistance > discoveryLimit then
        return scan
    end

    local metric = errorDistance + (usedClosestApproach and r10 * 0.18 or 0)
    if metric < scan.bestError then
        local speed = targetVelocity.Magnitude
        scan.bestError = metric
        scan.bestPosition = rawCenter
        scan.bestDirection = speed > 1 and targetVelocity.Unit or nil
        scan.bestSpeed = speed
        scan.bestSeenAt = now
        scan.bestUsedClosest = usedClosestApproach == true
        -- Normally this remains open through the first scan loop so we can choose the
        -- deepest 10. If the loop already completed, lock the first strong 10 observed
        -- on the next pass instead of holding the bow forever.
        if scan.loopComplete then
            scan.phaseLocked = true
        end
    end
    return scan
end

local function isRound3PureTenPhase(rawCenter, targetVelocity)
    local scan = archeryRound3TenScan
    if not scan.loopComplete or not scan.bestPosition then
        return false
    end
    local speed = targetVelocity.Magnitude
    -- Speed-aware re-entry corridor: the Round 3 bull can move several studs between
    -- rendered samples, so an overly tiny phase box can be skipped completely.
    local posTolerance = math.max(1.10, math.min(2.35, 0.45 + speed * 0.020))
    if (rawCenter - scan.bestPosition).Magnitude > posTolerance then
        return false
    end
    if scan.bestDirection and speed > 1
        and targetVelocity.Unit:Dot(scan.bestDirection) < 0.78 then
        return false
    end
    if scan.bestSpeed > 1 and speed > 1 then
        local speedFraction = math.abs(speed - scan.bestSpeed) / math.max(scan.bestSpeed, 1)
        if speedFraction > 0.50 then
            return false
        end
    end
    return true
end

local function projectedScoreForCamera(camera, target, bull, predictedCenter)
    if not (camera and target and bull and predictedCenter) then
        return 0, math.huge
    end

    local origin = camera.CFrame.Position
    local direction = camera.CFrame.LookVector
    local normal = bullPlaneNormal(bull)
    local denom = direction:Dot(normal)
    if math.abs(denom) < 0.02 then
        return 0, math.huge
    end

    local t = (predictedCenter - origin):Dot(normal) / denom
    if t <= 0 then
        return 0, math.huge
    end

    local projected = origin + direction * t
    local errorDistance = (projected - predictedCenter).Magnitude
    local radii = getArcheryRingRadii(target, bull)
    local r10 = radii[1]
    local r9 = radii[2]
    local r8 = radii[3]

    if r10 and errorDistance <= r10 * ARCHERY_AUTO_RING_SAFETY then
        return 10, errorDistance
    elseif r9 and errorDistance <= r9 * ARCHERY_AUTO_RING_SAFETY then
        return 9, errorDistance
    elseif r8 and errorDistance <= r8 * ARCHERY_AUTO_RING_SAFETY then
        return 8, errorDistance
    end
    return 0, errorDistance
end


local function scoreForImpactError(target, bull, errorDistance, safetyScale)
    local radii = getArcheryRingRadii(target, bull)
    local r10 = radii[1]
    local r9 = radii[2]
    local r8 = radii[3]
    local safety = safetyScale or ARCHERY_AUTO_RING_SAFETY

    if r10 and errorDistance <= r10 * safety then
        return 10
    elseif r9 and errorDistance <= r9 * safety then
        return 9
    elseif r8 and errorDistance <= r8 * safety then
        return 8
    end
    return 0
end

local function round3PriorityReleaseScore(target, bull, errorDistance)
    local radii = getArcheryRingRadii(target, bull)
    local r10, r9 = radii[1], radii[2]
    if r10 and errorDistance <= r10 * ARCHERY_ROUND3_10_RELEASE_SAFETY then
        return 10
    end

    -- V56: final Round 3 release scoring is based on the solved trajectory itself.
    -- Do not require pattern-confidence here; that was starving valid shots even when
    -- the exact projectile solution was already deep inside a 9 window. Keep the 9
    -- window inside the real 9 ring, while 8-and-lower windows still have no release path.
    if r10 and r9 then
        local nearBullNineLimit = r10 + math.max(0, r9 - r10) * ARCHERY_ROUND3_9_NEAR_BULL_FRACTION
        if errorDistance <= nearBullNineLimit then
            return 9
        end
    end
    return 0
end

local function setRound3ShotAnchor(bull, rawCenter, targetVelocity, now)
    if not (bull and typeof(rawCenter) == "Vector3" and typeof(targetVelocity) == "Vector3") then
        return
    end
    local speed = targetVelocity.Magnitude
    archeryRound3ShotAnchorBull = bull
    archeryRound3ShotAnchorPosition = rawCenter
    archeryRound3ShotAnchorDirection = speed > 1 and targetVelocity.Unit or nil
    archeryRound3ShotAnchorSpeed = speed
    archeryRound3ShotAnchorTime = now
    archeryRound3ShotAnchorPeriod = archeryRound3PatternPeriod
end

local function isRound3ShotAnchorWindow(bull, rawCenter, targetVelocity, now)
    if not archeryRound3ShotAnchorPosition then
        return true
    end
    -- V44: do not require the same bull Instance. The game may rebuild/replace the
    -- Round 3 target between arrows while keeping the identical repeating path.
    if typeof(rawCenter) ~= "Vector3" or typeof(targetVelocity) ~= "Vector3" then
        return false
    end
    if archeryRound3PatternConfidence < ARCHERY_ROUND3_ANCHOR_MIN_CONFIDENCE then
        return false
    end

    local speed = targetVelocity.Magnitude
    local delta = rawCenter - archeryRound3ShotAnchorPosition
    -- Round 3 moves fast enough to travel more than the old 1.55-stud anchor radius
    -- between rendered frames. Expand only the along-path re-entry radius with speed
    -- so the proven 9 phase cannot be skipped between samples.
    local anchorPosTolerance = math.max(
        ARCHERY_ROUND3_ANCHOR_POS_TOLERANCE,
        math.min(ARCHERY_ROUND3_ANCHOR_MAX_POS_TOLERANCE, 0.80 + speed * 0.022)
    )
    if delta.Magnitude > anchorPosTolerance then
        return false
    end

    local anchorDir = archeryRound3ShotAnchorDirection
    if anchorDir and speed > 1 then
        local directionDot = targetVelocity.Unit:Dot(anchorDir)
        if directionDot < ARCHERY_ROUND3_ANCHOR_DIRECTION_DOT then
            return false
        end
        local along = delta:Dot(anchorDir)
        local perpendicular = delta - anchorDir * along
        if perpendicular.Magnitude > ARCHERY_ROUND3_ANCHOR_PERP_TOLERANCE then
            return false
        end
    end

    local anchorSpeed = archeryRound3ShotAnchorSpeed
    if anchorSpeed > 2 then
        local speedFraction = math.abs(speed - anchorSpeed) / anchorSpeed
        if speedFraction > ARCHERY_ROUND3_ANCHOR_SPEED_FRACTION then
            return false
        end
    end

    -- V43: position + direction + speed already identify this repeating-path phase.
    -- Do NOT require an exact elapsed-time modulo match here; tiny learned-period drift
    -- can otherwise make every later pass miss the anchor forever.

    return true
end

local function resolveArcheryBallisticModules()
    if archeryArrowFlight and archeryWeaponConfig then
        return archeryArrowFlight, archeryWeaponConfig
    end

    local engine = ReplicatedStorage:FindFirstChild("Weapon_Engine")
    local modules = engine and engine:FindFirstChild("Modules")
    if not modules then return nil, nil end

    if not archeryArrowFlight then
        local moduleScript = modules:FindFirstChild("ArrowFlight")
        if moduleScript and moduleScript:IsA("ModuleScript") then
            local ok, module = pcall(require, moduleScript)
            if ok and type(module) == "table" then
                archeryArrowFlight = module
            end
        end
    end

    if not archeryWeaponConfig then
        local moduleScript = modules:FindFirstChild("WeaponConfig")
        if moduleScript and moduleScript:IsA("ModuleScript") then
            local ok, module = pcall(require, moduleScript)
            if ok and type(module) == "table" then
                archeryWeaponConfig = module
            end
        end
    end

    return archeryArrowFlight, archeryWeaponConfig
end

local function resolvedArcheryBowConfig(tool)
    if not tool then return nil end
    if archeryBallisticTool == tool and archeryBallisticCfg then
        return archeryBallisticCfg
    end

    local _, weaponConfig = resolveArcheryBallisticModules()
    if not weaponConfig or type(weaponConfig.Resolve) ~= "function" then
        return nil
    end

    local weaponId = tool:GetAttribute("WeaponId")
    if type(weaponId) ~= "string" then return nil end

    local ok, cfg = pcall(function()
        return weaponConfig.Resolve(weaponId, {tool, tool:FindFirstChild("Anim")}, true)
    end)
    if ok and type(cfg) == "table" then
        archeryBallisticTool = tool
        archeryBallisticCfg = cfg
        return cfg
    end
    return nil
end


-- Best melee equipment helper for Auto Farm Mobs.
findBestMeleeTool = function()
    local character = Player.Character
    local backpack = Player:FindFirstChildOfClass("Backpack")
    if not character then return nil end

    local candidates = {}
    for _, container in ipairs({character, backpack}) do
        if container then
            for _, tool in ipairs(container:GetDescendants()) do
                if tool:IsA("Tool") then
                    table.insert(candidates, tool)
                end
            end
        end
    end

    local rarityWeight = {
        common = 1, uncommon = 2, rare = 3, epic = 4,
        legendary = 5, mythic = 6, divine = 7,
    }

    local function numeric(source, keys)
        if not source then return nil end
        for _, key in ipairs(keys) do
            local value = nil
            if typeof(source) == "Instance" then
                value = source:GetAttribute(key)
            elseif type(source) == "table" then
                value = source[key]
            end
            value = tonumber(value)
            if value then return value end
        end
        return nil
    end

    local function scoreTool(tool)
        local name = string.lower(tool.Name)
        local weaponId = tool:GetAttribute("WeaponId")
        local idLower = type(weaponId) == "string" and string.lower(weaponId) or ""

        -- Never choose bows or obvious non-combat gathering tools for Melee mode.
        if string.find(name, "bow", 1, true) or string.find(idLower, "bow", 1, true) then
            return nil
        end
        for _, blocked in ipairs({"pickaxe", "fishing", "fishingrod", "shovel", "hoe"}) do
            if string.find(name, blocked, 1, true) or string.find(idLower, blocked, 1, true) then
                return nil
            end
        end

        local cfg = nil
        local _, weaponConfig = resolveArcheryBallisticModules()
        if weaponConfig and type(weaponConfig.Resolve) == "function" and type(weaponId) == "string" then
            pcall(function()
                cfg = weaponConfig.Resolve(weaponId, {tool, tool:FindFirstChild("Anim")}, true)
            end)
        end

        -- Strongest signal first: actual damage/power from config or tool attributes.
        local damage = numeric(cfg, {"Damage", "BaseDamage", "AttackDamage", "Power", "DamagePerHit"})
            or numeric(tool, {"Damage", "BaseDamage", "AttackDamage", "Power", "DamagePerHit"})
            or 0

        local tier = numeric(cfg, {"Tier", "WeaponTier", "Level"})
            or numeric(tool, {"Tier", "WeaponTier", "Level"})
            or 0

        local rarity = tool:GetAttribute("Rarity")
        if rarity == nil and type(cfg) == "table" then rarity = cfg.Rarity end
        local rarityScore = rarityWeight[string.lower(tostring(rarity or ""))] or 0

        local meleeHint = 0
        for _, hint in ipairs({"sword","blade","katana","dagger","spear","mace","club","hammer","axe","greatsword","scythe"}) do
            if string.find(name, hint, 1, true) or string.find(idLower, hint, 1, true) then
                meleeHint = 1
                break
            end
        end

        -- A WeaponId strongly suggests a combat-configured tool. Unknown tools with
        -- neither a weapon id nor a melee hint are ignored.
        if type(weaponId) ~= "string" and meleeHint == 0 then
            return nil
        end

        return damage * 100000 + tier * 1000 + rarityScore * 100 + meleeHint
    end

    local best, bestScore = nil, -math.huge
    for _, tool in ipairs(candidates) do
        local score = scoreTool(tool)
        if score and score > bestScore then
            best, bestScore = tool, score
        end
    end

    return best
end

local function exactSolvedTrajectoryScore(target, bull, rawCenter, targetVelocity, targetAcceleration)
    if not (target and bull and rawCenter and bull.Parent) then
        return 0, math.huge, nil, false
    end

    local bowClient = resolveArcheryBowClient()
    if not bowClient or type(bowClient.AimDir) ~= "function" then
        return 0, math.huge, nil, false
    end

    local aimDir = nil
    local okAim = pcall(function()
        aimDir = bowClient.AimDir()
    end)
    if not okAim or typeof(aimDir) ~= "Vector3" or aimDir.Magnitude < 0.001 then
        return 0, math.huge, nil, false
    end
    aimDir = aimDir.Unit

    local tool = isBowEquipped()
    local cfg = resolvedArcheryBowConfig(tool)
    local arrowFlight = select(1, resolveArcheryBallisticModules())
    if not cfg or not arrowFlight
        or type(arrowFlight.SpeedFor) ~= "function"
        or type(arrowFlight.ClearMuzzle) ~= "function"
        or type(arrowFlight.PositionAt) ~= "function" then
        return 0, math.huge, nil, false
    end

    local character = Player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then
        return 0, math.huge, nil, false
    end

    local speed = nil
    local okSpeed = pcall(function()
        speed = arrowFlight.SpeedFor(cfg, 1)
    end)
    speed = tonumber(speed)
    if not okSpeed or not speed or speed <= 1 then
        return 0, math.huge, nil, false
    end

    local gravity = tonumber(cfg.ArrowGravity) or 60
    local origin = root.Position
    pcall(function()
        local clear = arrowFlight.ClearMuzzle(root.Position, cfg, aimDir, {character})
        if typeof(clear) == "Vector3" then
            origin = clear
        end
    end)

    local launchVelocity = aimDir * speed
    local measuredVelocity = typeof(targetVelocity) == "Vector3" and targetVelocity or Vector3.zero
    local measuredAcceleration = typeof(targetAcceleration) == "Vector3" and targetAcceleration or Vector3.zero
    local round3 = isRound3VelocityForBull(bull, measuredVelocity)
    -- V35 base velocity lead stays intact. V37 adds only a capped acceleration term
    -- for Round 3 so curved/all-direction motion is not treated as a straight line.
    local velocity = round3 and (measuredVelocity * ARCHERY_ROUND3_PREDICTION_SCALE) or measuredVelocity
    local acceleration = round3 and measuredAcceleration or Vector3.zero
    local normal = bullPlaneNormal(bull)
    local speedOfTarget = velocity.Magnitude
    local targetLatency = round3 and ARCHERY_ROUND3_TARGET_LATENCY or ARCHERY_AUTO_TARGET_LATENCY
    local patternMatchIndex = nil
    local patternMatchOffset = Vector3.zero
    local patternPhaseCorrection = 0
    local patternConfidence = 0
    if round3 then
        patternMatchIndex, patternConfidence = findRound3PatternMatch(rawCenter, measuredVelocity, os.clock())
        if patternMatchIndex then
            patternPhaseCorrection, patternMatchOffset = round3PatternPhaseCorrection(patternMatchIndex, rawCenter)
        end
    end

    local function targetCenterAt(t)
        local futureT = t + targetLatency
        if round3 and patternMatchIndex and patternConfidence >= ARCHERY_ROUND3_PATTERN_MIN_CONFIDENCE then
            local patternCenter = round3PatternPositionFromMatch(
                patternMatchIndex,
                math.max(0, futureT + patternPhaseCorrection),
                patternMatchOffset
            )
            if patternCenter then
                return patternCenter
            end
        end

        local center = rawCenter + velocity * futureT
        if round3 and acceleration.Magnitude > 0.01 then
            local accelLead = acceleration * (0.5 * futureT * futureT * ARCHERY_ROUND3_ACCEL_GATE_SCALE)
            if accelLead.Magnitude > ARCHERY_ROUND3_MAX_ACCEL_GATE then
                accelLead = accelLead.Unit * ARCHERY_ROUND3_MAX_ACCEL_GATE
            end
            center = center + accelLead
        end
        return center
    end

    local function arrowPositionAt(t)
        local value = nil
        local ok = pcall(function()
            value = arrowFlight.PositionAt(origin, launchVelocity, gravity, t)
        end)
        if ok and typeof(value) == "Vector3" then
            return value
        end
        return nil
    end

    local previousT = 0
    local previousArrow = arrowPositionAt(0)
    if not previousArrow then
        return 0, math.huge, nil, false
    end
    local previousCenter = targetCenterAt(0)
    local previousSigned = (previousArrow - previousCenter):Dot(normal)

    local crossingA, crossingB = nil, nil
    local t = ARCHERY_AUTO_SIM_STEP
    while t <= ARCHERY_AUTO_MAX_SIM_TIME do
        local arrowPos = arrowPositionAt(t)
        if not arrowPos then
            return 0, math.huge, nil, false
        end
        local center = targetCenterAt(t)
        local signed = (arrowPos - center):Dot(normal)

        if signed == 0 or previousSigned == 0 or (signed > 0) ~= (previousSigned > 0) then
            crossingA, crossingB = previousT, t
            break
        end

        previousT = t
        previousArrow = arrowPos
        previousCenter = center
        previousSigned = signed
        t = t + ARCHERY_AUTO_SIM_STEP
    end

    -- V57: a fast/curving moving target can cross the arrow trajectory between
    -- coarse plane samples without producing a clean signed-plane flip. V56 treated
    -- that as "no impact" and Auto Shoot held forever. Keep the exact plane-crossing
    -- solve when available; otherwise refine the arrow/target closest approach in 3D.
    local impactTime = nil
    local usedClosestApproach = false

    if crossingA then
        -- Refine the moving-plane crossing so tiny rings are not judged from a
        -- coarse trajectory sample.
        local a, b = crossingA, crossingB
        for _ = 1, ARCHERY_AUTO_BINARY_STEPS do
            local mid = (a + b) * 0.5
            local posA = arrowPositionAt(a)
            local centerA = targetCenterAt(a)
            local posMid = arrowPositionAt(mid)
            local centerMid = targetCenterAt(mid)
            if not (posA and posMid) then
                return 0, math.huge, nil, false
            end
            local signedA = (posA - centerA):Dot(normal)
            local signedMid = (posMid - centerMid):Dot(normal)
            if signedMid == 0 or (signedA > 0) ~= (signedMid > 0) then
                b = mid
            else
                a = mid
            end
        end
        impactTime = (a + b) * 0.5
    else
        usedClosestApproach = true
        local bestT, bestDistance = nil, math.huge
        local scanT = 0
        while scanT <= ARCHERY_AUTO_MAX_SIM_TIME do
            local arrowPos = arrowPositionAt(scanT)
            if not arrowPos then
                return 0, math.huge, nil, false
            end
            local center = targetCenterAt(scanT)
            local distance = (arrowPos - center).Magnitude
            if distance < bestDistance then
                bestDistance = distance
                bestT = scanT
            end
            scanT = scanT + ARCHERY_AUTO_SIM_STEP
        end

        if not bestT then
            return 0, math.huge, nil, false
        end

        -- Refine the minimum-distance time around the best coarse sample.
        local lo = math.max(0, bestT - ARCHERY_AUTO_SIM_STEP)
        local hi = math.min(ARCHERY_AUTO_MAX_SIM_TIME, bestT + ARCHERY_AUTO_SIM_STEP)
        for _ = 1, 10 do
            local span = (hi - lo) / 3
            local t1 = lo + span
            local t2 = hi - span
            local p1, p2 = arrowPositionAt(t1), arrowPositionAt(t2)
            if not (p1 and p2) then
                return 0, math.huge, nil, false
            end
            local d1 = (p1 - targetCenterAt(t1)).Magnitude
            local d2 = (p2 - targetCenterAt(t2)).Magnitude
            if d1 <= d2 then
                hi = t2
            else
                lo = t1
            end
        end
        impactTime = (lo + hi) * 0.5
    end

    local impact = arrowPositionAt(impactTime)
    local futureCenter = targetCenterAt(impactTime)
    if not (impact and futureCenter) then
        return 0, math.huge, nil, false
    end

    local errorVector = impact - futureCenter
    local radialVector = errorVector - normal * errorVector:Dot(normal)
    -- Closest-approach fallback uses full 3D miss distance so it cannot claim a
    -- false bullseye merely because the arrow is radially aligned but still well
    -- in front of/behind the target plane.
    local radialError = usedClosestApproach and errorVector.Magnitude or radialVector.Magnitude

    -- Round 3 can change direction between the final client frame and server-side
    -- shot processing. Charge that timing uncertainty directly against the score
    -- radius. This makes the gate intentionally conservative: fewer shots, but no
    -- deliberate 6/7 releases.
    -- V33: the old 0.030s uncertainty made Round 3 mathematically impossible at
    -- high target speeds (the penalty alone could exceed the entire 8 ring).
    -- Keep the conservative model for Rounds 1/2, but use a smaller measured
    -- processing margin and the real ring area for the fast Round 3 target.
    local learnedPattern = round3 and patternMatchIndex ~= nil
        and patternConfidence >= ARCHERY_ROUND3_PATTERN_MIN_CONFIDENCE

    -- V47: Round 3 moves in every direction. A single path match can be wrong near
    -- crossings/reversals, so compare the learned-path forecast with the live
    -- velocity/acceleration forecast. Only later release from phases where both
    -- models agree closely; this is aimed specifically at predicted-9 -> real-7 misses.
    archeryRound3ModelDisagreement = math.huge
    if round3 and learnedPattern then
        local futureT = impactTime + targetLatency
        local kinematicCenter = rawCenter + velocity * futureT
        if acceleration.Magnitude > 0.01 then
            local accelLead = acceleration * (0.5 * futureT * futureT * ARCHERY_ROUND3_ACCEL_GATE_SCALE)
            if accelLead.Magnitude > ARCHERY_ROUND3_MAX_ACCEL_GATE then
                accelLead = accelLead.Unit * ARCHERY_ROUND3_MAX_ACCEL_GATE
            end
            kinematicCenter = kinematicCenter + accelLead
        end
        archeryRound3ModelDisagreement = (futureCenter - kinematicCenter).Magnitude
    elseif not round3 then
        archeryRound3ModelDisagreement = 0
    end

    local timingUncertainty = learnedPattern and ARCHERY_ROUND3_PATTERN_TIMING_UNCERTAINTY
        or (round3 and ARCHERY_ROUND3_TIMING_UNCERTAINTY or ARCHERY_AUTO_TIMING_UNCERTAINTY)
    local ringSafety = round3 and ARCHERY_ROUND3_RING_SAFETY or ARCHERY_AUTO_RING_SAFETY
    local curveUncertainty = 0
    if round3 and not learnedPattern and acceleration.Magnitude > 0.01 then
        curveUncertainty = math.min(
            ARCHERY_ROUND3_MAX_CURVE_UNCERTAINTY,
            acceleration.Magnitude * impactTime * impactTime * 0.0035
        )
    end
    local robustError = radialError + speedOfTarget * timingUncertainty + curveUncertainty
    local score = scoreForImpactError(target, bull, robustError, ringSafety)
    return score, robustError, impactTime, true, usedClosestApproach
end

resolveArcheryBowClient = function()
    local function valid(module)
        return type(module) == "table"
            and type(module.SetTouchHeld) == "function"
            and type(module.IsDrawing) == "function"
            and type(module.AimDir) == "function"
    end

    if valid(archeryBowClient) then
        return archeryBowClient
    end

    -- Do not repeatedly scan getgc/getloadedmodules every rendered frame.
    local now = os.clock()
    if now - archeryBowClientLastResolve < 0.35 then
        return nil
    end
    archeryBowClientLastResolve = now

    local function globalFunction(name)
        local value = nil
        if type(getgenv) == "function" then
            pcall(function()
                local env = getgenv()
                if type(env) == "table" then value = env[name] end
            end)
        end
        if value == nil and type(getfenv) == "function" then
            pcall(function()
                local env = getfenv()
                if type(env) == "table" then value = env[name] end
            end)
        end
        if value == nil and type(_G) == "table" then
            value = rawget(_G, name)
        end
        return value
    end

    -- Best path in injected environments: find the exact BowClient module that the
    -- game's WeaponClient has already loaded, instead of requiring a duplicate path.
    local getLoaded = globalFunction("getloadedmodules")
    if type(getLoaded) == "function" then
        local ok, modules = pcall(getLoaded)
        if ok and type(modules) == "table" then
            for _, moduleScript in ipairs(modules) do
                if typeof(moduleScript) == "Instance"
                    and moduleScript:IsA("ModuleScript")
                    and moduleScript.Name == "BowClient" then
                    local okRequire, module = pcall(require, moduleScript)
                    if okRequire and valid(module) then
                        archeryBowClient = module
                        return module
                    end
                end
            end
        end
    end

    -- Runtime-table fallback. This finds the already-created BowClient export table
    -- even when requiring PlayerScripts modules from the injected thread is blocked.
    local getGc = globalFunction("getgc")
    if type(getGc) == "function" then
        local ok, objects = pcall(getGc, true)
        if ok and type(objects) == "table" then
            for _, object in ipairs(objects) do
                if valid(object) then
                    archeryBowClient = object
                    return object
                end
            end
        end
    end

    -- Normal Roblox path fallback.
    local playerScripts = Player:FindFirstChild("PlayerScripts")
    if not playerScripts then return nil end
    local bowFolder = playerScripts:FindFirstChild("Bow_Client")
    local known = bowFolder and bowFolder:FindFirstChild("BowClient")
    if known and known:IsA("ModuleScript") then
        local ok, module = pcall(require, known)
        if ok and valid(module) then
            archeryBowClient = module
            return module
        end
    end
    for _, descendant in ipairs(playerScripts:GetDescendants()) do
        if descendant:IsA("ModuleScript") and descendant.Name == "BowClient" then
            local ok, module = pcall(require, descendant)
            if ok and valid(module) then
                archeryBowClient = module
                return module
            end
        end
    end
    return nil
end

local function archeryAutoMousePosition(camera)
    camera = camera or Workspace.CurrentCamera
    if camera then
        local size = camera.ViewportSize
        return math.floor(size.X * 0.5), math.floor(size.Y * 0.5)
    end
    return 640, 360
end

local function executorGlobal(name)
    local value = nil
    if type(getgenv) == "function" then
        pcall(function()
            local env = getgenv()
            if type(env) == "table" then value = env[name] end
        end)
    end
    if value == nil and type(getfenv) == "function" then
        pcall(function()
            local env = getfenv()
            if type(env) == "table" then value = env[name] end
        end)
    end
    if value == nil and type(_G) == "table" then
        value = rawget(_G, name)
    end
    return value
end

local function fireArcheryInputConnections(isDown)
    local getter = executorGlobal("getconnections")
    if type(getter) ~= "function" then return false end
    local signal = isDown and UserInputService.InputBegan or UserInputService.InputEnded
    local ok, list = pcall(getter, signal)
    if not ok or type(list) ~= "table" then return false end

    local fakeInput = {
        UserInputType = Enum.UserInputType.MouseButton1,
        KeyCode = Enum.KeyCode.Unknown,
    }
    local fired = false
    for _, connection in ipairs(list) do
        local fn = nil
        pcall(function() fn = connection.Function end)
        if type(fn) == "function" then
            local good = pcall(fn, fakeInput, false)
            fired = fired or good
        else
            local fire = nil
            pcall(function() fire = connection.Fire end)
            if type(fire) == "function" then
                local good = pcall(function()
                    connection:Fire(fakeInput, false)
                end)
                fired = fired or good
            end
        end
    end
    return fired
end

local function sendArcheryMouseButton(isDown, camera)
    local x, y = archeryAutoMousePosition(camera)
    local sent = false

    -- Executor-native input is the most reliable way to create a real held Mouse1.
    local native = executorGlobal(isDown and "mouse1press" or "mouse1release")
    if type(native) == "function" then
        sent = pcall(native) or sent
    end

    -- Directly invoke the same UserInputService listeners the normal bow uses.
    sent = fireArcheryInputConnections(isDown) or sent

    if VirtualInputManager then
        local ok = pcall(function()
            VirtualInputManager:SendMouseButtonEvent(x, y, 0, isDown, game, 0)
        end)
        sent = ok or sent
    end

    local okVirtual = pcall(function()
        local cam = camera or Workspace.CurrentCamera
        if isDown then
            VirtualUser:Button1Down(Vector2.new(x, y), cam and cam.CFrame or CFrame.new())
        else
            VirtualUser:Button1Up(Vector2.new(x, y), cam and cam.CFrame or CFrame.new())
        end
    end)
    sent = okVirtual or sent

    if sent then
        archeryAutoVirtualMouseHeld = isDown == true
    end
    return sent
end

local function forceArcheryDrawDown(camera)
    local started = false
    local bowClient = resolveArcheryBowClient()

    -- Call the real game bow API first. startDraw() internally ignores duplicate starts,
    -- so using the input fallbacks too is safe and prevents silent no-draw failures.
    if bowClient then
        local attached = true
        if type(bowClient.IsAttached) == "function" then
            local ok, value = pcall(bowClient.IsAttached)
            if ok then attached = value == true end
        end
        if attached then
            started = pcall(function() bowClient.SetTouchHeld(true) end) or started
        end
    end

    started = sendArcheryMouseButton(true, camera) or started
    archeryAutoInputMode = "VerifiedMulti"
    return started
end

local function startArcheryAutoDraw(camera)
    local started = forceArcheryDrawDown(camera)
    if started then
        archeryAutoConfirmedDraw = false
        return true
    end
    return false
end

local function releaseArcheryAutoDraw(camera)
    -- V55: once a shot is approved, ALWAYS send a real bow-up signal. Previous
    -- versions could skip the release if ownership flags drifted out of sync even
    -- though BowClient was still physically drawing.
    local bowClient = resolveArcheryBowClient()
    if bowClient then
        pcall(function() bowClient.SetTouchHeld(false) end)
    end
    sendArcheryMouseButton(false, camera)

    archeryAutoOwnsDraw = false
    archeryAutoConfirmedDraw = false
    archeryAutoInputMode = nil
    archeryAutoVirtualMouseHeld = false
    archeryAutoDrawStartedAt = 0
    archeryAutoDrawVerifyAt = 0
    archeryAutoGoodFrames = 0
    archeryRound3WindowScore = 0
    archeryRound3WindowSince = 0
    archeryRound3NineFrames = 0
end

local function isRound3Motion(bull, targetVelocity)
    return isRound3VelocityForBull(bull, targetVelocity)
end

local function requiredAutoScore(bull, targetVelocity)
    -- V60: pure 10s only in every round.
    return 10
