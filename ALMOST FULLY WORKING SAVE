local function disconnect(name)
    stopFlags[name] = true
    local c = connections[name]
    if c then
        pcall(function()
            if typeof(c) == "RBXScriptConnection" then
                c:Disconnect()
            elseif typeof(c) == "thread" then
                task.cancel(c)
            end
        end)
        connections[name] = nil
    end
    task.wait()
    stopFlags[name] = nil
end

