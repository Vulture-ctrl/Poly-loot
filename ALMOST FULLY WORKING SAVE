fullShutdown = function()
    if killSwitchActivated then return end
    killSwitchActivated = true

    local restoreEnvironment = state.EnvironmentCollisionTest == true

    -- Stop every state-driven feature immediately.
    for key, value in pairs(state) do
        if type(value) == "boolean" then
            state[key] = false
        end
    end
    state.CurrentTarget = nil

    -- Leave stop flags asserted while this dead instance is shutting down.
    for name in pairs(connections) do
        stopFlags[name] = true
    end
    stopFlags.AutoLoot = true
    stopFlags.AutoAttack = true
    stopFlags.GoldMineCollect = true
    stopFlags.SelectedFarm = true
    stopFlags.AutoTreeFarm = true
    stopFlags.AutoOre = true
    stopFlags.ManualTravel = true

    -- Stop archery auto-fire first so it cannot leave the bow held/drawing.
    state.ArcheryAutoShoot = false
    if stopArcheryAutoShoot then
        pcall(stopArcheryAutoShoot)
    end

    -- Stop archery render control first so it cannot touch the camera again.
    archeryAimEnabled = false
    if stopArcheryAim then
        pcall(stopArcheryAim)
    else
        pcall(function() RunService:UnbindFromRenderStep(POLY_ARCHERY_BIND) end)
    end

    -- Cancel any in-progress movement tween.
    if activeMovementTween then
        pcall(function() activeMovementTween:Cancel() end)
        activeMovementTween = nil
    end

    -- Cancel all registered farm/resource/manual-travel threads and every global
    -- input/render connection owned by this script.
    for name, c in pairs(connections) do
        connections[name] = nil
        pcall(function()
            if typeof(c) == "RBXScriptConnection" then
                c:Disconnect()
            elseif typeof(c) == "thread" then
                task.cancel(c)
            end
        end)
    end

    -- Clear scan/cache tables so nothing stale is left behind.
    if type(state.NearbyMobScan) == "table" then table.clear(state.NearbyMobScan) end
    if type(state.SelectedTargetScan) == "table" then table.clear(state.SelectedTargetScan) end

