local function tweenTo(position, duration)
    if killSwitchActivated then return false end
    local root = getRoot()
    if not root then return false end
    local dist = (root.Position - position).Magnitude
    if dist <= CONFIG.ArrivalDistance then return true end

    local hum = getHumanoid()
    if hum then
        hum.AutoRotate = true
        hum.PlatformStand = false
        if state.PlayerSpeed then
            hum.WalkSpeed = CONFIG.WalkSpeed
        end
    end

    duration = duration or CONFIG.TeleportTweenTime
    duration = math.max(0.15, duration)
    local tween = TweenService:Create(root, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = CFrame.new(position)})
    activeMovementTween = tween
    tween:Play()
    local playbackState = tween.Completed:Wait()
    if activeMovementTween == tween then
        activeMovementTween = nil
    end
    return (not killSwitchActivated) and playbackState == Enum.PlaybackState.Completed
end

local function pathMoveTo(position)
    if killSwitchActivated then return false end
    local character = Player.Character
    local root = getRoot()
    local hum = getHumanoid()
    if not character or not root or not hum then return false end

    local path = PathfindingService:CreatePath({
        AgentRadius = 2,
        AgentHeight = 5,
        AgentCanJump = true,
        AgentCanClimb = true,
        WaypointSpacing = 5,
    })

    local ok = pcall(function()
        path:ComputeAsync(root.Position, position)
    end)

    if killSwitchActivated then return false end
    if not ok or path.Status ~= Enum.PathStatus.Success then
        return tweenTo(position, math.clamp((root.Position - position).Magnitude / CONFIG.TravelSpeed, 0.25, 8))
    end

    local waypoints = path:GetWaypoints()
    for _, waypoint in ipairs(waypoints) do
        if killSwitchActivated or not state.ManualTravel then return false end
        if waypoint.Action == Enum.PathWaypointAction.Jump then
            hum.Jump = true
        end
        hum:MoveTo(waypoint.Position)
        local reached = hum.MoveToFinished:Wait()
        if killSwitchActivated or not state.ManualTravel then return false end
        if not reached then break end
    end
    return (not killSwitchActivated) and (getRoot() and ((getRoot().Position - position).Magnitude <= 8) or false)
end

local function manualTravel(position)
    if killSwitchActivated then return false end
    state.ManualTravel = true
    state.CurrentTarget = position
    local root = getRoot()
    if not root then state.ManualTravel = false return false end

    local dist = (root.Position - position).Magnitude
    local hum = getHumanoid()
    if hum then
        hum.AutoRotate = true
        hum.PlatformStand = false
        hum.WalkSpeed = math.clamp(CONFIG.TravelSpeed, 1, 999)
    end

    local success = pathMoveTo(position)
    if killSwitchActivated then
        state.ManualTravel = false
        state.CurrentTarget = nil
        return false
    end

    if not success then
        local d = getRoot() and (getRoot().Position - position).Magnitude or math.huge
        if d > CONFIG.ArrivalDistance and not killSwitchActivated then
            success = tweenTo(position, math.clamp(dist / math.max(CONFIG.TravelSpeed, 1), 0.3, 10))
        end
    end

    state.ManualTravel = false
    state.CurrentTarget = nil
    if hum and state.PlayerSpeed and not killSwitchActivated then
        hum.WalkSpeed = CONFIG.WalkSpeed
    end
    return success and not killSwitchActivated
end

