local function getPromptForObject(obj)
    if not obj then return nil end
    if obj:IsA("ProximityPrompt") then return obj end
    local prompt = obj:FindFirstChildWhichIsA("ProximityPrompt", true)
    if prompt then return prompt end
    if obj.Parent then
        prompt = obj.Parent:FindFirstChildWhichIsA("ProximityPrompt", true)
    end
    return prompt
end

local function triggerPrompt(prompt)
    if not prompt or not prompt.Parent or prompt.Enabled == false then return false end
    if typeof(fireproximityprompt) == "function" then
        local ok = pcall(function() fireproximityprompt(prompt, prompt.HoldDuration or 0, true) end)
        if ok then return true end
    end
    return pcall(function()
        prompt:InputHoldBegin()
        if prompt.HoldDuration and prompt.HoldDuration > 0 then task.wait(prompt.HoldDuration + 0.05) end
        prompt:InputHoldEnd()
    end)
end

local function pickupDrop(drop)
    if killSwitchActivated or not drop or not drop.Parent then return false end

    local root = getRoot()
    local pos = getPosition(drop)
    if not root or not pos then return false end

    local prompt = getPromptForObject(drop)

    -- Use the same pickup method that the tree-farm loot collector uses.
    -- Once we are close enough, trigger the actual ProximityPrompt instead of
    -- assuming a RemoteEvent call succeeded.
    if (root.Position - pos).Magnitude <= 10 then
        if prompt and prompt.Parent and prompt.Enabled ~= false then
            if triggerPrompt(prompt) then return true end

            local ok = pcall(function()
                prompt:InputHoldBegin()
                local hold = tonumber(prompt.HoldDuration) or 0
                if hold > 0 then task.wait(hold + 0.05) end
                prompt:InputHoldEnd()
            end)
            if ok then return true end
        end
        return false
    end

    return false
end

local function collectAllLootPriority(radius, maxSeconds)
    local collected = 0
    local deadline = os.clock() + (maxSeconds or 1.25)

    -- Same dynamic strategy used by the tree farm: re-scan after every pickup.
    while not killSwitchActivated and os.clock() < deadline do
        local root = getRoot()
        if not root then break end

        local drops = collectDrops(radius or CONFIG.LootRadius)
        if #drops == 0 then break end

        local drop = drops[1]
        local dropPos = drop and getPosition(drop)
        if not dropPos then
            task.wait(0.05)
        else
            if (root.Position - dropPos).Magnitude > 8 and not state.ManualTravel then
                if not manualTravel(dropPos) then
                    task.wait(0.05)
                end
            end

            if killSwitchActivated then break end

            local rootAfter = getRoot()
            if rootAfter and drop.Parent and (rootAfter.Position - dropPos).Magnitude <= 10 then
                if pickupDrop(drop) then
                    collected += 1
                end
            end

            task.wait(0.12)
        end
    end

    return collected
end

local function moveNear(position, stopDistance)
    local root, hum = getRoot(), getHumanoid()
    if not root or not hum or not position then return false end
    if (root.Position - position).Magnitude <= (stopDistance or 6) then return true end
    hum.WalkSpeed = math.clamp(CONFIG.FarmMoveSpeed, 1, 999)
    hum.AutoRotate = true
    hum.PlatformStand = false
    hum:MoveTo(position)
    return true
end

local function mobMatchesSelectedTarget(mob)
