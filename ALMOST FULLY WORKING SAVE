    return mobs[1], mobs
end

local function findToolByHint(hints)
    local char = Player.Character
    local candidates = {}
    if char then for _,v in ipairs(char:GetChildren()) do if v:IsA("Tool") then table.insert(candidates,v) end end end
    local backpack = Player:FindFirstChildOfClass("Backpack")
    if backpack then for _,v in ipairs(backpack:GetChildren()) do if v:IsA("Tool") then table.insert(candidates,v) end end end
    for _, tool in ipairs(candidates) do
        local n = string.lower(tool.Name)
        for _, hint in ipairs(hints) do if string.find(n, string.lower(hint), 1, true) then return tool end end
    end
    return nil
end


local function unlockMobAimMouse()
    -- Never interfere with the separate archery-contest camera/input state.
    if state.ArcheryCenterAim or state.ArcheryAutoShoot or archeryAimEnabled then
        return
    end

    -- First guarantee that every mob-bow input source is UP.
    local bowClient = resolveArcheryBowClient and resolveArcheryBowClient() or nil
    if bowClient and type(bowClient.SetTouchHeld) == "function" then
        pcall(function() bowClient.SetTouchHeld(false) end)
    end

    local camera = Workspace.CurrentCamera
    if camera then
        local center = Vector2.new(camera.ViewportSize.X * 0.5, camera.ViewportSize.Y * 0.5)

        if VirtualInputManager then
            pcall(function()
                VirtualInputManager:SendMouseButtonEvent(
                    math.floor(center.X),
                    math.floor(center.Y),
                    0,
                    false,
                    game,
                    0
                )
            end)
        end

        pcall(function()
            VirtualUser:Button1Up(center, camera.CFrame)
        end)
    end

    local function restoreNow()
        if state.ArcheryCenterAim or state.ArcheryAutoShoot or archeryAimEnabled then
            return
        end

        local currentCamera = Workspace.CurrentCamera
        local firstPerson = false
        if currentCamera then
            firstPerson = Player.CameraMode == Enum.CameraMode.LockFirstPerson
                or (currentCamera.CFrame.Position - currentCamera.Focus.Position).Magnitude <= 1
        end

        if not firstPerson then
            pcall(function()
                UserInputService.MouseBehavior = Enum.MouseBehavior.Default
            end)
            pcall(function()
                UserInputService.MouseIconEnabled = true
            end)
        end
    end

    -- BowClient updates on its own frame/heartbeat. Restore repeatedly after its
    -- release cleanup has had a chance to run.
    restoreNow()
    task.defer(restoreNow)
    task.delay(0.05, restoreNow)
    task.delay(0.15, restoreNow)
    task.delay(0.35, restoreNow)
end

-- Real inventory equip path mapped from the game's Inventory UI.
guiObjects.ResolveOwnedCombatWeapon = function(mode)
    local ok, serial, itemDef, weaponDef, itemData = pcall(function()
        local playerScripts = Player:WaitForChild("PlayerScripts")
        local dataClient = playerScripts:WaitForChild("Data_Client")
        local playerData = require(dataClient:WaitForChild("PlayerData"))

        local replica = playerData:Get()
        if not replica then
            replica = playerData:WaitFor()
        end

        local data = replica and replica.Data or nil
        local inventory = data and data.Inventory or nil
        local weapons = inventory and inventory.Weapons or nil
        if type(weapons) ~= "table" then
            return nil
        end

        local inventoryEngine = ReplicatedStorage:WaitForChild("Inventory_Engine")
        local itemRegistry = require(inventoryEngine.Modules:WaitForChild("ItemRegistry"))
        local weaponDPS = require(inventoryEngine.Modules:WaitForChild("WeaponDPS"))
        local weaponDefs = require(
            ReplicatedStorage:WaitForChild("Weapon_Engine")
                :WaitForChild("Modules")
                :WaitForChild("WeaponDefs")
        )

        local playerLevel = tonumber(data.Level) or 0
        local bestSerial, bestItemDef, bestWeaponDef, bestItemData = nil, nil, nil, nil
        local bestDps = -math.huge

        for candidateSerial, candidate in pairs(weapons) do
            if type(candidateSerial) == "string"
                and type(candidate) == "table"
                and not candidate.Locked then

                local def = itemRegistry[candidate.Id]
                if def and def.Kind == "Weapon" then
                    local weaponDef = weaponDefs[def.WeaponId or candidate.Id]
                    local weaponType = weaponDef and weaponDef.Type or nil

                    local allowed = false
                    if mode == "Bow" then
                        allowed = weaponType == "Bow"
                    else
                        -- Melee = actual combat melee; do not pick Bow or mining Pickaxe.
                        allowed = weaponType ~= nil
                            and weaponType ~= "Bow"
                            and weaponType ~= "Pickaxe"
                    end

                    local levelReq = tonumber(def.LevelReq) or 0
                    if allowed and levelReq <= playerLevel then
                        local dps = 0
                        pcall(function()
                            dps = tonumber(weaponDPS.For(candidate, data)) or 0
                        end)

                        if dps > bestDps then
                            bestDps = dps
                            bestSerial = candidateSerial
                            bestItemDef = def
                            bestWeaponDef = weaponDef
                            bestItemData = candidate
                        end
                    end
                end
            end
        end

        return bestSerial, bestItemDef, bestWeaponDef, bestItemData
    end)

    if not ok then
        warn("[POLY LOOT] Inventory weapon scan failed:", serial)
        return nil
    end

    return serial, itemDef, weaponDef, itemData
end

guiObjects.EquipOwnedCombatWeapon = function(mode)
    local serial, itemDef = guiObjects.ResolveOwnedCombatWeapon(mode)
    if not serial then
        warn("[POLY LOOT] No owned " .. string.lower(tostring(mode)) .. " weapon found in Inventory.Weapons.")
        return false
    end

    local ok, equipped = pcall(function()
        local playerData = require(
            Player:WaitForChild("PlayerScripts")
                :WaitForChild("Data_Client")
                :WaitForChild("PlayerData")
        )

        local inventoryEngine = ReplicatedStorage:WaitForChild("Inventory_Engine")
        local remotes = inventoryEngine:WaitForChild("Remotes")
        local equipRequest = remotes:WaitForChild("EquipRequest")
        local unequipRequest = remotes:WaitForChild("UnequipRequest")
        local bindRequest = remotes:WaitForChild("HotbarBindRequest")
        local unbindRequest = remotes:WaitForChild("HotbarUnbindRequest")

        local replica = playerData:Get()
        if not replica then replica = playerData:WaitFor() end
        local data = replica and replica.Data or nil
        if not data then return false end

        local hotbar = data.Hotbar
        local currentSerial = type(hotbar) == "table" and hotbar[1] or nil

        if currentSerial ~= serial then
            -- Slot 1 can only hold one weapon. Clear the previous weapon using the
            -- same remotes the real inventory UI uses, then bind the desired serial.
            if type(currentSerial) == "string" and currentSerial ~= "" then
                pcall(function() unbindRequest:FireServer(currentSerial) end)
                pcall(function() unequipRequest:FireServer(currentSerial) end)
                task.wait(0.08)
            end

            bindRequest:FireServer(serial)

            -- Wait for PlayerData to confirm that slot 1 really changed.
            local deadline = os.clock() + 1.25
            repeat
                task.wait(0.04)
                replica = playerData:Get()
                data = replica and replica.Data or nil
                hotbar = data and data.Hotbar or nil
                currentSerial = type(hotbar) == "table" and hotbar[1] or nil
            until currentSerial == serial or os.clock() >= deadline
        end

        -- If the serial is already bound, or binding has now completed, ask the
        -- server to activate/equip it exactly like the real inventory UI.
        if currentSerial == serial then
            pcall(function() equipRequest:FireServer(serial) end)
        end

        -- Wait for the server-created Tool to become a Character child.
        local character = Player.Character
        local weaponId = itemDef and (itemDef.WeaponId or itemDef.ToolTemplate) or nil
        local toolDeadline = os.clock() + 1.25

        repeat
            if character then
                for _, child in ipairs(character:GetChildren()) do
                    if child:IsA("Tool") then
                        local childWeaponId = child:GetAttribute("WeaponId")
                        if weaponId == nil
                            or childWeaponId == weaponId
                            or child.Name == weaponId
                            or child.Name == (itemDef and itemDef.Display) then
                            return true
                        end
                    end
                end
            end
            task.wait(0.04)
        until os.clock() >= toolDeadline

        return false
    end)

    if not ok then
        warn("[POLY LOOT] Server inventory equip failed:", equipped)
        return false
    end

    return equipped == true
end

