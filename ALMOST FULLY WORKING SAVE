-- Auto Farm Mobs weapon helpers.
local function findMobBowTool()
    local character = Player.Character
    local backpack = Player:FindFirstChildOfClass("Backpack")

    for _, container in ipairs({character, backpack}) do
        if container then
            for _, tool in ipairs(container:GetDescendants()) do
                if tool:IsA("Tool") then
                    local n = string.lower(tool.Name)
                    local wid = tool:GetAttribute("WeaponId")
                    local w = type(wid) == "string" and string.lower(wid) or ""
                    if string.find(n, "bow", 1, true)
                        or string.find(n, "crossbow", 1, true)
                        or string.find(w, "bow", 1, true)
                        or string.find(w, "crossbow", 1, true) then
                        return tool
                    end
                end
            end
        end
    end

    return nil
end

local function equipMobWeaponVerified(tool)
    local character = Player.Character
    local humanoid = getHumanoid()
    local backpack = Player:FindFirstChildOfClass("Backpack")
    if not character or not humanoid or not tool or not tool.Parent then
        return false
    end

    if tool.Parent == character then
        return true
    end

    for _ = 1, 4 do
        if not tool.Parent then return false end
        if tool.Parent == character then return true end

        pcall(function() humanoid:UnequipTools() end)
        task.wait(0.05)

        -- EquipTool expects a Tool in Backpack. If this game's inventory placed the
        -- Tool inside a Backpack subfolder, move only that Tool to Backpack first.
        if backpack and tool:IsDescendantOf(backpack) and tool.Parent ~= backpack then
            pcall(function() tool.Parent = backpack end)
            task.wait(0.03)
        end

        pcall(function() humanoid:EquipTool(tool) end)
        task.wait(0.10)
        if tool.Parent == character then return true end

        -- Local fallback for experiences where EquipTool did not move the Tool.
        pcall(function() tool.Parent = character end)
        task.wait(0.08)
        if tool.Parent == character then return true end
    end

    return tool.Parent == character
end

-- Auto Farm Mobs combat-mode controller.
-- Changing modes immediately equips the correct weapon.
setMobCombatMode = function(mode, equipNow)
    mode = mode == "Bow" and "Bow" or "Melee"

    -- Never leave a bow draw held when changing modes.
    if stopMobBowFarm then
        pcall(stopMobBowFarm)
    end
    unlockMobAimMouse()

    state.MobCombatMode = mode

    if guiObjects.UpdateMobBowCrosshair then
        pcall(guiObjects.UpdateMobBowCrosshair)
    end

    -- Keep the custom Combat Mode button text synchronized.
    if guiObjects.MobCombatModeRedraw then
        pcall(guiObjects.MobCombatModeRedraw)
    end

    if not equipNow then return true end

    local character = Player.Character
    local humanoid = getHumanoid()
    if not character or not humanoid then
        return false
    end

    -- Primary path: use the game's actual Inventory.Weapons serial + remotes.
    if guiObjects.EquipOwnedCombatWeapon then
        local serverEquipped = guiObjects.EquipOwnedCombatWeapon(mode)
        if serverEquipped then
            return true
        end
    end

    -- Fallback only for experiences/states where the Tool already exists locally.
    local wanted = nil
    if mode == "Melee" then
        wanted = findBestMeleeTool and findBestMeleeTool() or nil
    else
        wanted = findMobBowTool()
    end

    if not wanted then
        warn("[POLY LOOT] No local fallback " .. string.lower(mode) .. " Tool found.")
        return false
    end

    local equipped = equipMobWeaponVerified(wanted)
    if not equipped then
        warn("[POLY LOOT] Failed to equip " .. wanted.Name .. " for " .. mode .. " mode.")
    end
    return equipped
end

local function nearestTree(radius)
    local root=getRoot(); if not root then return nil end
    local best=nil; local bestD=radius or 160
    for _,tree in ipairs(CollectionService:GetTagged("ChoppableTree")) do
        local pos=getPosition(tree); if pos then local d=(pos-root.Position).Magnitude; if d<bestD then best, bestD=tree,d end end
    end
    return best,bestD
end

