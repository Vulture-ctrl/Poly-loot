button(mobFarm, "Restore Mouse / Unlock Aim", function()
    if stopMobBowFarm then pcall(stopMobBowFarm) end
    unlockMobAimMouse()
end)
do
    info(mobFarm, "Bow Aim: Mob Aimbot and Mob Auto Shoot only use the mob species selected below and require a clear line of sight.")

    toggle(mobFarm, "Mob Aimbot", "MobAimbot", function(enabled)
        disconnect("MobAimbot")
        if not enabled then
            if stopMobBowFarm then pcall(stopMobBowFarm) end
            unlockMobAimMouse()
            return
        end

        connections.MobAimbot = RunService.RenderStepped:Connect(function()
            if killSwitchActivated or not state.MobAimbot then return end

            -- Never compete with the existing archery camera writer.
            if state.ArcheryCenterAim or archeryAimEnabled then return end

            local camera = Workspace.CurrentCamera
            local playerRoot = getRoot()
            if not camera or not playerRoot then return end

            local target = nil
            if (state.SelectedFarm or state.MobAutoShoot)
                and state.CurrentTarget
                and mobMatchesSelectedTarget(state.CurrentTarget) then
                target = state.CurrentTarget
            else
                local mobs = collectSelectedMobs(CONFIG.MobRadius)
                target = mobs[1]
                if (state.MobAutoShoot or state.SelectedFarm) and target then
                    state.CurrentTarget = target
                end
            end
            if not target or not isAliveMob(target) then return end

            local aimPosition = visibleMobAimPoint(target)
            if not aimPosition then
                -- Current mob is behind a wall. Try another visible mob instead of
                -- aiming/shooting through the obstruction.
                target = nil
                for _, candidate in ipairs(collectSelectedMobs(CONFIG.MobRadius)) do
                    local visiblePoint = visibleMobAimPoint(candidate)
                    if visiblePoint then
                        target = candidate
                        aimPosition = visiblePoint
                        if state.MobAutoShoot or state.SelectedFarm then
                            state.CurrentTarget = candidate
                        end
                        break
                    end
                end
            end

            if aimPosition and (aimPosition - camera.CFrame.Position).Magnitude > 0.001 then
                camera.CFrame = CFrame.lookAt(camera.CFrame.Position, aimPosition)
            end
        end)
    end)

    slider(mobFarm, "Mob Aimbot Radius", "MobAimbotRadius", 20, 500, CONFIG.MobRadius, 0, function(v)
        CONFIG.MobRadius = v
    end)

    toggle(mobFarm, "Mob Auto Shoot", "MobAutoShoot", function(enabled)
        disconnect("MobAutoShoot")
        if stopMobBowFarm then pcall(stopMobBowFarm) end
        if not enabled then
            unlockMobAimMouse()
            return
        end

        -- Mob Auto Shoot is a Bow feature: switch and equip immediately.
        if setMobCombatMode then
            pcall(function() setMobCombatMode("Bow", true) end)
        end

        connections.MobAutoShoot = task.spawn(function()
            while state.MobAutoShoot and not stopFlags.MobAutoShoot and not killSwitchActivated do
                -- Auto Farm Selected + Bow already owns the exact same shot helper.
                if state.SelectedFarm and state.MobCombatMode == "Bow" then
                    task.wait(0.08)
                else
                    local target = nil
                    if state.CurrentTarget and isAliveMob(state.CurrentTarget) then
                        target = state.CurrentTarget
                    else
                        for _, candidate in ipairs(collectSelectedMobs(CONFIG.MobRadius)) do
                            if visibleMobAimPoint(candidate) then
                                target = candidate
                                break
                            end
                        end
                        state.CurrentTarget = target
                    end

                    if target and isAliveMob(target) and visibleMobAimPoint(target) and mobBowFarmShot then
                        mobBowFarmShot(target)
                    else
                        state.CurrentTarget = nil
                        task.wait(0.08)
                    end
                end

                task.wait(math.max(CONFIG.AttackDelay, 0.08))
            end
            if stopMobBowFarm then pcall(stopMobBowFarm) end
        end)
    end)
end

