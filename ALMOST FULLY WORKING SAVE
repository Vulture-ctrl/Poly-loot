local function circularDiscScore(part)
    if not (part and part:IsA("BasePart") and part.Parent) then
        return nil
    end
    -- Never let an invisible collision/hitbox become the bullseye.
    if part.Transparency >= 0.95 then
        return nil
    end
    local sx, sy, sz = part.Size.X, part.Size.Y, part.Size.Z
    local dims = {sx, sy, sz}
    table.sort(dims)
    local thickness, a, b = dims[1], dims[2], dims[3]
    local diameter = (a + b) * 0.5
    if diameter < 0.45 then return nil end
    if math.abs(a - b) > math.max(0.08, diameter * 0.08) then return nil end
    if thickness > diameter * 0.45 then return nil end
    return diameter
end

local function findArcheryTargetContainer(targetModel)
    if not (targetModel and targetModel:IsA("Model") and targetModel.Parent) then
        return nil
    end
    for _, descendant in ipairs(targetModel:GetDescendants()) do
        if descendant:IsA("Model") and descendant.Name == "Target" then
            return descendant
        end
    end
    return targetModel
end

local function getArcheryRingRadii(targetModel, bull)
    local root = findArcheryTargetContainer(targetModel)
    local radii = {}
    if root then
        for _, descendant in ipairs(root:GetDescendants()) do
            if descendant:IsA("BasePart") then
                local diameter = circularDiscScore(descendant)
                if diameter then
                    table.insert(radii, diameter * 0.5)
                end
            end
        end
    end
    table.sort(radii)

    -- Remove near-duplicate radii from overlapping decorative discs.
    local unique = {}
    for _, radius in ipairs(radii) do
        if #unique == 0 or math.abs(radius - unique[#unique]) > 0.04 then
            table.insert(unique, radius)
        end
    end

    -- The live target uses evenly expanding concentric rings. If the runtime model
    -- exposes only the bull disc, infer the next two score radii from that spacing.
    if #unique < 3 and bull then
        local diameter = circularDiscScore(bull)
        local base = diameter and diameter * 0.5 or math.max(bull.Size.Y, bull.Size.Z) * 0.5
        unique[1] = unique[1] or base
        unique[2] = unique[2] or base * 2
        unique[3] = unique[3] or base * 3
    end
    return unique
end

local function bullPlaneNormal(bull)
    local size = bull.Size
    if size.X <= size.Y and size.X <= size.Z then
        return bull.CFrame.RightVector
    elseif size.Y <= size.X and size.Y <= size.Z then
        return bull.CFrame.UpVector
    end
    return bull.CFrame.LookVector
end

local function isRound3VelocityForBull(bull, targetVelocity)
    if not (bull and typeof(targetVelocity) == "Vector3") then
        return false
    end

    local speed = targetVelocity.Magnitude
    if speed < ARCHERY_ROUND3_MIN_SPEED then
        return false
    end

    local localVelocity = bull.CFrame:VectorToObjectSpace(targetVelocity)
    local size = bull.Size
    local lateralSpeed
    if size.X <= size.Y and size.X <= size.Z then
        lateralSpeed = math.abs(localVelocity.Z)
    elseif size.Y <= size.X and size.Y <= size.Z then
        lateralSpeed = math.abs(localVelocity.X)
    else
        lateralSpeed = math.abs(localVelocity.X)
    end

    return lateralSpeed >= ARCHERY_ROUND3_MIN_LATERAL_SPEED
end

local function projectedScoreForCamera(camera, target, bull, predictedCenter)
    if not (camera and target and bull and predictedCenter) then
        return 0, math.huge
    end

    local origin = camera.CFrame.Position
    local direction = camera.CFrame.LookVector
    local normal = bullPlaneNormal(bull)
    local denom = direction:Dot(normal)
    if math.abs(denom) < 0.02 then
        return 0, math.huge
    end

    local t = (predictedCenter - origin):Dot(normal) / denom
    if t <= 0 then
        return 0, math.huge
    end

    local projected = origin + direction * t
    local errorDistance = (projected - predictedCenter).Magnitude
    local radii = getArcheryRingRadii(target, bull)
    local r10 = radii[1]
    local r9 = radii[2]
    local r8 = radii[3]

    if r10 and errorDistance <= r10 * ARCHERY_AUTO_RING_SAFETY then
        return 10, errorDistance
    elseif r9 and errorDistance <= r9 * ARCHERY_AUTO_RING_SAFETY then
        return 9, errorDistance
    elseif r8 and errorDistance <= r8 * ARCHERY_AUTO_RING_SAFETY then
        return 8, errorDistance
    end
    return 0, errorDistance
end


local function scoreForImpactError(target, bull, errorDistance, safetyScale)
    local radii = getArcheryRingRadii(target, bull)
    local r10 = radii[1]
    local r9 = radii[2]
    local r8 = radii[3]
    local safety = safetyScale or ARCHERY_AUTO_RING_SAFETY

    if r10 and errorDistance <= r10 * safety then
        return 10
    elseif r9 and errorDistance <= r9 * safety then
        return 9
    elseif r8 and errorDistance <= r8 * safety then
        return 8
    end
    return 0
end

local function resolveArcheryBallisticModules()
    if archeryArrowFlight and archeryWeaponConfig then
        return archeryArrowFlight, archeryWeaponConfig
    end

    local engine = ReplicatedStorage:FindFirstChild("Weapon_Engine")
    local modules = engine and engine:FindFirstChild("Modules")
    if not modules then return nil, nil end

    if not archeryArrowFlight then
        local moduleScript = modules:FindFirstChild("ArrowFlight")
        if moduleScript and moduleScript:IsA("ModuleScript") then
            local ok, module = pcall(require, moduleScript)
            if ok and type(module) == "table" then
                archeryArrowFlight = module
            end
        end
    end

    if not archeryWeaponConfig then
        local moduleScript = modules:FindFirstChild("WeaponConfig")
        if moduleScript and moduleScript:IsA("ModuleScript") then
            local ok, module = pcall(require, moduleScript)
            if ok and type(module) == "table" then
                archeryWeaponConfig = module
            end
        end
    end

    return archeryArrowFlight, archeryWeaponConfig
end

local function resolvedArcheryBowConfig(tool)
    if not tool then return nil end
    if archeryBallisticTool == tool and archeryBallisticCfg then
        return archeryBallisticCfg
    end

    local _, weaponConfig = resolveArcheryBallisticModules()
    if not weaponConfig or type(weaponConfig.Resolve) ~= "function" then
        return nil
    end

    local weaponId = tool:GetAttribute("WeaponId")
    if type(weaponId) ~= "string" then return nil end

    local ok, cfg = pcall(function()
        return weaponConfig.Resolve(weaponId, {tool, tool:FindFirstChild("Anim")}, true)
    end)
    if ok and type(cfg) == "table" then
        archeryBallisticTool = tool
        archeryBallisticCfg = cfg
        return cfg
    end
    return nil
end

local function exactSolvedTrajectoryScore(target, bull, rawCenter, targetVelocity)
    if not (target and bull and rawCenter and bull.Parent) then
        return 0, math.huge, nil, false
    end

    local bowClient = resolveArcheryBowClient()
    if not bowClient or type(bowClient.AimDir) ~= "function" then
        return 0, math.huge, nil, false
    end

    local aimDir = nil
    local okAim = pcall(function()
        aimDir = bowClient.AimDir()
    end)
    if not okAim or typeof(aimDir) ~= "Vector3" or aimDir.Magnitude < 0.001 then
        return 0, math.huge, nil, false
    end
    aimDir = aimDir.Unit

    local tool = isBowEquipped()
    local cfg = resolvedArcheryBowConfig(tool)
    local arrowFlight = select(1, resolveArcheryBallisticModules())
    if not cfg or not arrowFlight
        or type(arrowFlight.SpeedFor) ~= "function"
        or type(arrowFlight.ClearMuzzle) ~= "function"
        or type(arrowFlight.PositionAt) ~= "function" then
        return 0, math.huge, nil, false
    end

    local character = Player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then
        return 0, math.huge, nil, false
    end

    local speed = nil
    local okSpeed = pcall(function()
        speed = arrowFlight.SpeedFor(cfg, 1)
    end)
    speed = tonumber(speed)
    if not okSpeed or not speed or speed <= 1 then
        return 0, math.huge, nil, false
    end

    local gravity = tonumber(cfg.ArrowGravity) or 60
    local origin = root.Position
    pcall(function()
        local clear = arrowFlight.ClearMuzzle(root.Position, cfg, aimDir, {character})
        if typeof(clear) == "Vector3" then
            origin = clear
        end
    end)

    local launchVelocity = aimDir * speed
    local measuredVelocity = typeof(targetVelocity) == "Vector3" and targetVelocity or Vector3.zero
    local round3 = isRound3VelocityForBull(bull, measuredVelocity)
    -- V33: V32 shortened Round 3 too far. The target is fast enough that this
    -- under-led the crossing point and could leave the score gate with no valid window.
    -- Use a balanced 88% lead for Round 3 while preserving exact arrow physics.
    local velocity = round3 and (measuredVelocity * ARCHERY_ROUND3_PREDICTION_SCALE) or measuredVelocity
    local normal = bullPlaneNormal(bull)
    local speedOfTarget = velocity.Magnitude
    local targetLatency = round3 and ARCHERY_ROUND3_TARGET_LATENCY or ARCHERY_AUTO_TARGET_LATENCY

    local function targetCenterAt(t)
        return rawCenter + velocity * (t + targetLatency)
    end

    local function arrowPositionAt(t)
        local value = nil
        local ok = pcall(function()
            value = arrowFlight.PositionAt(origin, launchVelocity, gravity, t)
        end)
        if ok and typeof(value) == "Vector3" then
            return value
        end
        return nil
    end

    local previousT = 0
    local previousArrow = arrowPositionAt(0)
    if not previousArrow then
        return 0, math.huge, nil, false
    end
    local previousCenter = targetCenterAt(0)
    local previousSigned = (previousArrow - previousCenter):Dot(normal)

    local crossingA, crossingB = nil, nil
    local t = ARCHERY_AUTO_SIM_STEP
    while t <= ARCHERY_AUTO_MAX_SIM_TIME do
        local arrowPos = arrowPositionAt(t)
        if not arrowPos then
            return 0, math.huge, nil, false
        end
        local center = targetCenterAt(t)
        local signed = (arrowPos - center):Dot(normal)

        if signed == 0 or previousSigned == 0 or (signed > 0) ~= (previousSigned > 0) then
            crossingA, crossingB = previousT, t
            break
        end

        previousT = t
        previousArrow = arrowPos
        previousCenter = center
        previousSigned = signed
        t = t + ARCHERY_AUTO_SIM_STEP
    end

    if not crossingA then
        return 0, math.huge, nil, true
    end

    -- Refine the moving-plane crossing so tiny Round 3 rings are not judged from
    -- a coarse trajectory sample.
    local a, b = crossingA, crossingB
    for _ = 1, ARCHERY_AUTO_BINARY_STEPS do
        local mid = (a + b) * 0.5
        local posA = arrowPositionAt(a)
        local centerA = targetCenterAt(a)
        local posMid = arrowPositionAt(mid)
        local centerMid = targetCenterAt(mid)
        if not (posA and posMid) then
            return 0, math.huge, nil, false
        end
        local signedA = (posA - centerA):Dot(normal)
        local signedMid = (posMid - centerMid):Dot(normal)
        if signedMid == 0 or (signedA > 0) ~= (signedMid > 0) then
            b = mid
        else
            a = mid
        end
    end

    local impactTime = (a + b) * 0.5
    local impact = arrowPositionAt(impactTime)
    local futureCenter = targetCenterAt(impactTime)
    if not (impact and futureCenter) then
        return 0, math.huge, nil, false
    end

    local errorVector = impact - futureCenter
    local radialVector = errorVector - normal * errorVector:Dot(normal)
    local radialError = radialVector.Magnitude

    -- Round 3 can change direction between the final client frame and server-side
    -- shot processing. Charge that timing uncertainty directly against the score
    -- radius. This makes the gate intentionally conservative: fewer shots, but no
    -- deliberate 6/7 releases.
    -- V33: the old 0.030s uncertainty made Round 3 mathematically impossible at
    -- high target speeds (the penalty alone could exceed the entire 8 ring).
    -- Keep the conservative model for Rounds 1/2, but use a smaller measured
    -- processing margin and the real ring area for the fast Round 3 target.
    local timingUncertainty = round3 and ARCHERY_ROUND3_TIMING_UNCERTAINTY or ARCHERY_AUTO_TIMING_UNCERTAINTY
    local ringSafety = round3 and ARCHERY_ROUND3_RING_SAFETY or ARCHERY_AUTO_RING_SAFETY
    local robustError = radialError + speedOfTarget * timingUncertainty
    local score = scoreForImpactError(target, bull, robustError, ringSafety)
    return score, robustError, impactTime, true
end

resolveArcheryBowClient = function()
    local function valid(module)
        return type(module) == "table"
            and type(module.SetTouchHeld) == "function"
            and type(module.IsDrawing) == "function"
            and type(module.AimDir) == "function"
    end

    if valid(archeryBowClient) then
        return archeryBowClient
    end

    -- Do not repeatedly scan getgc/getloadedmodules every rendered frame.
    local now = os.clock()
    if now - archeryBowClientLastResolve < 0.35 then
        return nil
    end
    archeryBowClientLastResolve = now

    local function globalFunction(name)
        local value = nil
        if type(getgenv) == "function" then
            pcall(function()
                local env = getgenv()
                if type(env) == "table" then value = env[name] end
            end)
        end
        if value == nil and type(getfenv) == "function" then
            pcall(function()
                local env = getfenv()
                if type(env) == "table" then value = env[name] end
            end)
        end
        if value == nil and type(_G) == "table" then
            value = rawget(_G, name)
        end
        return value
    end

    -- Best path in injected environments: find the exact BowClient module that the
    -- game's WeaponClient has already loaded, instead of requiring a duplicate path.
    local getLoaded = globalFunction("getloadedmodules")
    if type(getLoaded) == "function" then
        local ok, modules = pcall(getLoaded)
        if ok and type(modules) == "table" then
            for _, moduleScript in ipairs(modules) do
                if typeof(moduleScript) == "Instance"
                    and moduleScript:IsA("ModuleScript")
                    and moduleScript.Name == "BowClient" then
                    local okRequire, module = pcall(require, moduleScript)
                    if okRequire and valid(module) then
                        archeryBowClient = module
                        return module
                    end
                end
            end
        end
    end

    -- Runtime-table fallback. This finds the already-created BowClient export table
    -- even when requiring PlayerScripts modules from the injected thread is blocked.
    local getGc = globalFunction("getgc")
    if type(getGc) == "function" then
        local ok, objects = pcall(getGc, true)
        if ok and type(objects) == "table" then
            for _, object in ipairs(objects) do
                if valid(object) then
                    archeryBowClient = object
                    return object
                end
            end
        end
    end

    -- Normal Roblox path fallback.
    local playerScripts = Player:FindFirstChild("PlayerScripts")
    if not playerScripts then return nil end
    local bowFolder = playerScripts:FindFirstChild("Bow_Client")
    local known = bowFolder and bowFolder:FindFirstChild("BowClient")
    if known and known:IsA("ModuleScript") then
        local ok, module = pcall(require, known)
        if ok and valid(module) then
            archeryBowClient = module
            return module
        end
    end
    for _, descendant in ipairs(playerScripts:GetDescendants()) do
        if descendant:IsA("ModuleScript") and descendant.Name == "BowClient" then
            local ok, module = pcall(require, descendant)
            if ok and valid(module) then
                archeryBowClient = module
                return module
            end
        end
    end
    return nil
end

local function archeryAutoMousePosition(camera)
    camera = camera or Workspace.CurrentCamera
    if camera then
        local size = camera.ViewportSize
        return math.floor(size.X * 0.5), math.floor(size.Y * 0.5)
    end
    return 640, 360
end

local function executorGlobal(name)
    local value = nil
    if type(getgenv) == "function" then
        pcall(function()
            local env = getgenv()
            if type(env) == "table" then value = env[name] end
        end)
    end
    if value == nil and type(getfenv) == "function" then
        pcall(function()
            local env = getfenv()
            if type(env) == "table" then value = env[name] end
        end)
    end
    if value == nil and type(_G) == "table" then
        value = rawget(_G, name)
    end
    return value
end

local function fireArcheryInputConnections(isDown)
    local getter = executorGlobal("getconnections")
    if type(getter) ~= "function" then return false end
    local signal = isDown and UserInputService.InputBegan or UserInputService.InputEnded
    local ok, list = pcall(getter, signal)
    if not ok or type(list) ~= "table" then return false end

    local fakeInput = {
        UserInputType = Enum.UserInputType.MouseButton1,
        KeyCode = Enum.KeyCode.Unknown,
    }
    local fired = false
    for _, connection in ipairs(list) do
        local fn = nil
        pcall(function() fn = connection.Function end)
        if type(fn) == "function" then
            local good = pcall(fn, fakeInput, false)
            fired = fired or good
        else
            local fire = nil
            pcall(function() fire = connection.Fire end)
            if type(fire) == "function" then
                local good = pcall(function()
                    connection:Fire(fakeInput, false)
                end)
                fired = fired or good
            end
        end
    end
    return fired
end

local function sendArcheryMouseButton(isDown, camera)
    local x, y = archeryAutoMousePosition(camera)
    local sent = false

    -- Executor-native input is the most reliable way to create a real held Mouse1.
    local native = executorGlobal(isDown and "mouse1press" or "mouse1release")
    if type(native) == "function" then
        sent = pcall(native) or sent
    end

    -- Directly invoke the same UserInputService listeners the normal bow uses.
    sent = fireArcheryInputConnections(isDown) or sent

    if VirtualInputManager then
        local ok = pcall(function()
            VirtualInputManager:SendMouseButtonEvent(x, y, 0, isDown, game, 0)
        end)
        sent = ok or sent
    end

    local okVirtual = pcall(function()
        local cam = camera or Workspace.CurrentCamera
        if isDown then
            VirtualUser:Button1Down(Vector2.new(x, y), cam and cam.CFrame or CFrame.new())
        else
            VirtualUser:Button1Up(Vector2.new(x, y), cam and cam.CFrame or CFrame.new())
        end
    end)
    sent = okVirtual or sent

    if sent then
        archeryAutoVirtualMouseHeld = isDown == true
    end
    return sent
end

local function forceArcheryDrawDown(camera)
    local started = false
    local bowClient = resolveArcheryBowClient()

    -- Call the real game bow API first. startDraw() internally ignores duplicate starts,
    -- so using the input fallbacks too is safe and prevents silent no-draw failures.
    if bowClient then
        local attached = true
        if type(bowClient.IsAttached) == "function" then
            local ok, value = pcall(bowClient.IsAttached)
            if ok then attached = value == true end
        end
        if attached then
            started = pcall(function() bowClient.SetTouchHeld(true) end) or started
        end
    end

    started = sendArcheryMouseButton(true, camera) or started
    archeryAutoInputMode = "VerifiedMulti"
    return started
end

local function startArcheryAutoDraw(camera)
    local started = forceArcheryDrawDown(camera)
    if started then
        archeryAutoConfirmedDraw = false
        return true
    end
    return false
end

local function releaseArcheryAutoDraw(camera)
    if not archeryAutoOwnsDraw and not archeryAutoVirtualMouseHeld then return end

    local bowClient = resolveArcheryBowClient()
    if bowClient then
        pcall(function() bowClient.SetTouchHeld(false) end)
    end
    sendArcheryMouseButton(false, camera)

    archeryAutoOwnsDraw = false
    archeryAutoConfirmedDraw = false
    archeryAutoInputMode = nil
    archeryAutoVirtualMouseHeld = false
    archeryAutoDrawStartedAt = 0
    archeryAutoDrawVerifyAt = 0
    archeryAutoGoodFrames = 0
end

local function isRound3Motion(bull, targetVelocity)
    return isRound3VelocityForBull(bull, targetVelocity)
end

local function requiredAutoScore(bull, targetVelocity)
    return isRound3Motion(bull, targetVelocity) and 8 or 10
end

local function archeryAutoShootTick(now, camera, target, bull, rawCenter, targetVelocity)
    if not state.ArcheryAutoShoot or killSwitchActivated then
        return
    end

    if not archeryAutoVirtualMouseHeld
        and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
        archeryAutoGoodFrames = 0
        return
    end

    local bowClient = resolveArcheryBowClient()
    local drawing = false
    local canVerifyDrawing = bowClient and type(bowClient.IsDrawing) == "function"
    if canVerifyDrawing then
        pcall(function() drawing = bowClient.IsDrawing() == true end)
    end

    if not archeryAutoOwnsDraw then
        if now < archeryAutoNextShotAt then return end
        if drawing and not archeryAutoVirtualMouseHeld then return end

        if startArcheryAutoDraw(camera) then
            archeryAutoOwnsDraw = true
            archeryAutoDrawStartedAt = now
            archeryAutoDrawVerifyAt = now + 0.10
            archeryAutoGoodFrames = 0
        end
        return
    end

    -- If BowClient is available, DO NOT trust an input call merely because pcall
    -- returned true. Keep reasserting Mouse1/API hold until IsDrawing() is actually true.
    if canVerifyDrawing then
        if drawing then
            if not archeryAutoConfirmedDraw then
                archeryAutoConfirmedDraw = true
                archeryAutoDrawStartedAt = now -- full-charge timer starts from confirmed draw
            end
        elseif now >= archeryAutoDrawVerifyAt then
            forceArcheryDrawDown(camera)
            archeryAutoDrawVerifyAt = now + 0.10
            archeryAutoGoodFrames = 0
            return
        else
            archeryAutoGoodFrames = 0
            return
        end
    elseif now >= archeryAutoDrawVerifyAt then
        -- No readable IsDrawing() API: keep reasserting the held input periodically.
        forceArcheryDrawDown(camera)
        archeryAutoDrawVerifyAt = now + 0.25
    end

    if now - archeryAutoDrawStartedAt < ARCHERY_AUTO_FULL_CHARGE_SECONDS then
        archeryAutoGoodFrames = 0
        return
    end

    local score, errorDistance, impactTime, trustworthy =
        exactSolvedTrajectoryScore(target, bull, rawCenter, targetVelocity)

    archeryLatestScore = score
    archeryLatestScoreError = errorDistance
    archeryLatestScoreTime = now

    local speed = typeof(targetVelocity) == "Vector3" and targetVelocity.Magnitude or 0
    local round3 = isRound3Motion(bull, targetVelocity)
    local requiredFrames = round3
        and ARCHERY_ROUND3_GOOD_FRAMES
        or (speed >= ARCHERY_AUTO_FAST_SPEED and ARCHERY_AUTO_FAST_GOOD_FRAMES or ARCHERY_AUTO_GOOD_FRAMES)
    local directionSettle = round3 and ARCHERY_ROUND3_DIRECTION_SETTLE or ARCHERY_AUTO_DIRECTION_SETTLE
    local directionStable = (now - archeryLastDirectionChangeAt) >= directionSettle

    -- Rounds 1/2: strict 10 only. Round 3: safely predicted 8, 9, or 10 is allowed.
    -- A 7 or lower always resets the release gate.
    local minimumScore = round3 and 8 or 10
    if trustworthy and impactTime and score >= minimumScore and directionStable then
        archeryAutoGoodFrames = archeryAutoGoodFrames + 1
    else
        archeryAutoGoodFrames = 0
    end

    if archeryAutoGoodFrames >= requiredFrames then
        releaseArcheryAutoDraw(camera)
        archeryAutoNextShotAt = now + ARCHERY_AUTO_POST_SHOT_COOLDOWN
    end
end

local function findArcheryBull(targetModel)
    if not (targetModel and targetModel:IsA("Model") and targetModel.Parent) then
        return nil
    end

    -- The real ArrowTarget layout contains a nested Model named "Target" holding
    -- the concentric rings. Search MODELS first; never trust a random BasePart
    -- named Target because runtime hitboxes can remain stationary/invisible.
    local targetContainer = nil
    for _, descendant in ipairs(targetModel:GetDescendants()) do
        if descendant:IsA("Model") and descendant.Name == "Target" then
            targetContainer = descendant
            break
        end
    end

    local searchRoot = targetContainer or targetModel
    local best, bestDiameter = nil, math.huge
    for _, descendant in ipairs(searchRoot:GetDescendants()) do
        if descendant:IsA("BasePart") then
            local diameter = circularDiscScore(descendant)
            if diameter and diameter < bestDiameter then
                best = descendant
                bestDiameter = diameter
            end
        end
    end
    return best
end

isBowEquipped = function()
    local character = Player.Character
    if not character then return nil end
    local tool = character:FindFirstChildOfClass("Tool")
    if not tool then return nil end
    local lowered = string.lower(tool.Name)
    if string.find(lowered, "bow", 1, true) then return tool end
    local weaponId = tool:GetAttribute("WeaponId")
    if type(weaponId) == "string" and string.find(string.lower(weaponId), "bow", 1, true) then return tool end
    return nil
end

local function archeryTargetOwner(model)
    -- Return the first duel owner found on the model/wrappers. The game's own bow
    -- code uses _DuelOwner on ArcheryActor models, so explicit ownership is stronger
    -- evidence than camera position or screen-center distance.
    local node = model
    for _ = 1, 6 do
        if not node or node == Workspace then break end
        local owner = node:GetAttribute("_DuelOwner")
        if owner ~= nil then
            local numeric = tonumber(owner)
            return numeric or owner
        end
        node = node.Parent
    end
    return nil
end

local function isForeignArcheryTarget(model)
    local owner = archeryTargetOwner(model)
    return owner ~= nil and owner ~= Player.UserId
end

local function localArcheryOwnerBonus(model)
    local owner = archeryTargetOwner(model)
    return owner == Player.UserId and ARCHERY_LOCAL_OWNER_BONUS or 0
end

local function suppressArcheryCutsceneCamera(camera, humanoid)
    if not ARCHERY_BLOCK_CUTSCENES or not camera or not humanoid then return end

    -- Archery cinematics can temporarily take camera ownership or change the subject.
    -- Reclaim both every late render frame. applyAim then writes the target-facing
    -- CFrame after this, so even a Custom-camera cinematic cannot visually pull us away.
    if camera.CameraType ~= Enum.CameraType.Custom then
        camera.CameraType = Enum.CameraType.Custom
    end
    if camera.CameraSubject ~= humanoid then
        camera.CameraSubject = humanoid
    end
end

local function rootFrontData(part, root, laneRatio)
    if not (part and part.Parent and root) then return nil end
    local offset = part.Position - root.Position
    local distance = offset.Magnitude
    if distance < 1 or distance > ARCHERY_MAX_TARGET_DISTANCE then return nil end
    local direction = offset.Unit
    local dot = root.CFrame.LookVector:Dot(direction)
    if dot < ARCHERY_FRONT_DOT_MIN then return nil end
    local localPos = root.CFrame:PointToObjectSpace(part.Position)
    local depth = -localPos.Z
    if depth <= 1 then return nil end
    -- Keep the selected target in our shooting lane. Round 3 can move widely, so this
    -- is intentionally generous; it mainly rejects another target sitting off to the
    -- side/in front of the opponent NPC.
    local allowedLane = laneRatio or ARCHERY_MAX_LOCK_LANE_RATIO
    if math.abs(localPos.X) / depth > allowedLane then return nil end
    return localPos, depth, distance, dot
end

local function sampleCandidateMotion(part, now)
    local position = part.Position
    local rec = archeryCandidateMotion[part]
    if not rec then
        rec = {position = position, time = now, speed = 0}
        archeryCandidateMotion[part] = rec
        return 0
    end

    local dt = now - rec.time
    if dt > 0.001 and dt <= 0.30 then
        local speed = (position - rec.position).Magnitude / dt
        rec.speed = math.clamp(speed, 0, ARCHERY_MAX_SELECTION_SPEED)
        rec.position = position
        rec.time = now
    elseif dt > 0.30 then
        rec.position = position
        rec.time = now
        rec.speed = 0
    end
    -- If the late backup pass runs in the same frame, preserve the first sample.
    return rec.speed or 0
end

local function archerySpeedRatio(speed)
    return math.clamp(
        (speed - ARCHERY_SPEED_ADAPT_START) / math.max(ARCHERY_SPEED_ADAPT_FULL - ARCHERY_SPEED_ADAPT_START, 0.001),
        0,
        1
    )
end

local function estimateLiveBullVelocity(bull, now)
    if not (bull and bull.Parent) then
        return Vector3.zero
    end

    local position = bull.Position
    if archeryLastBullPart ~= bull or not archeryLastBullPosition or archeryLastBullTime <= 0 then
        archeryLastBullPart = bull
        archeryLastBullPosition = position
        archeryLastBullTime = now
        archeryTrackedVelocity = Vector3.zero
        return Vector3.zero
    end

    local dt = now - archeryLastBullTime
    -- applyAim can run twice in one rendered frame. Ignore the duplicate sample instead
    -- of turning a tiny dt into a huge fake velocity.
    if dt < 0.004 then
        return archeryTrackedVelocity
    end

    if dt > 0.30 then
        archeryLastBullPosition = position
        archeryLastBullTime = now
        archeryTrackedVelocity = Vector3.zero
        return Vector3.zero
    end

    local observed = (position - archeryLastBullPosition) / dt
    local speed = observed.Magnitude
    if speed > ARCHERY_MAX_TRACKED_SPEED then
        observed = observed.Unit * ARCHERY_MAX_TRACKED_SPEED
    end

    -- Slow rounds stay filtered and smooth. Round 3 gets a much faster velocity
    -- response so the predictor is not aiming using movement from several frames ago.
    local speedRatio = archerySpeedRatio(speed)
    local previousTracked = archeryTrackedVelocity
    local directionReversed = previousTracked.Magnitude > 0.05 and observed.Magnitude > 0.05
        and previousTracked:Dot(observed) < 0
    local velocityJump = (observed - previousTracked).Magnitude
    if directionReversed or velocityJump > math.max(18, observed.Magnitude * 0.55) then
        archeryLastDirectionChangeAt = now
    end

    if directionReversed then
        archeryTrackedVelocity = archeryTrackedVelocity:Lerp(observed, ARCHERY_REVERSE_VELOCITY_BLEND)
    else
        local blend = ARCHERY_VELOCITY_BLEND
            + (ARCHERY_FAST_VELOCITY_BLEND - ARCHERY_VELOCITY_BLEND) * speedRatio
        archeryTrackedVelocity = archeryTrackedVelocity:Lerp(observed, blend)
    end

    archeryLastBullPosition = position
    archeryLastBullTime = now
    return archeryTrackedVelocity
end

local function predictLiveBullPoint(cameraPosition, rawCenter, velocity, bull)
    local distance = (rawCenter - cameraPosition).Magnitude
    local speedRatio = archerySpeedRatio(velocity.Magnitude)
    local round3 = isRound3VelocityForBull(bull, velocity)
    local maxPredictionTime = round3 and ARCHERY_ROUND3_MAX_PREDICTION_TIME or ARCHERY_MAX_PREDICTION_TIME
    local flightTime = math.clamp(
        distance / ARCHERY_PREDICTION_ARROW_SPEED + ARCHERY_PREDICTION_LATENCY,
        0,
        maxPredictionTime
    )

    -- Round 1/2 keep the existing lead. Round 3 uses a balanced lead: enough
    -- horizon for its higher speed, but still below full linear extrapolation so
    -- direction reversals do not produce huge overshoot.
    local predictionStrength = ARCHERY_PREDICTION_STRENGTH
        + (ARCHERY_FAST_PREDICTION_STRENGTH - ARCHERY_PREDICTION_STRENGTH) * speedRatio
    if round3 then
        predictionStrength = predictionStrength * ARCHERY_ROUND3_PREDICTION_SCALE
    end
    local lead = velocity * flightTime * predictionStrength
    local maxLead = round3 and ARCHERY_ROUND3_MAX_LEAD_DISTANCE
        or (7.5 + (ARCHERY_MAX_LEAD_DISTANCE - 7.5) * speedRatio)
    if lead.Magnitude > maxLead then
        lead = lead.Unit * maxLead
    end
    return rawCenter + lead, speedRatio
end

local function candidateScore(model, bull, root, camera, now, sourceBonus)
    -- A newly seen target must stay in the strict shooting lane. Once we have already
    -- locked the correct round target, allow it to travel farther at Round 3's edges
    -- without dropping lock and snapping to the NPC/neighbor target.
    local laneRatio = (model == archeryLockedTarget) and ARCHERY_LOCKED_MAX_LANE_RATIO or ARCHERY_MAX_LOCK_LANE_RATIO
    local localPos, depth, distance, dot = rootFrontData(bull, root, laneRatio)
    if not localPos then return -math.huge end

    local horizontalRatio = math.abs(localPos.X) / depth
    local verticalRatio = math.abs(localPos.Y) / depth
    local motionSpeed = sampleCandidateMotion(bull, now)

    -- V26 IMPORTANT: do NOT use WorldToViewportPoint/current-camera center here.
    -- A round-transition cinematic can swing the camera away for a frame and make the
    -- correct target appear off-screen, which used to drop the lock and select the
    -- neighboring/NPC target. Root-space lane + ownership + motion are camera-proof.
    return -(horizontalRatio * 50000)
        - (verticalRatio * 900)
        + (dot * 2600)
        - (distance * 0.02)
        + (motionSpeed * ARCHERY_ACTIVE_MOTION_BONUS)
        + (sourceBonus or 0)
        + localArcheryOwnerBonus(model)
end

local function findLiveArcheryTarget(root, camera)
    local now = os.clock()
    local bestModel, bestBull, bestScore = nil, nil, -math.huge
    local lockedBull, lockedScore = nil, -math.huge
    local seen = {}

    local function consider(model, sourceBonus)
        if not (model and model:IsA("Model") and model.Parent) or seen[model] then return end
        seen[model] = true
        if isForeignArcheryTarget(model) then return end

        local bull = findArcheryBull(model)
        if not bull then return end
        local score = candidateScore(model, bull, root, camera, now, sourceBonus)
        if score == -math.huge then return end

        if model == archeryLockedTarget then
            lockedBull, lockedScore = bull, score
        end
        if score > bestScore then
            bestModel, bestBull, bestScore = model, bull, score
        end
    end

    -- The bow client explicitly watches ArcheryActor-tagged models during archery.
    for _, actor in ipairs(CollectionService:GetTagged("ArcheryActor")) do
        if actor:IsA("Model") then
            consider(actor, 5000)
        end
    end

    local live = Workspace:FindFirstChild("ArcheryContest_Live")
    if live then
        for _, inst in ipairs(live:GetDescendants()) do
            if inst:IsA("Model") then
                local n = inst.Name
                if n == "ArrowTarget" or string.sub(n, 1, 14) == "ArcheryTarget_" or CollectionService:HasTag(inst, "ArcheryActor") then
                    consider(inst, 3500)
                end
            end
        end
    end

    for _, child in ipairs(Workspace:GetChildren()) do
        if child:IsA("Model") and child.Name == "ArrowTarget" then
            consider(child, 1000)
        end
    end

    if not bestModel then
        for _, inst in ipairs(Workspace:GetDescendants()) do
            if inst:IsA("Model") and inst.Name == "ArrowTarget" then
                consider(inst, 0)
            end
        end
    end

    -- Hysteresis: once we have the correct live target, do not bounce to a nearby
    -- candidate just because its score wins by a tiny amount for one frame. We still
    -- allow a clearly better/new moving target to take over at round transitions.
    if archeryLockedTarget and lockedBull and lockedScore > -math.huge then
        local age = now - archeryLockChosenAt
        if age <= ARCHERY_LOCK_KEEP_SECONDS
            or bestModel == archeryLockedTarget
            or lockedScore >= bestScore - ARCHERY_TARGET_SWITCH_MARGIN then
            return archeryLockedTarget, lockedBull
        end
    end

    if bestModel and bestModel ~= archeryLockedTarget then
        archeryLockChosenAt = now
    end
    return bestModel, bestBull
end

local function clearArcheryLock()
    archeryLockedTarget = nil
    archeryLockedBull = nil
    archeryLastBullPart = nil
    archeryLastBullPosition = nil
    archeryLastBullTime = 0
    archeryTrackedVelocity = Vector3.zero
    archerySmoothedAimPoint = nil
    archerySmoothedTarget = nil
    archeryLastAimTime = 0
    archeryLockChosenAt = 0
    archeryLatestScore = 0
    archeryLatestScoreError = math.huge
    archeryLatestScoreTime = 0
end

local function restoreArcheryShiftLockY()
    local character = Player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        local offset = humanoid.CameraOffset
        humanoid.CameraOffset = Vector3.new(offset.X, 0, offset.Z)
    end
end

stopArcheryAutoShoot = function()
    state.ArcheryAutoShoot = false
    releaseArcheryAutoDraw()
    archeryAutoNextShotAt = 0
    archeryAutoGoodFrames = 0
    archeryAutoInputMode = nil
    archeryAutoVirtualMouseHeld = false
    archeryAutoDrawVerifyAt = 0
    archeryAutoConfirmedDraw = false
end

stopArcheryAim = function()
    pcall(function() RunService:UnbindFromRenderStep(POLY_ARCHERY_BIND) end)
    if archeryLateConn then
        pcall(function() archeryLateConn:Disconnect() end)
        archeryLateConn = nil
    end
    restoreArcheryShiftLockY()
    clearArcheryLock()
    table.clear(archeryCandidateMotion)
end

local function setArcheryAim(enabled)
    archeryAimEnabled = enabled == true
    stopArcheryAim()
    if not archeryAimEnabled or killSwitchActivated then return end

    local function applyAim()
        if killSwitchActivated or not archeryAimEnabled then return end
        local character = Player.Character
        if not character or character:GetAttribute("_ArcheryMatch") ~= true or not isBowEquipped() then
            clearArcheryLock()
            return
        end

        local root = character:FindFirstChild("HumanoidRootPart")
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        local camera = Workspace.CurrentCamera
        if not root or not humanoid or not camera then return end

        -- V26: cancel/reject any archery cinematic camera takeover before target
        -- selection. The late render priority also wins against CFrame-only cutscenes.
        suppressArcheryCutsceneCamera(camera, humanoid)

        -- KEEP the confirmed centered Shift-Lock correction.
        local shiftOffset = humanoid.CameraOffset
        humanoid.CameraOffset = Vector3.new(shiftOffset.X, ARCHERY_SHIFTLOCK_OFFSET_Y, shiftOffset.Z)

        -- V23: resolve live candidates every frame, but keep the winner sticky with hysteresis so the camera does not bounce between nearby targets.
        -- This is the important change for Round 2 (vertical) and Round 3 (all-axis).
        local target, bull = findLiveArcheryTarget(root, camera)
        if not target or not bull then
            clearArcheryLock()
            return
        end
        archeryLockedTarget = target
        archeryLockedBull = bull

        -- V23: start from the exact live bullseye point, then add ONLY movement lead.
        -- A stationary bull has zero velocity, so its aim remains exactly where V20 centered it.
        local rawCenter = bull.Position + Vector3.new(0, ARCHERY_CENTER_OFFSET_Y, 0)
        local now = os.clock()
        local velocity = estimateLiveBullVelocity(bull, now)
        local aimPoint, speedRatio = predictLiveBullPoint(camera.CFrame.Position, rawCenter, velocity, bull)
        if (aimPoint - camera.CFrame.Position).Magnitude < 0.001 then return end

        -- Smooth only while following the SAME live target. If the contest genuinely
        -- swaps to a new target/round, reset immediately instead of dragging the old
        -- aim point across the screen.
        if archerySmoothedTarget ~= target or not archerySmoothedAimPoint or archeryLastAimTime <= 0 then
            archerySmoothedTarget = target
            archerySmoothedAimPoint = aimPoint
            archeryLastAimTime = now
        else
            local dt = math.clamp(now - archeryLastAimTime, 0, 0.10)
            archeryLastAimTime = now
            -- Preserve V22 smoothness at low speed, but remove most of the visible
            -- tracking lag during Round 3 by increasing response with target speed.
            local response = ARCHERY_AIM_SMOOTH_RESPONSE
                + (ARCHERY_FAST_AIM_SMOOTH_RESPONSE - ARCHERY_AIM_SMOOTH_RESPONSE) * (speedRatio or 0)
            local alpha = 1 - math.exp(-response * dt)
            archerySmoothedAimPoint = archerySmoothedAimPoint:Lerp(aimPoint, alpha)
        end

        local finalPoint = archerySmoothedAimPoint or aimPoint
        if (finalPoint - camera.CFrame.Position).Magnitude < 0.001 then return end
        camera.CFrame = CFrame.lookAt(camera.CFrame.Position, finalPoint)

        -- V27: aim still uses the responsive live predictor, but AUTO RELEASE no
        -- longer trusts the camera ray. The gate queries BowClient.AimDir() and
        -- simulates the same solved ballistic trajectory the game is about to fire.
        -- rawCenter + measured velocity lets the gate compare that arrow against the
        -- target's future position at impact time.
        archeryAutoShootTick(now, camera, target, bull, rawCenter, velocity)
    end

    -- ONE camera writer only. V21 also attached RenderStepped, which caused two aim
    -- updates in the same rendered frame and made the screen visibly twitch.
    RunService:BindToRenderStep(POLY_ARCHERY_BIND, ARCHERY_FINAL_PRIORITY, applyAim)
end

