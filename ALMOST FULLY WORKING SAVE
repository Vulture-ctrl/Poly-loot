        b.Text = labelText
        b.TextColor3 = Color3.fromRGB(230, 233, 240)
        indicator.Text = on and "ON" or "OFF"
        indicator.TextColor3 = on and Color3.fromRGB(120, 225, 150) or Color3.fromRGB(135, 140, 153)
    end

    b.Activated:Connect(function()
        state[key] = not state[key]
        redraw()
        local ok, err = pcall(function() callback(state[key]) end)
        if not ok then warn("[POLY LOOT]", labelText, err) end
    end)

