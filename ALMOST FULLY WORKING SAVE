}

local function isExactNaturePackDeleteTarget(obj)
    if not obj then return false end
    local n = string.lower(obj.Name)
    if not EXACT_NATUREPACK_DELETE_NAMES[n] then
        return false
    end

    local current = obj.Parent
    local sawUltimateNaturePack = false
    while current and current ~= Workspace do
        if string.lower(current.Name) == "ultimate nature pack" then
            sawUltimateNaturePack = true
            break
        end
        current = current.Parent
    end

    return sawUltimateNaturePack
end

local function protectedEnvironmentObject(obj)
    if not obj or obj == Workspace or obj == Workspace.Terrain then
        return true
    end

    if isExactNaturePackDeleteTarget(obj) then
        return false
    end

    local current = obj
    while current and current ~= Workspace do
        local n = string.lower(current.Name)

        -- Preserve the actual Terrain service and any separate map object
        -- explicitly named Terrain/TERRAIN.
        if n == "terrain" or n == "terrainservice" then
            return true
        end

        -- Never remove trees or resource objects.
        if CollectionService:HasTag(current, "ChoppableTree") then
            return true
        end
        if string.find(n, "tree", 1, true) or string.find(n, "sapling", 1, true) then
            return true
        end
        if n == "ore_live" or n == "animal_live" or n == "animal_localdrops" then
            return true
        end
        if string.find(n, "ore", 1, true) then
            return true
        end

        current = current.Parent
    end

    return false
end

local function isDecorationRoot(obj)
    if isExactNaturePackDeleteTarget(obj) then return true end
    if protectedEnvironmentObject(obj) then return false end
    local n = string.lower(obj.Name)

    if DECORATION_NAME_HINTS[n] then
        return true
    end

    if obj:IsA("Model") or obj:IsA("Folder") then
        return string.find(n, "bush", 1, true) ~= nil
            or string.find(n, "flower", 1, true) ~= nil
            or string.find(n, "grass", 1, true) ~= nil
            or string.find(n, "stump", 1, true) ~= nil
            or string.find(n, "trunk", 1, true) ~= nil
            or string.find(n, "mushroom", 1, true) ~= nil
            or string.find(n, "fern", 1, true) ~= nil
            or string.find(n, "shrub", 1, true) ~= nil
            or string.find(n, "weed", 1, true) ~= nil
            or string.find(n, "foliage", 1, true) ~= nil
            or string.find(n, "log", 1, true) ~= nil
            or string.find(n, "arch", 1, true) ~= nil
    end

    return false
end

local function isRockRoot(obj)
    if isExactNaturePackDeleteTarget(obj) then return true end
    if protectedEnvironmentObject(obj) then return false end
    local n = string.lower(obj.Name)
    if ROCK_NAME_HINTS[n] then
        return true
    end

    -- Only use explicit rock/path naming on Models/Folders/BaseParts.
    -- Do not use the broad rock-color classifier here because it can match
    -- legitimate walking surfaces.
    if obj:IsA("Model") or obj:IsA("Folder") or obj:IsA("BasePart") then
        return string.find(n, "rockpath", 1, true) ~= nil
            or string.find(n, "rock_path", 1, true) ~= nil
            or string.find(n, "movementpath", 1, true) ~= nil
            or string.find(n, "movement_path", 1, true) ~= nil
    end

    return false
end

local function isFenceRoot(obj)
    if protectedEnvironmentObject(obj) then return false end
    local n = string.lower(obj.Name)
    return FENCE_NAME_HINTS[n]
        or string.find(n, "fence", 1, true) ~= nil
        or CollectionService:HasTag(obj, "Fence")
end

local function isLanternRoot(obj)
    if protectedEnvironmentObject(obj) then return false end
    return string.find(string.lower(obj.Name), "lantern", 1, true) ~= nil
end

local function findDeleteRoot(obj)
    if protectedEnvironmentObject(obj) then return nil end

    local current = obj
    while current.Parent and current.Parent ~= Workspace do
        local parent = current.Parent
        if isRockRoot(parent) or isFenceRoot(parent) or isLanternRoot(parent) or isDecorationRoot(parent) then
            current = parent
        else
            break
        end
    end

    return current
end

local function saveAndDestroyObject(obj)
    if not obj or not obj.Parent or protectedEnvironmentObject(obj) then
        return false
    end

    local n = string.lower(obj.Name)
    if n == "terrain" then
        return false
    end

    if savedEnvironmentObjects[obj] then
        return false
    end

    local ok, clone = pcall(function()
        return obj:Clone()
    end)
    if not ok or not clone then
        return false
    end

    savedEnvironmentObjects[obj] = {
        clone = clone,
        parent = obj.Parent,
    }

    pcall(function()
        obj:Destroy()
    end)
    return true
end

setEnvironmentDeleteTest = function(enabled)
    if enabled then
        -- Never clear Workspace.Terrain. That is the actual terrain surface.
        -- Roblox Terrain is voxel-based and clearing it removes the terrain
        -- itself, which is why the earlier version caused the player to fall.
        local roots = {}
        local rootSeen = {}

        for _, obj in ipairs(Workspace:GetDescendants()) do
            if (obj:IsA("Model") or obj:IsA("Folder") or obj:IsA("BasePart"))
                and not rootSeen[obj]
                and (isRockRoot(obj) or isDecorationRoot(obj) or isFenceRoot(obj) or isLanternRoot(obj)) then

                local root = findDeleteRoot(obj) or obj
                if root and not rootSeen[root] and not protectedEnvironmentObject(root) then
                    rootSeen[root] = true
                    table.insert(roots, root)
                end
            end
        end

        for _, root in ipairs(roots) do
            saveAndDestroyObject(root)
        end
    else
        for _, saved in pairs(savedEnvironmentObjects) do
            if saved and saved.clone and saved.parent and saved.parent.Parent then
                pcall(function()
                    saved.clone.Parent = saved.parent
                end)
            end
        end
        table.clear(savedEnvironmentObjects)
    end
end

