    local species = state.FarmSpecies ~= "All" and state.FarmSpecies or nil
    local mobs = collectMobs(CONFIG.FarmRadius, kind, species)
    return mobs[1], mobs
end

local function findToolByHint(hints)
    local char = Player.Character
    local candidates = {}
    if char then for _,v in ipairs(char:GetChildren()) do if v:IsA("Tool") then table.insert(candidates,v) end end end
    local backpack = Player:FindFirstChildOfClass("Backpack")
    if backpack then for _,v in ipairs(backpack:GetChildren()) do if v:IsA("Tool") then table.insert(candidates,v) end end end
    for _, tool in ipairs(candidates) do
        local n = string.lower(tool.Name)
        for _, hint in ipairs(hints) do if string.find(n, string.lower(hint), 1, true) then return tool end end
    end
    return nil
end

local function nearestTree(radius)
    local root=getRoot(); if not root then return nil end
    local best=nil; local bestD=radius or 160
    for _,tree in ipairs(CollectionService:GetTagged("ChoppableTree")) do
        local pos=getPosition(tree); if pos then local d=(pos-root.Position).Magnitude; if d<bestD then best, bestD=tree,d end end
    end
    return best,bestD
end

