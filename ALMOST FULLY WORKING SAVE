local function archeryAutoShootTick(now, camera, target, bull, rawCenter, targetVelocity)
    if not state.ArcheryAutoShoot or killSwitchActivated then
        return
    end

    if not archeryAutoVirtualMouseHeld
        and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
        archeryAutoGoodFrames = 0
        return
    end

    local bowClient = resolveArcheryBowClient()
    local drawing = false
    local canVerifyDrawing = bowClient and type(bowClient.IsDrawing) == "function"
    if canVerifyDrawing then
        pcall(function() drawing = bowClient.IsDrawing() == true end)
    end

    if not archeryAutoOwnsDraw then
        if now < archeryAutoNextShotAt then return end
        if drawing and not archeryAutoVirtualMouseHeld then
            -- A previous arrow can leave BowClient reporting IsDrawing for a short
            -- time even after our local flags reset. Force an UP once so the next
            -- arrow cannot inherit a stuck held state.
            releaseArcheryAutoDraw(camera)
            archeryAutoNextShotAt = now + 0.06
            return
        end

        if startArcheryAutoDraw(camera) then
            -- V55: each of the 3 arrows starts with a completely fresh release window.
            archeryAutoOwnsDraw = true
            archeryAutoDrawStartedAt = now
            archeryAutoDrawVerifyAt = now + 0.10
            archeryAutoGoodFrames = 0
            archeryRound3WindowScore = 0
            archeryRound3WindowSince = 0
            archeryRound3NineFrames = 0
        end
        return
    end

    -- If BowClient is available, DO NOT trust an input call merely because pcall
    -- returned true. Keep reasserting Mouse1/API hold until IsDrawing() is actually true.
    if canVerifyDrawing then
        if drawing then
            if not archeryAutoConfirmedDraw then
                archeryAutoConfirmedDraw = true
                archeryAutoDrawStartedAt = now -- full-charge timer starts from confirmed draw
            end
        elseif now >= archeryAutoDrawVerifyAt then
            forceArcheryDrawDown(camera)
            archeryAutoDrawVerifyAt = now + 0.10
            archeryAutoGoodFrames = 0
            return
        else
            archeryAutoGoodFrames = 0
            return
        end
    elseif now >= archeryAutoDrawVerifyAt then
        -- No readable IsDrawing() API: keep reasserting the held input periodically.
        forceArcheryDrawDown(camera)
        archeryAutoDrawVerifyAt = now + 0.25
    end

    if now - archeryAutoDrawStartedAt < ARCHERY_AUTO_FULL_CHARGE_SECONDS then
        archeryAutoGoodFrames = 0
        return
    end

    local score, errorDistance, impactTime, trustworthy, usedClosestApproach =
        exactSolvedTrajectoryScore(target, bull, rawCenter, targetVelocity, archeryTrackedAcceleration)

    archeryLatestScore = score
    archeryLatestScoreError = errorDistance
    archeryLatestScoreTime = now

    local speed = typeof(targetVelocity) == "Vector3" and targetVelocity.Magnitude or 0
    local round3 = isRound3Motion(bull, targetVelocity)
    if round3 and (not score or score < 9) then
        archeryLatestScore = 0
    end
    local directionSettle = round3 and ARCHERY_ROUND3_DIRECTION_SETTLE or ARCHERY_AUTO_DIRECTION_SETTLE
    local directionStable = (now - archeryLastDirectionChangeAt) >= directionSettle

    if round3 then
        -- V60 PURE-10 LOOP SCAN. The V57/V58 draw/release lifecycle above remains
        -- untouched; this block ONLY decides when the already-charged bow may release.
        local scan = considerRound3PureTenPhase(
            target, bull, rawCenter, targetVelocity,
            score, errorDistance, trustworthy, usedClosestApproach, now
        )

        if not scan.loopComplete or not scan.bestPosition then
            scan.confirmFrames = 0
            return
        end

        local atBestPhase = isRound3PureTenPhase(rawCenter, targetVelocity)
        local radii = getArcheryRingRadii(target, bull)
        local r10 = radii[1]
        local deepTen = false
        if trustworthy and impactTime and score == 10 and r10 and atBestPhase then
            if usedClosestApproach then
                -- Fallback is allowed only for an extremely deep 10 on a nearly
                -- straight segment. It can never approve 9/8/7/etc.
                deepTen = errorDistance <= r10 * 0.28
                    and archeryRound3TurnFactor <= 0.16
            else
                deepTen = errorDistance <= r10 * 0.72
            end
        end

        if not deepTen then
            scan.confirmFrames = math.max(0, scan.confirmFrames - 1)
            return
        end

        scan.confirmFrames = math.min(4, scan.confirmFrames + 1)
        local neededFrames = usedClosestApproach and 2 or 1
        if scan.confirmFrames >= neededFrames then
            scan.confirmFrames = 0
            releaseArcheryAutoDraw(camera)
            archeryAutoNextShotAt = now + ARCHERY_AUTO_POST_SHOT_COOLDOWN
        end
        return
    end

    -- V56 Rounds 1/2: still STRICT 10 ONLY. The exact solver now uses a realistic
    -- 84% inner-ring safety zone, so one trustworthy solved 10 is enough to release.
    archeryRound3WindowScore = 0
    archeryRound3WindowSince = 0
    archeryRound3NineFrames = 0
    if trustworthy and impactTime and score >= 10 then
        archeryAutoGoodFrames = math.min(3, archeryAutoGoodFrames + 1)
    else
        archeryAutoGoodFrames = math.max(0, archeryAutoGoodFrames - 1)
    end

    if archeryAutoGoodFrames >= 1 then
        releaseArcheryAutoDraw(camera)
        archeryAutoNextShotAt = now + ARCHERY_AUTO_POST_SHOT_COOLDOWN
    end
end

local function findArcheryBull(targetModel)
    if not (targetModel and targetModel:IsA("Model") and targetModel.Parent) then
        return nil
    end

    -- The real ArrowTarget layout contains a nested Model named "Target" holding
    -- the concentric rings. Search MODELS first; never trust a random BasePart
    -- named Target because runtime hitboxes can remain stationary/invisible.
    local targetContainer = nil
    for _, descendant in ipairs(targetModel:GetDescendants()) do
        if descendant:IsA("Model") and descendant.Name == "Target" then
            targetContainer = descendant
            break
        end
    end

    local searchRoot = targetContainer or targetModel
    local best, bestDiameter = nil, math.huge
    for _, descendant in ipairs(searchRoot:GetDescendants()) do
        if descendant:IsA("BasePart") then
            local diameter = circularDiscScore(descendant)
            if diameter and diameter < bestDiameter then
                best = descendant
                bestDiameter = diameter
            end
        end
    end
    return best
end

isBowEquipped = function()
    local character = Player.Character
    if not character then return nil end
    local tool = character:FindFirstChildOfClass("Tool")
    if not tool then return nil end
    local lowered = string.lower(tool.Name)
    if string.find(lowered, "bow", 1, true) then return tool end
    local weaponId = tool:GetAttribute("WeaponId")
    if type(weaponId) == "string" and string.find(string.lower(weaponId), "bow", 1, true) then return tool end
    return nil
end


visibleMobAimPoint = function(target)
    if not target or not isAliveMob(target) then return nil end

    local camera = Workspace.CurrentCamera
    local character = Player.Character
    if not camera or not character then return nil end

    local candidates = {}
    local function add(part)
        if part and part:IsA("BasePart") then
            table.insert(candidates, part.Position)
        end
    end

    add(target:FindFirstChild("Head", true))
    add(target:FindFirstChild("UpperTorso", true))
    add(target:FindFirstChild("Torso", true))
    add(getMobRoot(target))

    local center = getPosition(target)
    if center then table.insert(candidates, center) end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {character}
    params.IgnoreWater = false

    local origin = camera.CFrame.Position
    for _, point in ipairs(candidates) do
        local direction = point - origin
        if direction.Magnitude > 0.001 then
            local hit = Workspace:Raycast(origin, direction, params)
            if not hit or hit.Instance == target or hit.Instance:IsDescendantOf(target) then
                return point
            end
        end
    end

    return nil
end

-- ============================================================
-- MOB BOW FARM / MOB AUTO SHOOT
-- Reuses the script's proven bow DOWN/UP input path. Contest target/scoring
-- logic is not used or modified.
-- ============================================================
do
    local mobBowHeld = false
    local mobBowSavedMouseIcon = nil
    local mobBowSavedMouseBehavior = nil

    local function mobFarmAimPosition(target)
        return visibleMobAimPoint(target)
    end

    local function stopAimWriter()
        local aimConn = connections.MobBowFarmAim
        if aimConn then
            connections.MobBowFarmAim = nil
            pcall(function()
                if typeof(aimConn) == "RBXScriptConnection" then aimConn:Disconnect() end
            end)
        end
    end

    local function restoreMobBowMouseState()
        -- BowClient normally restores this itself, but our synthetic multi-input path
        -- can leave the icon/lock state stale. Restore only what existed before the
        -- mob shot, and never interfere while contest archery is active.
        if not state.ArcheryCenterAim and not state.ArcheryAutoShoot and not archeryAimEnabled then
            if mobBowSavedMouseIcon ~= nil then
                pcall(function()
                    UserInputService.MouseIconEnabled = mobBowSavedMouseIcon
                end)
            end

            if mobBowSavedMouseBehavior ~= nil then
                local camera = Workspace.CurrentCamera
                local firstPerson = false
                if camera then
                    firstPerson = Player.CameraMode == Enum.CameraMode.LockFirstPerson
                        or (camera.CFrame.Position - camera.Focus.Position).Magnitude <= 1
                end

                if not firstPerson then
                    pcall(function()
                        UserInputService.MouseBehavior = mobBowSavedMouseBehavior
                    end)
                end
            end
        end

        mobBowSavedMouseIcon = nil
        mobBowSavedMouseBehavior = nil
        unlockMobAimMouse()
    end

    local function mobBowRelease()
        if mobBowHeld then
            -- This is the same robust UP path used by contest Auto Shoot.
            releaseArcheryAutoDraw(Workspace.CurrentCamera)
        else
            -- Still send an UP in case a previous attempt partially started drawing.
            local bowClient = resolveArcheryBowClient and resolveArcheryBowClient() or nil
            if bowClient and type(bowClient.SetTouchHeld) == "function" then
                pcall(function() bowClient.SetTouchHeld(false) end)
            end
            pcall(function() sendArcheryMouseButton(false, Workspace.CurrentCamera) end)
        end
        mobBowHeld = false
        stopAimWriter()
        restoreMobBowMouseState()
        if guiObjects.UpdateMobBowCrosshair then
            pcall(guiObjects.UpdateMobBowCrosshair)
        end
    end

    stopMobBowFarm = mobBowRelease

    mobBowFarmShot = function(target)
        if killSwitchActivated then return false end
        if not (state.SelectedFarm or state.MobAutoShoot) then return false end
        if not target or not isAliveMob(target) then return false end

        -- Do not fight the separate contest archery system if the user turns it on.
        if state.ArcheryCenterAim or state.ArcheryAutoShoot or archeryAimEnabled then
            return false
        end

        local character = Player.Character
        local humanoid = getHumanoid()
        if not character or not humanoid then return false end

        local bow = isBowEquipped()
        if not bow and guiObjects.EquipOwnedCombatWeapon then
            guiObjects.EquipOwnedCombatWeapon("Bow")
            task.wait(0.08)
            bow = isBowEquipped()
        end

        if not bow then
            bow = findMobBowTool()
            if not bow then return false end
            if not equipMobWeaponVerified(bow) then return false end
            bow = isBowEquipped() or (bow.Parent == character and bow or nil)
        end
        if not bow then return false end

        -- Never begin drawing through a wall/terrain/object.
        if not visibleMobAimPoint(target) then
            return false
        end

        -- The shot follows the SAME mob chosen by Auto Farm / Mob Auto Shoot.
        -- When Mob Aimbot is already enabled, do NOT create a second camera writer.
        stopAimWriter()
        if not state.MobAimbot then
            connections.MobBowFarmAim = RunService.RenderStepped:Connect(function()
                if killSwitchActivated
                    or not (state.SelectedFarm or state.MobAutoShoot)
                    or not target
                    or not isAliveMob(target)
                    or state.ArcheryCenterAim
                    or state.ArcheryAutoShoot
                    or archeryAimEnabled then
                    return
                end

                local camera = Workspace.CurrentCamera
                local aimPosition = mobFarmAimPosition(target)
                if camera and aimPosition and (aimPosition - camera.CFrame.Position).Magnitude > 0.001 then
                    camera.CFrame = CFrame.lookAt(camera.CFrame.Position, aimPosition)
                end
            end)
        end

        -- Give the active aim writer one rendered frame to lock before drawing.
        RunService.RenderStepped:Wait()

        -- Save the user's cursor/mouse-lock state before BowClient hides/locks it.
        mobBowSavedMouseIcon = UserInputService.MouseIconEnabled
        mobBowSavedMouseBehavior = UserInputService.MouseBehavior

        local camera = Workspace.CurrentCamera
        if not forceArcheryDrawDown(camera) then
            mobBowRelease()
            return false
        end
        mobBowHeld = true

        local bowClient = resolveArcheryBowClient()
        local drawing = false
        local verifyDeadline = os.clock() + 0.55
        repeat
            if bowClient and type(bowClient.IsDrawing) == "function" then
                pcall(function() drawing = bowClient.IsDrawing() == true end)
            else
                drawing = true
            end
            if drawing then break end
            if bowClient then pcall(function() bowClient.SetTouchHeld(true) end) end
            sendArcheryMouseButton(true, camera)
            task.wait(0.03)
        until os.clock() >= verifyDeadline
            or killSwitchActivated
            or not (state.SelectedFarm or state.MobAutoShoot)
            or not isAliveMob(target)

        if not drawing and bowClient and type(bowClient.IsDrawing) == "function" then
            mobBowRelease()
            return false
        end

        -- Use the real configured full draw time for this bow.
        local cfg = resolvedArcheryBowConfig(bow)
        local drawTime = cfg and tonumber(cfg.DrawTime) or nil
        drawTime = math.clamp(drawTime or ARCHERY_AUTO_FULL_CHARGE_SECONDS or 1.08, 0.20, 3.00)

        local chargeUntil = os.clock() + drawTime + 0.06
        while os.clock() < chargeUntil do
            if killSwitchActivated
                or not (state.SelectedFarm or state.MobAutoShoot)
                or not isAliveMob(target)
                or state.ArcheryCenterAim
                or state.ArcheryAutoShoot
                or archeryAimEnabled
                or not visibleMobAimPoint(target) then
                mobBowRelease()
                return false
            end
            task.wait(0.02)
        end

        -- Keep the target locked through the actual UP/release.
        if isAliveMob(target)
            and visibleMobAimPoint(target)
            and (state.SelectedFarm or state.MobAutoShoot) then
            releaseArcheryAutoDraw(Workspace.CurrentCamera)
            mobBowHeld = false
            task.wait(0.06)
            stopAimWriter()
            restoreMobBowMouseState()
            if guiObjects.UpdateMobBowCrosshair then
                pcall(guiObjects.UpdateMobBowCrosshair)
            end
            return true
        end

        mobBowRelease()
        return false
    end
end

local function archeryTargetOwner(model)
    -- Return the first duel owner found on the model/wrappers. The game's own bow
    -- code uses _DuelOwner on ArcheryActor models, so explicit ownership is stronger
    -- evidence than camera position or screen-center distance.
    local node = model
    for _ = 1, 6 do
        if not node or node == Workspace then break end
        local owner = node:GetAttribute("_DuelOwner")
        if owner ~= nil then
            local numeric = tonumber(owner)
            return numeric or owner
        end
        node = node.Parent
    end
    return nil
end

local function isForeignArcheryTarget(model)
    local owner = archeryTargetOwner(model)
    return owner ~= nil and owner ~= Player.UserId
end

local function localArcheryOwnerBonus(model)
    local owner = archeryTargetOwner(model)
    return owner == Player.UserId and ARCHERY_LOCAL_OWNER_BONUS or 0
end

local function deleteArcheryCutscene(camera, humanoid)
    if not camera or not humanoid then return end

    -- Hard skip: never let an archery cinematic own the active camera.
    camera.CameraType = Enum.CameraType.Custom
    camera.CameraSubject = humanoid

    -- Purge named cinematic UI/cameras locally. Throttled so this does not scan the
    -- hierarchy every rendered frame. We intentionally do NOT destroy generic scripts
    -- or archery models/targets.
    local now = os.clock()
    if now - archeryLastCutscenePurge < 0.35 then return end
    archeryLastCutscenePurge = now

    local playerGui = Player:FindFirstChildOfClass("PlayerGui")
    if playerGui then
        for _, inst in ipairs(playerGui:GetChildren()) do
            local name = string.lower(inst.Name)
            if (string.find(name, "cutscene", 1, true) or string.find(name, "cinematic", 1, true))
                and inst:IsA("LayerCollector") then
                pcall(function() inst:Destroy() end)
            end
        end
    end

    local live = Workspace:FindFirstChild("ArcheryContest_Live")
    if live then
        for _, inst in ipairs(live:GetDescendants()) do
            if inst:IsA("Camera") then
                local name = string.lower(inst.Name)
                if string.find(name, "cutscene", 1, true)
                    or string.find(name, "cinematic", 1, true)
                    or string.find(name, "intro", 1, true) then
                    pcall(function() inst:Destroy() end)
                end
            end
        end
    end
end

local function rootFrontData(part, root, laneRatio)
    if not (part and part.Parent and root) then return nil end
    local offset = part.Position - root.Position
    local distance = offset.Magnitude
    if distance < 1 or distance > ARCHERY_MAX_TARGET_DISTANCE then return nil end
    local direction = offset.Unit
    local dot = root.CFrame.LookVector:Dot(direction)
    if dot < ARCHERY_FRONT_DOT_MIN then return nil end
    local localPos = root.CFrame:PointToObjectSpace(part.Position)
    local depth = -localPos.Z
    if depth <= 1 then return nil end
    -- Keep the selected target in our shooting lane. Round 3 can move widely, so this
    -- is intentionally generous; it mainly rejects another target sitting off to the
    -- side/in front of the opponent NPC.
    local allowedLane = laneRatio or ARCHERY_MAX_LOCK_LANE_RATIO
    if math.abs(localPos.X) / depth > allowedLane then return nil end
    return localPos, depth, distance, dot
end

local function sampleCandidateMotion(part, now)
    local position = part.Position
    local rec = archeryCandidateMotion[part]
    if not rec then
        rec = {position = position, time = now, speed = 0}
        archeryCandidateMotion[part] = rec
        return 0
    end

    local dt = now - rec.time
    if dt > 0.001 and dt <= 0.30 then
        local speed = (position - rec.position).Magnitude / dt
        rec.speed = math.clamp(speed, 0, ARCHERY_MAX_SELECTION_SPEED)
        rec.position = position
        rec.time = now
    elseif dt > 0.30 then
        rec.position = position
        rec.time = now
        rec.speed = 0
    end
    -- If the late backup pass runs in the same frame, preserve the first sample.
    return rec.speed or 0
end

local function archerySpeedRatio(speed)
    return math.clamp(
        (speed - ARCHERY_SPEED_ADAPT_START) / math.max(ARCHERY_SPEED_ADAPT_FULL - ARCHERY_SPEED_ADAPT_START, 0.001),
        0,
        1
    )
end

local function estimateLiveBullVelocity(bull, now)
    if not (bull and bull.Parent) then
        return Vector3.zero
    end

    local position = bull.Position
    if archeryLastBullPart ~= bull or not archeryLastBullPosition or archeryLastBullTime <= 0 then
        local previousVelocity = archeryTrackedVelocity
        local latestPatternSample = archeryRound3History[#archeryRound3History]
        local provenRound3Continuation = archeryLastBullPart ~= nil
            and archeryRound3Bulls[archeryLastBullPart] == true
            and archeryRound3ShotAnchorPosition ~= nil
            and latestPatternSample ~= nil
            and (now - latestPatternSample.t) <= 1.75
        local carryRound3 = archeryLastBullPart ~= nil
            and archeryRound3PatternBull ~= nil
            and (provenRound3Continuation
                or canCarryRound3PatternToReplacement(now, position, previousVelocity))

        archeryLastBullPart = bull
        archeryLastBullPosition = position
        archeryLastBullTime = now
        archeryTrackedAcceleration = Vector3.zero

        if carryRound3 then
            -- V46: the next Round 3 arrow/target is often a new Instance on the SAME
            -- repeating path. Warm-start tracking from the learned motion cycle, but
            -- reset ONLY per-arrow release state so every new arrow can acquire its own
            -- safe 9/10 firing window instead of inheriting the previous arrow's anchor.
            local seedVelocity = round3ReplacementSeedVelocity(now, position, previousVelocity)
            archeryTrackedVelocity = seedVelocity
            archeryLastObservedVelocity = seedVelocity
            archeryRound3PatternBull = bull
            archeryRound3Bulls[bull] = true

            -- V46 PER-ARROW RESET: keep the learned motion cycle, but NEVER carry the
            -- previous arrow's fired 9/10 phase into the next arrow. Arrow 3, 2 and 1
            -- each need one fresh release decision; reusing arrow 3's anchor is what
            -- made arrows 2/1 hold forever even while valid 9/10 windows passed by.
            archeryRound3ShotAnchorBull = nil
            archeryRound3ShotAnchorPosition = nil
            archeryRound3ShotAnchorDirection = nil
            archeryRound3ShotAnchorSpeed = 0
            archeryRound3ShotAnchorTime = 0
            archeryRound3ShotAnchorPeriod = 0
            archeryRound3WindowScore = 0
            archeryRound3WindowSince = 0
            archeryRound3NineFrames = 0
            archeryAutoGoodFrames = 0

            archeryRound3WarmStartBull = bull
            archeryRound3WarmStartUntil = now + 0.16
            recordRound3PatternSample(bull, now, position, seedVelocity)
            return seedVelocity
        end

        archeryTrackedVelocity = Vector3.zero
        archeryLastObservedVelocity = nil
        resetRound3PatternHistory(bull)
        archeryRound3WarmStartBull = nil
        archeryRound3WarmStartUntil = 0
        recordRound3PatternSample(bull, now, position, Vector3.zero)
        return Vector3.zero
    end

    local dt = now - archeryLastBullTime
    -- applyAim can run twice in one rendered frame. Ignore the duplicate sample instead
    -- of turning a tiny dt into a huge fake velocity.
    if dt < 0.004 then
        return archeryTrackedVelocity
    end

    if dt > 0.30 then
        local knownRound3 = archeryRound3Bulls[bull] == true
            or archeryRound3PatternBull == bull
            or archeryRound3PatternConfidence >= ARCHERY_ROUND3_PATTERN_MIN_CONFIDENCE
        archeryLastBullPosition = position
        archeryLastBullTime = now
        archeryTrackedAcceleration = Vector3.zero

        -- V47: a normal pause between Round 3 arrows is NOT a stationary target.
        -- Warm-start the same target from the learned repeating path instead of
        -- resetting velocity to zero and forcing the camera to chase from behind.
        if knownRound3 and #archeryRound3History >= 18
            and dt <= ARCHERY_ROUND3_PATTERN_HISTORY + 0.75 then
            local seedVelocity = round3ReplacementSeedVelocity(now, position, archeryTrackedVelocity)
            archeryTrackedVelocity = seedVelocity
            archeryLastObservedVelocity = seedVelocity
            archeryRound3Bulls[bull] = true
            archeryRound3WarmStartBull = bull
            archeryRound3WarmStartUntil = now + 0.20
            recordRound3PatternSample(bull, now, position, seedVelocity)
            return seedVelocity
        end

        archeryTrackedVelocity = Vector3.zero
        archeryLastObservedVelocity = nil
        if dt > ARCHERY_ROUND3_PATTERN_HISTORY + 0.75 then
            resetRound3PatternHistory(bull)
            archeryRound3WarmStartBull = nil
            archeryRound3WarmStartUntil = 0
        end
        recordRound3PatternSample(bull, now, position, Vector3.zero)
        return Vector3.zero
    end

    local observed = (position - archeryLastBullPosition) / dt
    local speed = observed.Magnitude
    if speed > ARCHERY_MAX_TRACKED_SPEED then
        observed = observed.Unit * ARCHERY_MAX_TRACKED_SPEED
    end

    local rawAcceleration = Vector3.zero
    if archeryLastObservedVelocity then
        rawAcceleration = (observed - archeryLastObservedVelocity) / math.max(dt, 0.004)
        if rawAcceleration.Magnitude > ARCHERY_ROUND3_MAX_ACCEL then
            rawAcceleration = rawAcceleration.Unit * ARCHERY_ROUND3_MAX_ACCEL
        end
    end
    archeryLastObservedVelocity = observed
    archeryTrackedAcceleration = archeryTrackedAcceleration:Lerp(rawAcceleration, ARCHERY_ROUND3_ACCEL_BLEND)

    -- Slow rounds stay filtered and smooth. Round 3 gets a much faster velocity
    -- response so the predictor is not aiming using movement from several frames ago.
    local speedRatio = archerySpeedRatio(speed)
    local previousTracked = archeryTrackedVelocity
    local directionReversed = previousTracked.Magnitude > 0.05 and observed.Magnitude > 0.05
        and previousTracked:Dot(observed) < 0
    local velocityJump = (observed - previousTracked).Magnitude
    if directionReversed or velocityJump > math.max(18, observed.Magnitude * 0.55) then
        archeryLastDirectionChangeAt = now
    end

    if directionReversed then
        archeryTrackedVelocity = archeryTrackedVelocity:Lerp(observed, ARCHERY_REVERSE_VELOCITY_BLEND)
    else
        local blend = ARCHERY_VELOCITY_BLEND
            + (ARCHERY_FAST_VELOCITY_BLEND - ARCHERY_VELOCITY_BLEND) * speedRatio
        archeryTrackedVelocity = archeryTrackedVelocity:Lerp(observed, blend)
    end

    archeryLastBullPosition = position
    archeryLastBullTime = now
    recordRound3PatternSample(bull, now, position, archeryTrackedVelocity)
    return archeryTrackedVelocity
end

local function predictLiveBullPoint(cameraPosition, rawCenter, velocity, bull, acceleration)
    local distance = (rawCenter - cameraPosition).Magnitude
    local speedRatio = archerySpeedRatio(velocity.Magnitude)
    local round3 = isRound3VelocityForBull(bull, velocity)

    -- V52 TEST: Round 3 uses a TURN-AWARE micro live-velocity lead.
    -- V50 (zero lead) trailed behind; V51 (0.14s) sat too far ahead and cut across the
    -- figure-8 bends. Keep a small lead on straights, then collapse it toward the live
    -- bullseye during hard curves/reversals so the camera does not aim through empty space.
    -- No learned-path camera offset and no acceleration camera offset are added here.
    -- The strict 9/10 ballistic RELEASE gate remains unchanged.
    if round3 then
        local speed = velocity.Magnitude
        local turnFactor = 0

        -- Measure CURVATURE using only acceleration perpendicular to current travel.
        -- Forward/back acceleration should not erase useful lead on a straight section.
        if speed > 0.25 and acceleration then
            local direction = velocity.Unit
            local perpendicularAccel = acceleration - direction * acceleration:Dot(direction)
            turnFactor = math.clamp((perpendicularAccel.Magnitude - 28) / 105, 0, 1)
        end

        -- A just-detected reversal/large velocity jump is the riskiest part of the figure 8.
        -- Temporarily force the lead very close to the actual bull until the new direction
        -- has settled, then smoothly restore the straight-section micro lead.
        local sinceDirectionChange = os.clock() - archeryLastDirectionChangeAt
        if sinceDirectionChange < 0.11 then
            local recentTurn = 1 - math.clamp(sinceDirectionChange / 0.11, 0, 1)
            turnFactor = math.max(turnFactor, recentTurn)
        end

        local straightLeadTime = 0.105
        local turnLeadTime = 0.020
        local liveLeadTime = straightLeadTime + (turnLeadTime - straightLeadTime) * turnFactor
        local liveLead = velocity * liveLeadTime

        local straightLeadCap = 2.00
        local turnLeadCap = 0.55
        local liveLeadCap = straightLeadCap + (turnLeadCap - straightLeadCap) * turnFactor
        if liveLead.Magnitude > liveLeadCap then
            liveLead = liveLead.Unit * liveLeadCap
        end

        -- V53: remember how sharply the target is turning. The release gate uses this
        -- only to reject the unreliable bend/crossover portions of the figure-8.
        archeryRound3TurnFactor = turnFactor
        return rawCenter + liveLead, speedRatio
    end

    local maxPredictionTime = ARCHERY_MAX_PREDICTION_TIME
    local flightTime = math.clamp(
        distance / ARCHERY_PREDICTION_ARROW_SPEED + ARCHERY_PREDICTION_LATENCY,
        0,
        maxPredictionTime
    )

    -- Rounds 1/2 keep their existing prediction behavior. Round 3 returned above.
    local predictionStrength = ARCHERY_PREDICTION_STRENGTH
        + (ARCHERY_FAST_PREDICTION_STRENGTH - ARCHERY_PREDICTION_STRENGTH) * speedRatio
    local lead = velocity * flightTime * predictionStrength
    local maxLead = 7.5 + (ARCHERY_MAX_LEAD_DISTANCE - 7.5) * speedRatio
    if lead.Magnitude > maxLead then
        lead = lead.Unit * maxLead
    end
    return rawCenter + lead, speedRatio
end

local function candidateScore(model, bull, root, camera, now, sourceBonus)
    -- A newly seen target must stay in the strict shooting lane. Once we have already
    -- locked the correct round target, allow it to travel farther at Round 3's edges
    -- without dropping lock and snapping to the NPC/neighbor target.
    local laneRatio = (model == archeryLockedTarget) and ARCHERY_LOCKED_MAX_LANE_RATIO or ARCHERY_MAX_LOCK_LANE_RATIO
    local localPos, depth, distance, dot = rootFrontData(bull, root, laneRatio)
    if not localPos then return -math.huge end

    local horizontalRatio = math.abs(localPos.X) / depth
    local verticalRatio = math.abs(localPos.Y) / depth
    local motionSpeed = sampleCandidateMotion(bull, now)

    -- V26 IMPORTANT: do NOT use WorldToViewportPoint/current-camera center here.
    -- A round-transition cinematic can swing the camera away for a frame and make the
    -- correct target appear off-screen, which used to drop the lock and select the
    -- neighboring/NPC target. Root-space lane + ownership + motion are camera-proof.
    return -(horizontalRatio * 50000)
        - (verticalRatio * 900)
        + (dot * 2600)
        - (distance * 0.02)
        + (motionSpeed * ARCHERY_ACTIVE_MOTION_BONUS)
        + (sourceBonus or 0)
        + localArcheryOwnerBonus(model)
end

local function findLiveArcheryTarget(root, camera)
    local now = os.clock()
    local bestModel, bestBull, bestScore = nil, nil, -math.huge
    local lockedBull, lockedScore = nil, -math.huge
    local seen = {}

    local function consider(model, sourceBonus)
        if not (model and model:IsA("Model") and model.Parent) or seen[model] then return end
        seen[model] = true
        if isForeignArcheryTarget(model) then return end

        local bull = findArcheryBull(model)
        if not bull then return end
        local score = candidateScore(model, bull, root, camera, now, sourceBonus)
        if score == -math.huge then return end

        if model == archeryLockedTarget then
            lockedBull, lockedScore = bull, score
        end
        if score > bestScore then
            bestModel, bestBull, bestScore = model, bull, score
        end
    end

    -- The bow client explicitly watches ArcheryActor-tagged models during archery.
    for _, actor in ipairs(CollectionService:GetTagged("ArcheryActor")) do
        if actor:IsA("Model") then
            consider(actor, 5000)
        end
    end

    local live = Workspace:FindFirstChild("ArcheryContest_Live")
    if live then
        for _, inst in ipairs(live:GetDescendants()) do
            if inst:IsA("Model") then
                local n = inst.Name
                if n == "ArrowTarget" or string.sub(n, 1, 14) == "ArcheryTarget_" or CollectionService:HasTag(inst, "ArcheryActor") then
                    consider(inst, 3500)
                end
            end
        end
    end

    for _, child in ipairs(Workspace:GetChildren()) do
        if child:IsA("Model") and child.Name == "ArrowTarget" then
            consider(child, 1000)
        end
    end

    if not bestModel then
        for _, inst in ipairs(Workspace:GetDescendants()) do
            if inst:IsA("Model") and inst.Name == "ArrowTarget" then
                consider(inst, 0)
            end
        end
    end

    -- Hysteresis: once we have the correct live target, do not bounce to a nearby
    -- candidate just because its score wins by a tiny amount for one frame. We still
    -- allow a clearly better/new moving target to take over at round transitions.
    if archeryLockedTarget and lockedBull and lockedScore > -math.huge then
        local age = now - archeryLockChosenAt
        if age <= ARCHERY_LOCK_KEEP_SECONDS
            or bestModel == archeryLockedTarget
            or lockedScore >= bestScore - ARCHERY_TARGET_SWITCH_MARGIN then
            return archeryLockedTarget, lockedBull
        end
    end

    if bestModel and bestModel ~= archeryLockedTarget then
        archeryLockChosenAt = now
    end
    return bestModel, bestBull
end

local function softClearArcheryInterArrowLock()
    -- Preserve Round 3 motion history/last sample through short target-hidden periods.
    -- Only the dead live target/camera smoothing is cleared.
    archeryLockedTarget = nil
    archeryLockedBull = nil
    archerySmoothedAimPoint = nil
    archerySmoothedTarget = nil
    archeryLastAimTime = 0
    archeryLockChosenAt = 0
end

local function clearArcheryLock()
    archeryLockedTarget = nil
    archeryLockedBull = nil
    archeryLastBullPart = nil
    archeryLastBullPosition = nil
    archeryLastBullTime = 0
    archeryTrackedVelocity = Vector3.zero
    archeryTrackedAcceleration = Vector3.zero
    archeryLastObservedVelocity = nil
    archerySmoothedAimPoint = nil
    archerySmoothedTarget = nil
    archeryLastAimTime = 0
    archeryLockChosenAt = 0
    archeryLatestScore = 0
    archeryLatestScoreError = math.huge
    archeryLatestScoreTime = 0
    archeryRound3ModelDisagreement = math.huge
    archeryLastMatchSeenAt = 0
    archeryRound3WindowScore = 0
    archeryRound3WindowSince = 0
    archeryRound3NineFrames = 0
    archeryRound3WarmStartBull = nil
    archeryRound3WarmStartUntil = 0
    resetRound3PatternHistory(nil)
    resetRound3TenScan()
end

local function restoreArcheryShiftLockY()
    local character = Player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        local offset = humanoid.CameraOffset
        humanoid.CameraOffset = Vector3.new(offset.X, 0, offset.Z)
    end
end

