guiObjects.InventorySafetySweep = function()
    -- IMPORTANT: this routine only ever sends SetFavorite(serial, true).
    -- It never sends false for any item.
    local ctx = guiObjects.InventorySafetyContext()
    if not ctx then return 0 end

    local protected, data = guiObjects.InventorySafetyProtectedSerials()
    if not data or type(data.Inventory) ~= "table" then
        return 0
    end

    local changed = 0
    local now = os.clock()
    local pending = guiObjects.InventorySafetyPending

    for _, category in pairs(data.Inventory) do
        if type(category) == "table" then
            for serial, inst in pairs(category) do
                if type(serial) == "string" and type(inst) == "table" then
                    if protected[serial] then
                        if inst.Favorited == true then
                            pending[serial] = nil
                        else
                            local last = pending[serial] or 0
                            if now - last >= 0.12 then
                                pending[serial] = now
                                pcall(function()
                                    -- Exact contract used by the real inventory UI:
                                    -- SetFavorite:FireServer(serial, boolean)
                                    ctx.SetFavorite:FireServer(serial, true)
                                end)
                                changed = changed + 1
                            end
                        end
                    else
                        pending[serial] = nil
                    end
                end
            end
        end
    end

    return changed
end


