stopArcheryAim = function()
    pcall(function() RunService:UnbindFromRenderStep(POLY_ARCHERY_BIND) end)
    if archeryLateConn then
        pcall(function() archeryLateConn:Disconnect() end)
        archeryLateConn = nil
    end
    restoreArcheryShiftLockY()
    clearArcheryLock()
    table.clear(archeryCandidateMotion)
end

local function setArcheryAim(enabled)
    archeryAimEnabled = enabled == true
    stopArcheryAim()
    if not archeryAimEnabled or killSwitchActivated then return end

    local function applyAim()
        if killSwitchActivated or not archeryAimEnabled then return end
        local character = Player.Character
        local tickNow = os.clock()
        if not character or character:GetAttribute("_ArcheryMatch") ~= true or not isBowEquipped() then
            -- V47: the game briefly hides/replaces archery state between Round 3 arrows.
            -- Do not destroy the learned loop during that short transition.
            if archeryLastMatchSeenAt > 0 and tickNow - archeryLastMatchSeenAt <= 2.25
                and #archeryRound3History >= 18 then
                softClearArcheryInterArrowLock()
            else
                clearArcheryLock()
            end
            return
        end
        archeryLastMatchSeenAt = tickNow

        local root = character:FindFirstChild("HumanoidRootPart")
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        local camera = Workspace.CurrentCamera
        if not root or not humanoid or not camera then return end

        -- V35: hard-skip archery cinematics before target selection. The late render
        -- priority then writes the live target-facing CFrame.
        deleteArcheryCutscene(camera, humanoid)

        -- KEEP the confirmed centered Shift-Lock correction.
        local shiftOffset = humanoid.CameraOffset
        humanoid.CameraOffset = Vector3.new(shiftOffset.X, ARCHERY_SHIFTLOCK_OFFSET_Y, shiftOffset.Z)

        -- V23: resolve live candidates every frame, but keep the winner sticky with hysteresis so the camera does not bounce between nearby targets.
        -- This is the important change for Round 2 (vertical) and Round 3 (all-axis).
        local target, bull = findLiveArcheryTarget(root, camera)
        if not target or not bull then
            if #archeryRound3History >= 18 and os.clock() - archeryLastMatchSeenAt <= 2.25 then
                softClearArcheryInterArrowLock()
            else
                clearArcheryLock()
            end
            return
        end
        archeryLockedTarget = target
        archeryLockedBull = bull

        -- V23: start from the exact live bullseye point, then add ONLY movement lead.
        -- A stationary bull has zero velocity, so its aim remains exactly where V20 centered it.
        local rawCenter = bull.Position + Vector3.new(0, ARCHERY_CENTER_OFFSET_Y, 0)
        local now = os.clock()
        local velocity = estimateLiveBullVelocity(bull, now)
        local aimPoint, speedRatio = predictLiveBullPoint(camera.CFrame.Position, rawCenter, velocity, bull, archeryTrackedAcceleration)
        if (aimPoint - camera.CFrame.Position).Magnitude < 0.001 then return end

        -- V45: when Round 3 first proves itself (or a same-path replacement appears),
        -- do not ease from the zero-lead/raw-center acquisition point. Snap the aim
        -- filter directly onto the first valid Round 3 predicted point, then resume
        -- normal high-response smoothing. This fixes the bad tracking start without
        -- changing the proven prediction/release constants.
        local round3Now = isRound3VelocityForBull(bull, velocity)
        local warmStart = round3Now and (
            archeryRound3WarmStartBull ~= bull
            or now <= archeryRound3WarmStartUntil
        )
        if round3Now and archeryRound3WarmStartBull ~= bull then
            archeryRound3WarmStartBull = bull
            archeryRound3WarmStartUntil = now + 0.12
            warmStart = true
        end
        if warmStart then
            archerySmoothedTarget = target
            archerySmoothedAimPoint = aimPoint
            archeryLastAimTime = now
        end

        -- Smooth only while following the SAME live target. If the contest genuinely
        -- swaps to a new target/round, reset immediately instead of dragging the old
        -- aim point across the screen.
        if warmStart then
            -- already snapped above
        elseif archerySmoothedTarget ~= target or not archerySmoothedAimPoint or archeryLastAimTime <= 0 then
            archerySmoothedTarget = target
            archerySmoothedAimPoint = aimPoint
            archeryLastAimTime = now
        else
            local dt = math.clamp(now - archeryLastAimTime, 0, 0.10)
            archeryLastAimTime = now
            -- Preserve V22 smoothness at low speed, but remove most of the visible
            -- tracking lag during Round 3 by increasing response with target speed.
            local response = ARCHERY_AIM_SMOOTH_RESPONSE
                + (ARCHERY_FAST_AIM_SMOOTH_RESPONSE - ARCHERY_AIM_SMOOTH_RESPONSE) * (speedRatio or 0)
            local alpha = 1 - math.exp(-response * dt)
            archerySmoothedAimPoint = archerySmoothedAimPoint:Lerp(aimPoint, alpha)
        end

        local finalPoint = archerySmoothedAimPoint or aimPoint
        if (finalPoint - camera.CFrame.Position).Magnitude < 0.001 then return end
        camera.CFrame = CFrame.lookAt(camera.CFrame.Position, finalPoint)

        -- V27: aim still uses the responsive live predictor, but AUTO RELEASE no
        -- longer trusts the camera ray. The gate queries BowClient.AimDir() and
        -- simulates the same solved ballistic trajectory the game is about to fire.
        -- rawCenter + measured velocity lets the gate compare that arrow against the
        -- target's future position at impact time.
        archeryAutoShootTick(now, camera, target, bull, rawCenter, velocity)
    end

    -- ONE camera writer only. V21 also attached RenderStepped, which caused two aim
    -- updates in the same rendered frame and made the screen visibly twitch.
    RunService:BindToRenderStep(POLY_ARCHERY_BIND, ARCHERY_FINAL_PRIORITY, applyAim)
end

