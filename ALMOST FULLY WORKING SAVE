local ARCHERY_AUTO_10_ONLY_SECONDS = 0.30
local ARCHERY_AUTO_9_ONLY_SECONDS = 0.72
local ARCHERY_AUTO_TARGET_LATENCY = 0.030
local ARCHERY_AUTO_TIMING_UNCERTAINTY = 0.030
