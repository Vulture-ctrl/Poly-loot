local function getRemote(name)
    local direct = ReplicatedStorage:FindFirstChild(name, true)
    if direct and (direct:IsA("RemoteEvent") or direct:IsA("RemoteFunction")) then
        return direct
    end
    return nil
end

local function fireRemote(name, ...)
    local args = {...}
    local remote = getRemote(name)
    if not remote then
        return false, "Remote not found: " .. name
    end
    if remote:IsA("RemoteEvent") then
        local ok, err = pcall(function()
            remote:FireServer(table.unpack(args))
        end)
        return ok, err
    end
    return false, "RemoteFunction requires an explicit InvokeServer contract: " .. name
end

