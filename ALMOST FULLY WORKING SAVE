local function mobSpecies(mob)
    if not mob then return nil end
    local attr = mob:GetAttribute("Animal")
    if type(attr) == "string" and attr ~= "" then return attr end
    local lowName = string.lower(mob.Name)
    for species, aliases in pairs(MOB_ALIASES) do
        for _, alias in ipairs(aliases) do
            if lowName == string.lower(alias) then
                return species
            end
        end
    end
    for species in pairs(MOB_ALIASES) do
        if string.find(lowName, string.lower(species), 1, true) then
            return species
        end
    end
    return nil
end

local function mobKind(mob)
    local species = mobSpecies(mob)
    if species and PASSIVE_SPECIES[species] then return "Passive" end
    if species and AGGRESSIVE_SPECIES[species] then return "Aggressive" end
    local live = getMobFolder()
    if live then
        local ag = live:FindFirstChild("Aggressors")
        local pa = live:FindFirstChild("Passives")
        if ag and mob:IsDescendantOf(ag) then return "Aggressive" end
        if pa and mob:IsDescendantOf(pa) then return "Passive" end
    end
    return "Unknown"
end

local function getMobRoot(mob)
    if not mob then return nil end
    if mob:IsA("BasePart") then return mob end
    local root = mob:FindFirstChild("HumanoidRootPart", true)
    if root and root:IsA("BasePart") then return root end
    local primary = mob:IsA("Model") and mob.PrimaryPart or nil
    if primary then return primary end
    return mob:FindFirstChildWhichIsA("BasePart", true)
end

local function isAliveMob(mob)
    if not mob or not mob.Parent then return false end
    local tagged = CollectionService:HasTag(mob, "Mob")
    local live = getMobFolder()
    local inLive = live and mob:IsDescendantOf(live)
    if not tagged and not inLive then return false end
    local hum = mob:FindFirstChildOfClass("Humanoid") or firstDescendantOfClass(mob, "Humanoid")
    if hum and hum.Health <= 0 then return false end
    if mob:GetAttribute("_Dying") == true then return false end
    return getPosition(mob) ~= nil
end

local function collectMobs(radius, kindFilter, speciesFilter)
    local root = getRoot()
    if not root then return {} end
    local found, seen = {}, {}
    local candidates = CollectionService:GetTagged("Mob")
    local live = getMobFolder()
    if live then
        local ag = live:FindFirstChild("Aggressors")
        local pa = live:FindFirstChild("Passives")
        for _, folder in ipairs({ag, pa}) do
            if folder then
                for _, mob in ipairs(folder:GetChildren()) do
                    if not seen[mob] then
                        seen[mob] = true
                        table.insert(candidates, mob)
                    end
                end
            end
        end
    end
    for _, mob in ipairs(candidates) do
        if not seen[mob] then seen[mob] = true end
        if isAliveMob(mob) then
            local species = mobSpecies(mob)
            local kind = mobKind(mob)
            local pos = getPosition(mob)
            local matchesKind = (not kindFilter or kind == kindFilter)
            local matchesSpecies = (not speciesFilter or species == speciesFilter)
            if pos and (pos-root.Position).Magnitude <= (radius or CONFIG.MobRadius) and matchesKind and matchesSpecies then
                table.insert(found, mob)
            end
        end
    end
    table.sort(found, function(a,b)
        local ap,bp = getPosition(a), getPosition(b)
        return ap and bp and (ap-root.Position).Magnitude < (bp-root.Position).Magnitude
    end)
    return found
end

local function collectOre(radius, oreFilter)
    local root = getRoot()
    local folder = Workspace:FindFirstChild("Ore_Live")
    if not root or not folder then return {} end
    local found = {}
    for _, ore in ipairs(folder:GetChildren()) do
        if ore:IsA("BasePart") or ore:IsA("Model") then
            local pos = getPosition(ore)
            local name = ore.Name
            local oreName = string.match(name, "^(.-) Ore Node$") or name
            if pos and (pos-root.Position).Magnitude <= (radius or 300) and (not oreFilter or oreName == oreFilter) then
                table.insert(found, {object=ore, name=oreName, position=pos})
            end
        end
    end
    table.sort(found, function(a,b) return (a.position-root.Position).Magnitude < (b.position-root.Position).Magnitude end)
    return found
end

local function collectDrops(radius)
    local root = getRoot()
    if not root then return {} end
    local result, seen = {}, {}
    for _, folderName in ipairs({"WorldBits", "Animal_LocalDrops"}) do
        local folder = Workspace:FindFirstChild(folderName)
        if folder then
            for _, obj in ipairs(folder:GetDescendants()) do
                local candidate = obj:IsA("ProximityPrompt") and obj.Parent or obj
                if candidate and not seen[candidate] then
                    local prompt = getPromptForObject and getPromptForObject(candidate) or candidate:FindFirstChildWhichIsA("ProximityPrompt", true)
                    local pos = getPosition(candidate)
                    if prompt and pos and (pos-root.Position).Magnitude <= (radius or CONFIG.LootRadius) then
                        seen[candidate] = true
                        table.insert(result, candidate)
                    end
                end
            end
        end
    end
    table.sort(result, function(a,b)
        local ap,bp = getPosition(a),getPosition(b)
        return ap and bp and (ap-root.Position).Magnitude < (bp-root.Position).Magnitude
    end)
    return result
end

