local function circularDiscScore(part)
    if not (part and part:IsA("BasePart") and part.Parent) then
        return nil
    end
    -- Never let an invisible collision/hitbox become the bullseye.
    if part.Transparency >= 0.95 then
        return nil
    end
    local sx, sy, sz = part.Size.X, part.Size.Y, part.Size.Z
    local dims = {sx, sy, sz}
    table.sort(dims)
    local thickness, a, b = dims[1], dims[2], dims[3]
    local diameter = (a + b) * 0.5
    if diameter < 0.45 then return nil end
    if math.abs(a - b) > math.max(0.08, diameter * 0.08) then return nil end
    if thickness > diameter * 0.45 then return nil end
    return diameter
end

local function findArcheryTargetContainer(targetModel)
    if not (targetModel and targetModel:IsA("Model") and targetModel.Parent) then
        return nil
    end
    for _, descendant in ipairs(targetModel:GetDescendants()) do
        if descendant:IsA("Model") and descendant.Name == "Target" then
            return descendant
        end
    end
    return targetModel
end

local function getArcheryRingRadii(targetModel, bull)
    local root = findArcheryTargetContainer(targetModel)
    local radii = {}
    if root then
        for _, descendant in ipairs(root:GetDescendants()) do
            if descendant:IsA("BasePart") then
                local diameter = circularDiscScore(descendant)
                if diameter then
                    table.insert(radii, diameter * 0.5)
                end
            end
        end
    end
    table.sort(radii)

    -- Remove near-duplicate radii from overlapping decorative discs.
    local unique = {}
    for _, radius in ipairs(radii) do
        if #unique == 0 or math.abs(radius - unique[#unique]) > 0.04 then
            table.insert(unique, radius)
        end
    end

    -- The live target uses evenly expanding concentric rings. If the runtime model
    -- exposes only the bull disc, infer the next two score radii from that spacing.
    if #unique < 3 and bull then
        local diameter = circularDiscScore(bull)
        local base = diameter and diameter * 0.5 or math.max(bull.Size.Y, bull.Size.Z) * 0.5
        unique[1] = unique[1] or base
        unique[2] = unique[2] or base * 2
        unique[3] = unique[3] or base * 3
    end
    return unique
end

local function bullPlaneNormal(bull)
    local size = bull.Size
    if size.X <= size.Y and size.X <= size.Z then
        return bull.CFrame.RightVector
    elseif size.Y <= size.X and size.Y <= size.Z then
        return bull.CFrame.UpVector
    end
    return bull.CFrame.LookVector
end

local function isRound3VelocityForBull(bull, targetVelocity)
    if not bull then
        return false
    end
    -- Once this live bull proves it is the all-direction Round 3 target, keep that
    -- classification through its fast reversals/brief zero-velocity turnarounds.
    if archeryRound3Bulls[bull] then
        return true
    end
    if typeof(targetVelocity) ~= "Vector3" then
        return false
    end

    local speed = targetVelocity.Magnitude
    if speed < ARCHERY_ROUND3_MIN_SPEED then
        return false
    end

    local localVelocity = bull.CFrame:VectorToObjectSpace(targetVelocity)
    local size = bull.Size
    local lateralSpeed
    if size.X <= size.Y and size.X <= size.Z then
        lateralSpeed = math.abs(localVelocity.Z)
    elseif size.Y <= size.X and size.Y <= size.Z then
        lateralSpeed = math.abs(localVelocity.X)
    else
        lateralSpeed = math.abs(localVelocity.X)
    end

    if lateralSpeed >= ARCHERY_ROUND3_MIN_LATERAL_SPEED then
        archeryRound3Bulls[bull] = true
        return true
    end
    return false
end

local function resetRound3PatternHistory(bull)
