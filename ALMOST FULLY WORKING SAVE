    return b
end

local function slider(parentPage, labelText, key, minValue, maxValue, defaultValue, decimals, callback)
    local row=Instance.new("Frame"); row.Size=UDim2.new(1,-4,0,62); row.BackgroundColor3=Color3.fromRGB(23,26,34); row.BorderSizePixel=0; row.Parent=parentPage; Instance.new("UICorner",row).CornerRadius=UDim.new(0,8)
    local lbl=Instance.new("TextLabel"); lbl.BackgroundTransparency=1; lbl.Position=UDim2.fromOffset(12,5); lbl.Size=UDim2.new(1,-100,0,20); lbl.Font=Enum.Font.GothamMedium; lbl.TextSize=12; lbl.TextXAlignment=Enum.TextXAlignment.Left; lbl.TextColor3=Color3.fromRGB(230,233,240); lbl.Text=labelText; lbl.Parent=row
    local val=Instance.new("TextLabel"); val.BackgroundTransparency=1; val.Position=UDim2.new(1,-82,0,5); val.Size=UDim2.fromOffset(70,20); val.Font=Enum.Font.GothamBold; val.TextSize=12; val.TextXAlignment=Enum.TextXAlignment.Right; val.TextColor3=Color3.fromRGB(145,220,255); val.Parent=row
    local bar=Instance.new("Frame"); bar.Position=UDim2.fromOffset(12,36); bar.Size=UDim2.new(1,-24,0,8); bar.BackgroundColor3=Color3.fromRGB(42,46,58); bar.BorderSizePixel=0; bar.Parent=row; Instance.new("UICorner",bar).CornerRadius=UDim.new(1,0)
    local fill=Instance.new("Frame"); fill.BackgroundColor3=Color3.fromRGB(88,170,235); fill.BorderSizePixel=0; fill.Parent=bar; Instance.new("UICorner",fill).CornerRadius=UDim.new(1,0)
    local knob=Instance.new("TextButton"); knob.Text=""; knob.AutoButtonColor=false; knob.Size=UDim2.fromOffset(16,16); knob.AnchorPoint=Vector2.new(.5,.5); knob.BackgroundColor3=Color3.fromRGB(235,240,247); knob.BorderSizePixel=0; knob.Parent=bar; Instance.new("UICorner",knob).CornerRadius=UDim.new(1,0)
    local value=tonumber(defaultValue) or minValue
    local drag=false
    local function draw(v)
        if killSwitchActivated then return end
        value=math.clamp(v,minValue,maxValue)
        if decimals then local m=10^decimals; value=math.floor(value*m+.5)/m end
        local a=(value-minValue)/math.max(maxValue-minValue,.001)
        fill.Size=UDim2.new(a,0,1,0); knob.Position=UDim2.new(a,0,.5,0)
        val.Text=string.format("%."..tostring(decimals or 0).."f",value)
        if callback then callback(value) end
    end
    local function at(x)
        if killSwitchActivated or not bar.Parent then return end
        draw(minValue+(maxValue-minValue)*math.clamp((x-bar.AbsolutePosition.X)/math.max(bar.AbsoluteSize.X,1),0,1))
    end
    local c1 = knob.MouseButton1Down:Connect(function() drag=true end)
    local c2 = bar.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then drag=true; at(i.Position.X) end end)
    local c3 = UserInputService.InputChanged:Connect(function(i) if drag and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then at(i.Position.X) end end)
    local c4 = UserInputService.InputEnded:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then drag=false end end)
    table.insert(connections,c1); table.insert(connections,c2); table.insert(connections,c3); table.insert(connections,c4)
    draw(value); guiObjects["slider_"..key]=draw; return row
end

