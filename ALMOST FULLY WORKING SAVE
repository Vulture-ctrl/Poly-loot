guiObjects.InventorySafetyItemProtected = function(serial, inst, def, weaponDefs)
    if type(serial) ~= "string" or type(inst) ~= "table" then
        return false
    end

    def = type(def) == "table" and def or {}

    local normalize = guiObjects.InventorySafetyNormalize
    local idName = normalize(inst.Id)
    local displayName = normalize(def.Display)
    local toolTemplateName = normalize(def.ToolTemplate)
    local itemTemplateName = normalize(def.ItemTemplate)
    local weaponIdName = normalize(def.WeaponId)

    local rarity = string.lower(tostring(def.Rarity or inst.Rarity or ""))
    if guiObjects.InventorySafetyRarities[rarity] then
        return true, "rarity:" .. rarity
    end

    -- Protect the whole A/S/Z rank families regardless of +/- sign.
    -- Example item data uses Rank="S", Sign="+" rather than one combined "S+" field.
    local rank = string.lower(tostring(inst.Rank or def.Rank or ""))
    local sign = tostring(inst.Sign or def.Sign or "")
    if guiObjects.InventorySafetyRanks[rank] then
        return true, "rank:" .. string.upper(rank) .. sign
    end

    local exact = guiObjects.InventorySafetyExactNames
    for _, name in ipairs({idName, displayName, toolTemplateName, itemTemplateName, weaponIdName}) do
        if name ~= "" and exact[name] then
            return true, "protected-name"
        end
    end

    local combined = table.concat({
        idName,
        displayName,
        toolTemplateName,
        itemTemplateName,
        weaponIdName,
    }, " ")

    -- Extra aliases for safe items whose internal IDs may omit spaces
    -- or include a longer display/template name.
    local compactCombined = string.gsub(combined, "%s+", "")
    if string.find(combined, "cloth", 1, true)
        or string.find(combined, "fabric", 1, true)
        or string.find(combined, "reset point", 1, true)
        or string.find(compactCombined, "resetpoints", 1, true)
        or string.find(combined, "crystal ore", 1, true)
        or string.find(compactCombined, "crystalore", 1, true) then
        return true, "safe-item-alias"
    end

    -- Entire protected item families.
    if string.find(combined, "shard", 1, true) then
        return true, "all-shards"
    end
    if string.find(combined, "totem", 1, true) then
        return true, "all-totems"
    end
    if string.find(combined, "potion", 1, true) then
        return true, "all-potions"
    end
    if string.find(combined, "tier scroll", 1, true) then
        return true, "tier-scroll"
    end
    if def.Kind == "Chest" then
        return true, "all-chests"
    end

    if def.Kind == "Weapon" then
        local weaponDef = weaponDefs[def.WeaponId or inst.Id]
        local weaponType = weaponDef and weaponDef.Type or nil

        -- All bows and all pickaxes stay protected regardless of rarity/DPS.
        if weaponType == "Bow" then
            return true, "all-bows"
        end
        if weaponType == "Pickaxe" then
            return true, "all-pickaxes"
        end
    end

    -- All Crystal armor pieces are permanent-safe, including Boots.
    if def.Kind == "Armor" and string.find(combined, "crystal", 1, true) then
        return true, "crystal-armor"
    end

    return false
end

guiObjects.InventorySafetyProtectedSerials = function()
    local ctx = guiObjects.InventorySafetyContext()
    if not ctx then return {}, nil end

    local replica = ctx.PlayerData:Get()
    if not replica then
        replica = ctx.PlayerData:WaitFor()
    end

    local data = replica and replica.Data or nil
    if not data then return {}, nil end

    local protected = {}

    -- Every currently equipped item remains favorited.
    if type(data.Equipped) == "table" then
        for _, serial in pairs(data.Equipped) do
            if type(serial) == "string" and serial ~= "" then
                protected[serial] = "currently-equipped"
            end
        end
    end

    -- Hotbar entries count as current loadout too, including weapon slot 1.
    if type(data.Hotbar) == "table" then
        for _, serial in pairs(data.Hotbar) do
            if type(serial) == "string" and serial ~= "" then
                protected[serial] = "current-hotbar"
            end
        end
    end

    local inventory = data.Inventory
    if type(inventory) ~= "table" then
        return protected, data
    end

    -- Always protect the strongest owned weapon by the game's real DPS formula,
    -- even if that weapon is Common.
    local bestWeaponSerial = nil
    local bestWeaponDps = -math.huge
    local weapons = inventory.Weapons
    if type(weapons) == "table" then
        for serial, inst in pairs(weapons) do
            if type(serial) == "string" and type(inst) == "table" then
                local def = ctx.ItemRegistry[inst.Id]
                if def and def.Kind == "Weapon" then
                    local dps = 0
                    local okDps, value = pcall(function()
                        return ctx.WeaponDPS.For(inst, data)
                    end)
                    if okDps then
                        dps = tonumber(value) or 0
                    end

                    if dps > bestWeaponDps then
                        bestWeaponDps = dps
                        bestWeaponSerial = serial
                    end
                end
            end
        end
    end

    if bestWeaponSerial then
        protected[bestWeaponSerial] = "best-owned-weapon"
    end

    -- Protect the strongest owned armor piece for every armor slot,
    -- regardless of rarity. This is separate from Auto Equip Best Armor:
    -- Inventory Safety protects it from sell/dismantle even if not equipped yet.
    local bestArmorBySlot = {}
    local bestArmorScoreBySlot = {}
    local armors = inventory.Armors

    if type(armors) == "table" then
        local armorStat = nil
        pcall(function()
            armorStat = require(
                ReplicatedStorage:WaitForChild("Stats_Engine")
                    :WaitForChild("ArmorStat")
            )
        end)

        for serial, inst in pairs(armors) do
            if type(serial) == "string" and type(inst) == "table" then
                local def = ctx.ItemRegistry[inst.Id]
                if def
                    and def.Kind == "Armor"
                    and type(def.ArmorSlot) == "string"
                    and (tonumber(data.Level) or 0) >= (tonumber(def.LevelReq) or 0) then

                    local score = 0

                    if armorStat and type(armorStat.For) == "function" then
                        local okFor, value = pcall(function()
                            return armorStat.For(inst)
                        end)
                        if okFor then
                            score = tonumber(value) or score
                        end
                    elseif armorStat and type(armorStat.Power) == "function" then
                        local okPower, value = pcall(function()
                            return armorStat.Power(inst, data)
                        end)
                        if okPower then
                            score = tonumber(value) or score
                        end
                    end

                    local slot = def.ArmorSlot
                    if bestArmorScoreBySlot[slot] == nil
                        or score > bestArmorScoreBySlot[slot] then

                        bestArmorScoreBySlot[slot] = score
                        bestArmorBySlot[slot] = serial
                    end
                end
            end
        end
    end

    for slot, serial in pairs(bestArmorBySlot) do
        if type(serial) == "string" and serial ~= "" then
            protected[serial] = "best-owned-armor:" .. tostring(slot)
        end
    end

    -- Protect permanent rarities, named items and protected item families.
    for _, category in pairs(inventory) do
        if type(category) == "table" then
            for serial, inst in pairs(category) do
                if type(serial) == "string" and type(inst) == "table" then
                    local def = ctx.ItemRegistry[inst.Id]
                    local keep, reason = guiObjects.InventorySafetyItemProtected(
                        serial,
                        inst,
                        def,
                        ctx.WeaponDefs
                    )

                    if keep then
                        protected[serial] = reason or "protected"
                    end
                end
            end
        end
    end

    return protected, data
end

