toggle(mobFarm, "Auto Farm Selected", "SelectedFarm", function(enabled)
    disconnect("SelectedFarm")
    if stopMobBowFarm then pcall(stopMobBowFarm) end
    if not enabled then
        state.CurrentTarget = nil
        if stopMobBowFarm then pcall(stopMobBowFarm) end
        unlockMobAimMouse()
        return
    end

    -- Equip the selected combat mode immediately when farming starts.
    if setMobCombatMode then
        pcall(function() setMobCombatMode(state.MobCombatMode, true) end)
    end

    connections.SelectedFarm = task.spawn(function()
        while state.SelectedFarm and not stopFlags.SelectedFarm and not killSwitchActivated do
            local target = state.CurrentTarget
            if not target or not mobMatchesSelectedTarget(target) then
                target = findBestFarmTarget()
                state.CurrentTarget = target
            end

            local root = getRoot()
            if target and root and isAliveMob(target) then
                local pos = getPosition(target)

                if state.MobCombatMode == "Bow" then
                    if not visibleMobAimPoint(target) then
                        for _, candidate in ipairs(collectSelectedMobs(CONFIG.FarmRadius)) do
                            if visibleMobAimPoint(candidate) then
                                target = candidate
                                state.CurrentTarget = candidate
                                pos = getPosition(candidate)
                                break
                            end
                        end
                    end

                    -- Bow: approach only enough to keep a practical shot, then let the
                    -- bow helper own one camera writer and a full-charge shot.
                    if pos and (root.Position - pos).Magnitude > 80 then
                        moveNear(pos, 60)
                        local approachDeadline = os.clock() + 2.0
                        repeat
                            task.wait(0.05)
                            root = getRoot()
                            pos = getPosition(target)
                        until killSwitchActivated
                            or not state.SelectedFarm
                            or not isAliveMob(target)
                            or not root
                            or not pos
                            or (root.Position - pos).Magnitude <= 70
                            or os.clock() >= approachDeadline
                    end

                    if state.SelectedFarm and isAliveMob(target) and mobBowFarmShot then
                        mobBowFarmShot(target)
                    end
                else
                    -- Melee: equip the best detected melee weapon first.
                    local hum = getHumanoid()
                    local currentTool = Player.Character and Player.Character:FindFirstChildOfClass("Tool") or nil
                    local currentWeaponId = currentTool and currentTool:GetAttribute("WeaponId") or nil
                    local currentLooksBow = currentTool and (
                        string.find(string.lower(currentTool.Name), "bow", 1, true)
                        or (type(currentWeaponId) == "string"
                            and string.find(string.lower(currentWeaponId), "bow", 1, true))
                    )

                    if (not currentTool or currentLooksBow) and guiObjects.EquipOwnedCombatWeapon then
                        guiObjects.EquipOwnedCombatWeapon("Melee")
                        task.wait(0.05)
                    end

                    local weapon = findBestMeleeTool and findBestMeleeTool() or nil
                    if hum and weapon and weapon.Parent ~= Player.Character then
                        equipMobWeaponVerified(weapon)
                    end

                    -- Actually get into melee range before sending WeaponAttack.
                    if pos and (root.Position - pos).Magnitude > 10 then
                        moveNear(pos, 8)
                        local approachDeadline = os.clock() + 2.5
                        repeat
                            task.wait(0.04)
                            root = getRoot()
                            pos = getPosition(target)
                        until killSwitchActivated
                            or not state.SelectedFarm
                            or not isAliveMob(target)
                            or not root
                            or not pos
                            or (root.Position - pos).Magnitude <= 10
                            or os.clock() >= approachDeadline
                    end

                    root = getRoot()
                    pos = getPosition(target)
                    if root and pos and isAliveMob(target) and (root.Position - pos).Magnitude <= 12 then
                        local equipped = Player.Character and Player.Character:FindFirstChildOfClass("Tool")
                        if equipped then pcall(function() equipped:Activate() end) end
                        local r = getRemote("WeaponAttack")
                        if r and r:IsA("RemoteEvent") then
                            pcall(function() r:FireServer(0) end)
                        end
                    end
                end
            else
                state.CurrentTarget = nil
            end

            task.wait(math.max(CONFIG.AttackDelay, 0.05))
        end

        if stopMobBowFarm then pcall(stopMobBowFarm) end
        state.CurrentTarget = nil
    end)
end)
