function toggleAutoClicker()
    if not cheats.autoClick and cheats.autoClickCooldown > tick() then
        local remaining = math.ceil(cheats.autoClickCooldown - tick())
        status.Text = "Cooldown: wait " .. remaining .. "s"
        return
