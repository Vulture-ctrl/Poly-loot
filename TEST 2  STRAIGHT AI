local function lockAboveGargoyle(targetMob)
    if not targetMob then return end
    
    local rootPart = targetMob:FindFirstChild("HumanoidRootPart") or targetMob:FindFirstChildWhichIsA("BasePart")
    if not rootPart then return end
    
    local char = player.Character
    if not char then return end
    local playerRoot = char:FindFirstChild("HumanoidRootPart")
    if not playerRoot then return end
    local hum = char:FindFirstChild("Humanoid")
    if hum then
        hum.AutoRotate = false
        hum.PlatformStand = false   -- allow attacks
    end
    
    local targetPos = rootPart.Position + Vector3.new(0, 5.1, 0)
    
    -- Instant teleport to position and face down
    playerRoot.CFrame = CFrame.new(targetPos, rootPart.Position)
    
    -- Create BodyPosition to keep hovering
    if not gargoyleBodyPosition or not gargoyleBodyPosition.Parent then
        if gargoyleBodyPosition then gargoyleBodyPosition:Destroy() end
        gargoyleBodyPosition = Instance.new("BodyPosition")
        gargoyleBodyPosition.MaxForce = Vector3.new(1e6, 1e6, 1e6)
        gargoyleBodyPosition.D = 5000
        gargoyleBodyPosition.P = 20000
        gargoyleBodyPosition.Parent = playerRoot
    end
    gargoyleBodyPosition.Position = targetPos
    
    -- Also a BodyVelocity to keep still
    if not gargoyleBodyVelocity or not gargoyleBodyVelocity.Parent then
        if gargoyleBodyVelocity then gargoyleBodyVelocity:Destroy() end
        gargoyleBodyVelocity = Instance.new("BodyVelocity")
        gargoyleBodyVelocity.MaxForce = Vector3.new(1e6, 1e6, 1e6)
        gargoyleBodyVelocity.Velocity = Vector3.new(0,0,0)
        gargoyleBodyVelocity.Parent = playerRoot
    end
    
    currentGargoyleTarget = targetMob
    
    if gargoyleStatusLabel then
        gargoyleStatusLabel.Text = "Gargoyle: LOCKED ✅"
        gargoyleStatusLabel.TextColor3 = Color3.fromRGB(0,255,100)
    end
end

function toggleGargoyleFarm()
    if gargoyleFarmRunning then
        gargoyleFarmRunning = false
        if gargoyleFarmThread then
            task.cancel(gargoyleFarmThread)
            gargoyleFarmThread = nil
        end
        -- Clean up BodyPosition and BodyVelocity
        local char = player.Character
        if char then
            local root = char:FindFirstChild("HumanoidRootPart")
            if root then
                if gargoyleBodyPosition then gargoyleBodyPosition:Destroy() end
                if gargoyleBodyVelocity then gargoyleBodyVelocity:Destroy() end
            end
            local hum = char:FindFirstChild("Humanoid")
            if hum then
                hum.AutoRotate = true
            end
        end
        gargoyleBodyPosition = nil
        gargoyleBodyVelocity = nil
        currentGargoyleTarget = nil
        status.Text = "Gargoyle farm stopped"
        if gargoyleBtn then
            gargoyleBtn.Text = "Gargoyle Farm (OFF)"
            gargoyleBtn.BackgroundColor3 = Color3.fromRGB(200, 60, 60)
        end
        if gargoyleStatusLabel then
            gargoyleStatusLabel.Text = "Gargoyle: OFF"
            gargoyleStatusLabel.TextColor3 = Color3.fromRGB(200,200,200)
        end
        return
    end
    
    local char = player.Character
    if not char then
        status.Text = "Character not loaded"
        return
    end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then
        status.Text = "RootPart not found"
        return
    end
    
    gargoyleFarmRunning = true
    currentGargoyleTarget = nil
    if gargoyleBtn then
        gargoyleBtn.Text = "Gargoyle Farm (ON)"
        gargoyleBtn.BackgroundColor3 = Color3.fromRGB(60, 200, 60)
    end
    if gargoyleStatusLabel then
        gargoyleStatusLabel.Text = "Gargoyle: ACTIVE"
        gargoyleStatusLabel.TextColor3 = Color3.fromRGB(0,255,100)
    end
    status.Text = "Gargoyle farming started"
    
    gargoyleFarmThread = task.spawn(function()
        while gargoyleFarmRunning do
            local mob, dist = getNearestGargoyle()
            
            if mob then
                lockAboveGargoyle(mob)
                status.Text = "🔒 Locked above Gargoyle (dist " .. math.floor(dist) .. ")"
            else
                status.Text = "No Gargoyle found, scanning..."
                if gargoyleStatusLabel then
                    gargoyleStatusLabel.Text = "Gargoyle: SCANNING 🔍"
                    gargoyleStatusLabel.TextColor3 = Color3.fromRGB(255,200,50)
                end
                -- Clean up if no mob
                if gargoyleBodyPosition then gargoyleBodyPosition:Destroy() end
                if gargoyleBodyVelocity then gargoyleBodyVelocity:Destroy() end
                gargoyleBodyPosition = nil
                gargoyleBodyVelocity = nil
                currentGargoyleTarget = nil
                task.wait(1)
            end
            task.wait(0.3)
        end
    end)
