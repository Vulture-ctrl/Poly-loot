local function getNearestLoot()
    local char = player.Character
    if not char then return nil end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    local pos = root.Position
    local nearest, nearestDist = nil, 50
    
    local dropsFolder = Workspace:FindFirstChild("Drops")
    if dropsFolder then
        for _, obj in ipairs(dropsFolder:GetDescendants()) do
            if obj:IsA("BasePart") or obj:IsA("Model") then
                local d = 999
                if obj:IsA("BasePart") then
                    d = (obj.Position - pos).Magnitude
                elseif obj:IsA("Model") and obj.PrimaryPart then
                    d = (obj.PrimaryPart.Position - pos).Magnitude
                elseif obj:IsA("Model") then
                    local part = obj:FindFirstChildWhichIsA("BasePart")
                    if part then
                        d = (part.Position - pos).Magnitude
                    end
                end
                if d < nearestDist then
                    nearestDist = d
                    nearest = obj
                end
            end
        end
    end
    
    local serverDrops = Workspace:FindFirstChild("Animal_ServerDrops")
    if serverDrops then
        for _, obj in ipairs(serverDrops:GetDescendants()) do
            if obj:IsA("BasePart") or obj:IsA("Model") then
                local d = 999
                if obj:IsA("BasePart") then
                    d = (obj.Position - pos).Magnitude
                elseif obj:IsA("Model") and obj.PrimaryPart then
                    d = (obj.PrimaryPart.Position - pos).Magnitude
                end
                if d < nearestDist then
                    nearestDist = d
                    nearest = obj
                end
            end
        end
    end
    
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Parent and obj.Parent:IsA("Model") then
            local name = string.lower(obj.Name)
            if name:match("drop") or name:match("crate") or name:match("item") or name:match("loot") or name:match("chest") or name:match("bag") then
                local d = (obj.Position - pos).Magnitude
                if d < nearestDist then
                    nearestDist = d
                    nearest = obj
                end
            end
        end
    end
    
    return nearest, nearestDist
end

local function instantLoot()
    local char = player.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    local item, dist = getNearestLoot()
    if not item then
        status.Text = "No loot found nearby"
        return
    end
    
    local targetPos
    if item:IsA("BasePart") then
        targetPos = item.Position + Vector3.new(0, 2, 0)
    elseif item:IsA("Model") and item.PrimaryPart then
        targetPos = item.PrimaryPart.Position + Vector3.new(0, 2, 0)
    elseif item:IsA("Model") then
        local part = item:FindFirstChildWhichIsA("BasePart")
        if part then
            targetPos = part.Position + Vector3.new(0, 2, 0)
        else
            return
        end
    else
        return
    end
    
    status.Text = "Moving to loot at walk speed 74..."
    
    -- Tween using walk speed (74) instead of fixed duration
    tweenAtWalkSpeed(targetPos)
    
    -- Wait a tiny bit to ensure arrival
    task.wait(0.1)
    
    -- Verify item still exists
    local stillExists = false
    if item:IsA("BasePart") and item.Parent then
        stillExists = true
    elseif item:IsA("Model") and item.Parent then
        stillExists = true
    end
    if not stillExists then
        status.Text = "Loot disappeared, skipping"
        return
    end
    
    status.Text = "Holding E for " .. CONFIG.LootHoldSeconds .. " seconds..."
    holdKey(Enum.KeyCode.E, CONFIG.LootHoldSeconds)
    
    -- Also try remote pickup (just in case)
    pcall(function()
        local pickupRemote = ReplicatedStorage:FindFirstChild("Pickup_Client", true)
        if pickupRemote and pickupRemote:IsA("RemoteEvent") then
            pickupRemote:FireServer(item)
            return
        end
        local itemEngine = ReplicatedStorage:FindFirstChild("Item_Engine", true)
        if itemEngine then
            local pickup = itemEngine:FindFirstChild("PickupItem", true)
            if pickup and pickup:IsA("RemoteEvent") then
                pickup:FireServer(item)
                return
            end
        end
        local remote = ReplicatedStorage:FindFirstChild("Remote", true)
        if remote and remote:IsA("RemoteEvent") then
            remote:FireServer("Pickup", item)
            return
        end
        -- Proximity prompt
        local prompt = nil
        if item.Parent then
            prompt = item.Parent:FindFirstChildWhichIsA("ProximityPrompt")
        end
        if not prompt then
            prompt = item:FindFirstChildWhichIsA("ProximityPrompt")
        end
        if prompt then
            prompt:Fire(player)
        end
    end)
    
    status.Text = "Loot attempted, moving to next..."
    -- Do NOT tween back – stay for next item
end

