    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 13
    btn.Parent = parent
    if callback then
        btn.Activated:Connect(callback)
    end
    return btn
end

