local function closeGUI()
    if running then running = false end
    if cheats.fly then cheats.fly = false; if disableFly then disableFly() end end
    if flyConnection then flyConnection:Disconnect(); flyConnection = nil end
    if clickConnection then clickConnection:Disconnect(); clickConnection = nil end
    if gargoyleFarmThread then task.cancel(gargoyleFarmThread); gargoyleFarmThread = nil end
    -- Clean up boss farms
    for key, data in pairs(bossFarms) do
        if data.running then
            data.running = false
        end
        if bossFarmThreads[key] then
            task.cancel(bossFarmThreads[key])
            bossFarmThreads[key] = nil
        end
        if data.timerConnection then
            data.timerConnection:Disconnect()
            data.timerConnection = nil
        end
        -- Remove body parts
        local char = player.Character
        if char then
            local root = char:FindFirstChild("HumanoidRootPart")
            if root then
                for _, obj in ipairs(root:GetChildren()) do
                    if obj:IsA("BodyPosition") or obj:IsA("BodyVelocity") then
                        obj:Destroy()
                    end
                end
            end
            local hum = char:FindFirstChild("Humanoid")
            if hum then
                hum.AutoRotate = true
            end
        end
    end
    pcall(function() screenGui:Destroy() end)
end

