local function doAntiAFK()
    if not cheats.antiAFK then return end
    local char = player.Character
    if char and char:FindFirstChild("Humanoid") then
        local hum = char.Humanoid
        local moveDir = Vector3.new(math.random(-1,1), 0, math.random(-1,1))
        if moveDir.Magnitude > 0 then
            hum:Move(moveDir.Unit, true)
            task.wait(0.15)
            hum:Move(Vector3.new(0,0,0), true)
        end
    end
end

local function collectGold()
    local char = player.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    local originalPos = root.Position
    
    if CONFIG.CollectUseTeleport then
        status.Text = "Teleporting to Gold Mine..."
        teleportToPosition(GOLD_MINE_POS + Vector3.new(0, 5, 0))
    else
        status.Text = "Walking to Gold Mine..."
        tweenAtWalkSpeed(GOLD_MINE_POS + Vector3.new(0, 5, 0))
    end
    task.wait(0.2)
    
    isAtGoldMine = true
    goldMineStartTime = tick()
    status.Text = "Collecting gold for " .. CONFIG.CollectHoldTime .. "s..."
    
    while isAtGoldMine and (tick() - goldMineStartTime) < CONFIG.CollectHoldTime do
        local collectRemote = ReplicatedStorage:FindFirstChild("CollectRequest", true)
        if collectRemote and collectRemote:IsA("RemoteEvent") then
            pcall(function()
                collectRemote:FireServer(CONFIG.CollectAmount)
                collectCount = collectCount + 1
            end)
        end
        
        local goldEngine = ReplicatedStorage:FindFirstChild("GoldMine_Engine", true)
        if goldEngine then
            local collect = goldEngine:FindFirstChild("CollectRequest", true)
            if collect and collect:IsA("RemoteEvent") then
                pcall(function()
                    collect:FireServer(CONFIG.CollectAmount)
                    collectCount = collectCount + 1
                end)
            end
        end
        
        task.wait(0.5)
    end
    
    isAtGoldMine = false
    status.Text = "Gold collection complete (" .. collectCount .. " total)"
    
    if CONFIG.CollectUseTeleport then
        status.Text = "Teleporting back..."
        teleportToPosition(originalPos)
    else
        status.Text = "Staying at Gold Mine"
    end
end

local function performAction(action)
    if not inventoryCache or next(inventoryCache) == nil then
        status.Text = "Inventory empty – press Refresh Inventory"
        return
    end
    
    local processed = 0
    local failed = 0
    
    for serial, item in pairs(inventoryCache) do
        local success, result = pcall(function()
            if action == "Sell" then
                return sellItem(item)
            elseif action == "Dismantle" then
                return dismantleItem(item)
            elseif action == "Upgrade" then
                return upgradeItem(item, "Damage")
            end
        end)
        if success and result then
            processed = processed + 1
        else
            failed = failed + 1
        end
        if not CONFIG.BatchMode then
            task.wait(0.05)
        end
    end
    
    if processed > 0 then
        status.Text = "Auto-" .. action .. " processed " .. processed .. " items"
    elseif failed > 0 then
        status.Text = "Auto-" .. action .. " failed/skipped " .. failed .. " items"
    end
end

local function startFarm()
    if running then return end
    running = true
    status.Text = "Status: Running"
    status.TextColor3 = Color3.fromRGB(0,255,150)
    attackCount = 0
    collectCount = 0
    lastCollect = tick()
    lastAFK = tick()
    
    task.spawn(function()
        while running do
            local weaponRemote = ReplicatedStorage:FindFirstChild("WeaponAttack", true)
            if CONFIG.EnableAttack and weaponRemote and weaponRemote:IsA("RemoteEvent") then
                pcall(function()
                    weaponRemote:FireServer(0)
                    attackCount = attackCount + 1
                    if attackCount % 50 == 0 then
                        status.Text = "Status: "..attackCount.." attacks"
                    end
                end)
            end
            
            local delay = CONFIG.AttackDelay + math.random() * CONFIG.DelayVariation
            task.wait(delay)
            
            if CONFIG.EnableCollect and (tick() - lastCollect) >= CONFIG.CollectInterval then
                collectGold()
                lastCollect = tick()
            end
            
            if CONFIG.AutoLoot then
                local lootItem, lootDist = getNearestLoot()
                if lootItem and lootDist < 30 then
                    instantLoot()
                end
            end
            
            for _, action in ipairs(autoActions) do
                if actionToggles[action] and actionToggles[action].enabled() then
                    performAction(action)
                    task.wait(0.3)
                end
            end
            
            if cheats.antiAFK and tick() - lastAFK > CONFIG.AntiAFKInterval then
                doAntiAFK()
                lastAFK = tick()
            end
        end
    end)
end

local function stopFarm()
    running = false
    isAtGoldMine = false
    status.Text = "Status: Stopped"
    status.TextColor3 = Color3.fromRGB(255,100,100)
end

