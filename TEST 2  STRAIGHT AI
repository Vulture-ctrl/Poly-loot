local function getBossTimerLabel(bossSignName)
    local success, result = pcall(function()
        local bossSign = Workspace:FindFirstChild(bossSignName)
        if not bossSign then return nil end
        
        local sign = bossSign:FindFirstChild("Sign")
        if sign then
            local surfaceGui = sign:FindFirstChild("SurfaceGui")
            if surfaceGui then
                local template = surfaceGui:FindFirstChild("Template")
                if template then
                    local timer = template:FindFirstChild("TIMER")
                    if timer then return timer end
                end
            end
        end
        
        for _, child in ipairs(bossSign:GetDescendants()) do
            if child:IsA("TextLabel") then
                local name = string.upper(child.Name or "")
                local text = string.upper(child.Text or "")
                if name:find("TIMER") or text:find("ALIVE") or tonumber(text:match("(%d+)")) then
                    return child
                end
            end
        end
        
        return nil
    end)
    return success and result or nil
end

local function isBossAlive(timerLabel)
    if not timerLabel then return true end
    local text = string.upper(timerLabel.Text or "")
    if string.find(text, "ALIVE") then
        return true
    end
    local num = tonumber(text:match("(%d+)"))
    if num then
        return false
    end
    if text == "" then
        return true
    end
    return false
end

local function getBossRespawnTime(timerLabel)
    if not timerLabel then return 0 end
    local text = timerLabel.Text or ""
    local mins = tonumber(text:match("(%d+)m"))
    local secs = tonumber(text:match("(%d+)s"))
    
    if mins and secs then
        return (mins * 60) + secs
    elseif mins then
        return mins * 60
    elseif secs then
        return secs
    end
    
    local num = tonumber(text:match("(%d+)"))
    if num then
        if num > 60 then
            return num
        end
        return num
    end
    return 0
end

local function formatRespawnTime(seconds)
    if not seconds or seconds <= 0 then return "ALIVE 🟢" end
    local mins = math.floor(seconds / 60)
    local secs = seconds % 60
    if mins > 0 then
        if secs > 0 then
            return string.format("%dm %ds", mins, secs)
        else
            return string.format("%dm", mins)
        end
    else
        return string.format("%ds", secs)
    end
end

local function findBossModel(bossName)
    local mobs = Workspace:FindFirstChild("Mobs")
    if mobs then
        for _, obj in ipairs(mobs:GetDescendants()) do
            if obj:IsA("Model") and obj.Name == bossName then
                return obj
            end
        end
    end
    
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and obj.Name == bossName then
            return obj
        end
    end
    
    local lowerName = string.lower(bossName)
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") then
            local objLower = string.lower(obj.Name)
            if objLower:find(lowerName) then
                return obj
            end
        end
    end
    
    return nil
end

local bossFarms = {}
local bossFarmThreads = {}

function toggleBossFarm(bossName, bossSignName, bossDisplayName, btn, statusLabel)
    local key = bossName
    
    if bossFarms[key] and bossFarms[key].running then
        bossFarms[key].running = false
        if bossFarmThreads[key] then
            task.cancel(bossFarmThreads[key])
            bossFarmThreads[key] = nil
        end
        -- Clean up BodyPosition and BodyVelocity
        local char = player.Character
        if char then
            local root = char:FindFirstChild("HumanoidRootPart")
            if root then
                for _, obj in ipairs(root:GetChildren()) do
                    if obj:IsA("BodyPosition") or obj:IsA("BodyVelocity") then
                        obj:Destroy()
                    end
                end
            end
            local hum = char:FindFirstChild("Humanoid")
            if hum then
                hum.AutoRotate = true
            end
        end
        if bossFarms[key].timerConnection then
            bossFarms[key].timerConnection:Disconnect()
            bossFarms[key].timerConnection = nil
        end
        bossFarms[key].currentTarget = nil
        status.Text = bossDisplayName .. " farm stopped"
        if btn then
            btn.Text = bossDisplayName .. " Farm (OFF)"
            btn.BackgroundColor3 = Color3.fromRGB(200, 60, 60)
        end
        if statusLabel then
            statusLabel.Text = bossDisplayName .. ": OFF"
            statusLabel.TextColor3 = Color3.fromRGB(200,200,200)
        end
        return
    end
    
    local char = player.Character
    if not char then
        status.Text = "Character not loaded"
        return
    end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then
        status.Text = "RootPart not found"
        return
    end
    
    if not bossFarms[key] then
        bossFarms[key] = {
            running = false,
            currentTarget = nil,
            isAlive = false,
            timerLabel = nil,
            timerConnection = nil,
            bodyPosition = nil,
            bodyVelocity = nil,
        }
    end
    
    bossFarms[key].running = true
    bossFarms[key].currentTarget = nil
    bossFarms[key].timerLabel = getBossTimerLabel(bossSignName)
    
    if btn then
        btn.Text = bossDisplayName .. " Farm (ON)"
        btn.BackgroundColor3 = Color3.fromRGB(60, 200, 60)
    end
    if statusLabel then
        statusLabel.Text = bossDisplayName .. ": SCANNING 🔍"
        statusLabel.TextColor3 = Color3.fromRGB(255,200,50)
    end
    status.Text = bossDisplayName .. " farming started"
    
    local timerLabel = bossFarms[key].timerLabel
    if timerLabel then
        if bossFarms[key].timerConnection then
            bossFarms[key].timerConnection:Disconnect()
        end
        bossFarms[key].timerConnection = timerLabel:GetPropertyChangedSignal("Text"):Connect(function()
            task.spawn(function()
                local mob = findBossModel(bossName)
                if mob then
                    lockToBoss(key, mob, bossDisplayName, statusLabel)
                end
            end)
        end)
    end
    
    bossFarmThreads[key] = task.spawn(function()
        while bossFarms[key] and bossFarms[key].running do
            if not bossFarms[key].timerLabel then
                bossFarms[key].timerLabel = getBossTimerLabel(bossSignName)
                if bossFarms[key].timerLabel then
                    if bossFarms[key].timerConnection then
                        bossFarms[key].timerConnection:Disconnect()
                    end
                    bossFarms[key].timerConnection = bossFarms[key].timerLabel:GetPropertyChangedSignal("Text"):Connect(function()
                        task.spawn(function()
                            local mob = findBossModel(bossName)
                            if mob then
                                lockToBoss(key, mob, bossDisplayName, statusLabel)
                            end
                        end)
                    end)
                end
            end
            
            local timerLabel = bossFarms[key].timerLabel
            local isAlive = isBossAlive(timerLabel)
            local respawnTime = getBossRespawnTime(timerLabel)
            local formattedTime = formatRespawnTime(respawnTime)
            
            if statusLabel then
                if isAlive then
                    statusLabel.Text = bossDisplayName .. ": ALIVE 🟢"
                    statusLabel.TextColor3 = Color3.fromRGB(0,255,100)
                else
                    if respawnTime > 0 then
                        statusLabel.Text = bossDisplayName .. ": " .. formattedTime .. " ⏳"
                        statusLabel.TextColor3 = Color3.fromRGB(255,200,50)
                    else
                        statusLabel.Text = bossDisplayName .. ": ALIVE 🟢"
                        statusLabel.TextColor3 = Color3.fromRGB(0,255,100)
                    end
                end
            end
            
            local mob = findBossModel(bossName)
            
            if mob then
                lockToBoss(key, mob, bossDisplayName, statusLabel)
            else
                if isAlive then
                    task.wait(0.3)
                else
                    bossFarms[key].currentTarget = nil
                    bossFarms[key].isAlive = false
                    
                    if respawnTime > 0 then
                        status.Text = bossDisplayName .. " respawning in " .. formattedTime
                    else
                        status.Text = bossDisplayName .. " waiting for respawn..."
                    end
                    task.wait(1)
                end
            end
            
            if mob then
                task.wait(0.2)
            elseif respawnTime > 0 and respawnTime < 10 then
                task.wait(0.5)
            else
                task.wait(1)
            end
        end
    end)
end

local function lockToBoss(key, mob, bossDisplayName, statusLabel)
    if not mob or not bossFarms[key] then return end
    
    local rootPart = mob:FindFirstChild("HumanoidRootPart") or mob:FindFirstChildWhichIsA("BasePart")
    if not rootPart then return end
    
    local char = player.Character
    if not char then return end
    local playerRoot = char:FindFirstChild("HumanoidRootPart")
    if not playerRoot then return end
    local hum = char:FindFirstChild("Humanoid")
    if hum then
        hum.AutoRotate = false   -- keep facing down
        hum.PlatformStand = false -- allow attacks
    end
    
    local targetPos = rootPart.Position + Vector3.new(0, 5.1, 0)
    
    -- Instant teleport to position and face down
    playerRoot.CFrame = CFrame.new(targetPos, rootPart.Position)
    
    -- Create BodyPosition to keep hovering (if not already)
    local bp = bossFarms[key].bodyPosition
    if not bp or not bp.Parent then
        bp = Instance.new("BodyPosition")
        bp.MaxForce = Vector3.new(1e6, 1e6, 1e6)
        bp.D = 5000
        bp.P = 20000
        bp.Parent = playerRoot
        bossFarms[key].bodyPosition = bp
    end
    bp.Position = targetPos
    
    -- Also a BodyVelocity to keep still (optional)
    local bv = bossFarms[key].bodyVelocity
    if not bv or not bv.Parent then
        bv = Instance.new("BodyVelocity")
        bv.MaxForce = Vector3.new(1e6, 1e6, 1e6)
        bv.Velocity = Vector3.new(0,0,0)
        bv.Parent = playerRoot
        bossFarms[key].bodyVelocity = bv
    end
    
    bossFarms[key].currentTarget = mob
    bossFarms[key].isAlive = true
    status.Text = "🔒 Locked above " .. bossDisplayName
    
    if statusLabel then
        statusLabel.Text = bossDisplayName .. ": LOCKED ✅"
        statusLabel.TextColor3 = Color3.fromRGB(0,255,100)
    end
end

