local function holdKey(keyCode, duration)
    if VirtualInputManager then
        pcall(function()
            VirtualInputManager:SendKeyEvent(true, keyCode, false, nil)
            task.wait(duration)
            VirtualInputManager:SendKeyEvent(false, keyCode, false, nil)
        end)
    else
        pcall(function()
            local inputService = game:GetService("UserInputService")
            if inputService then
                local downInput = Instance.new("InputObject")
                downInput.UserInputType = Enum.UserInputType.Keyboard
                downInput.KeyCode = keyCode
                downInput.UserInputState = Enum.UserInputState.Begin
                inputService:FireInput(downInput)
                task.wait(duration)
                local upInput = Instance.new("InputObject")
                upInput.UserInputType = Enum.UserInputType.Keyboard
                upInput.KeyCode = keyCode
                upInput.UserInputState = Enum.UserInputState.End
                inputService:FireInput(upInput)
            end
        end)
    end
end

