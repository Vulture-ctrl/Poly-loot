local inventoryItems = {}
local skippedItems = {}

local function getInventoryContainer()
    local backpack = player:FindFirstChild("Backpack")
    if backpack then return backpack end
    local char = player.Character
    if char then
        for _, child in ipairs(char:GetChildren()) do
            if child:IsA("Tool") then
                return char
            end
        end
    end
    local pgui = player:FindFirstChild("PlayerGui")
    if pgui then
        for _, child in ipairs(pgui:GetChildren()) do
            if child.Name:lower():find("inventory") then
                return child
            end
        end
    end
    local rs = ReplicatedStorage
    for _, child in ipairs(rs:GetChildren()) do
        if child.Name:lower():find("inventory") or child.Name:lower():find("items") then
            return child
        end
    end
    return nil
end

local function fetchItemsFromContainer(container)
    local items = {}
    if not container then return items end
    for _, child in ipairs(container:GetChildren()) do
        if child:IsA("Tool") or child:IsA("BasePart") or child:IsA("Model") then
            table.insert(items, child)
        elseif child:IsA("Folder") then
            for _, sub in ipairs(child:GetChildren()) do
                if sub:IsA("Tool") or sub:IsA("BasePart") or sub:IsA("Model") then
                    table.insert(items, sub)
                end
            end
        end
    end
    return items
end

local function requestInventoryViaRemote()
    local success, result = pcall(function()
        local remoteNames = {"GetInventory", "RequestInventory", "InventoryRequest", "GetItems", "RequestItems"}
        for _, name in ipairs(remoteNames) do
            local remote = ReplicatedStorage:FindFirstChild(name, true)
            if remote and remote:IsA("RemoteFunction") then
                local inv = remote:InvokeServer()
                if type(inv) == "table" and #inv > 0 then
                    return inv
                end
            end
        end
        return nil
    end)
    if success and result then
        return result
    end
    return nil
end

local function refreshInventory()
    local items = {}
    local container = getInventoryContainer()
    if container then
        items = fetchItemsFromContainer(container)
    end
    if #items == 0 then
        local remoteItems = requestInventoryViaRemote()
        if remoteItems then
            items = remoteItems
        end
    end
    if #items == 0 then
        for name, data in pairs(ITEM_DB) do
            table.insert(items, {Name = name, Rarity = data.rarity})
        end
    end
    local filtered = {}
    for _, item in ipairs(items) do
        local itemName = item.Name or item.name or ""
        if not skippedItems[itemName] then
            table.insert(filtered, item)
        end
    end
    inventoryItems = filtered
    status.Text = "Inventory: " .. #inventoryItems .. " items"
    return inventoryItems
end

local function isItemFavorite(item)
    if not item then return false end
    if item.Favorited == true or item.Favorite == true or item.favorited == true or item.favorite == true then
        return true
    end
    local name = item.Name or item.name or ""
    if name ~= "" then
        for favName in pairs(FAVORITE_ITEMS) do
            if string.lower(name) == string.lower(favName) then
                return true
            end
        end
    end
    return false
end

