local function sellItem(item)
    if not item or isItemFavorite(item) then return false end
    local sellRemote = ReplicatedStorage:FindFirstChild("Sell", true)
    if sellRemote and sellRemote:IsA("RemoteEvent") then
        pcall(function() sellRemote:FireServer(item) end)
        return true
    end
    local invSell = ReplicatedStorage:FindFirstChild("Inventory_Engine", true)
    if invSell then
        local sell = invSell:FindFirstChild("Sell", true)
        if sell and sell:IsA("RemoteEvent") then
            pcall(function() sell:FireServer(item) end)
            return true
        end
    end
    return false
end

local function dismantleItem(item)
    if not item or isItemFavorite(item) then return false end
    local dismantleRemote = ReplicatedStorage:FindFirstChild("DismantleRequest", true)
    if dismantleRemote and dismantleRemote:IsA("RemoteEvent") then
        pcall(function() dismantleRemote:FireServer(item) end)
        return true
    end
    local craftEngine = ReplicatedStorage:FindFirstChild("Crafting_Engine", true)
    if craftEngine then
        local dismantle = craftEngine:FindFirstChild("DismantleRequest", true)
        if dismantle and dismantle:IsA("RemoteEvent") then
            pcall(function() dismantle:FireServer(item) end)
            return true
        end
    end
    return false
end

local function upgradeItem(item, stat)
    if not item or isItemFavorite(item) then return false end
    stat = stat or "Damage"
    local upgradeRemote = ReplicatedStorage:FindFirstChild("UpgradeRequest", true)
    if upgradeRemote and upgradeRemote:IsA("RemoteEvent") then
        pcall(function() upgradeRemote:FireServer(item, stat) end)
        return true
    end
    local upgradeEngine = ReplicatedStorage:FindFirstChild("Upgrade_Engine", true)
    if upgradeEngine then
        local upgrade = upgradeEngine:FindFirstChild("UpgradeRequest", true)
        if upgrade and upgrade:IsA("RemoteEvent") then
            pcall(function() upgrade:FireServer(item, stat) end)
            return true
        end
    end
    return false
end

