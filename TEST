-- ============================================================
-- FARM LOOP (main)
-- ============================================================
local running = false
local attackCount = 0
local lastCollect = tick()
local lastAFK = tick()

local function startFarm()
    if running then return end
    running = true
    status.Text = "Status: Running"
    status.TextColor3 = Color3.fromRGB(0,255,150)
    attackCount = 0
    lastCollect = tick()
    lastAFK = tick()
    
    task.spawn(function()
        while running do
            local weaponRemote = ReplicatedStorage:FindFirstChild("WeaponAttack", true)
            if CONFIG.EnableAttack and weaponRemote and weaponRemote:IsA("RemoteEvent") then
                pcall(function()
                    weaponRemote:FireServer(0)
                    attackCount = attackCount + 1
                    if attackCount % 50 == 0 then
                        status.Text = "Status: "..attackCount.." attacks"
                    end
                end)
            end
            
            local delay = CONFIG.AttackDelay + math.random() * CONFIG.DelayVariation
            task.wait(delay)
            
            if CONFIG.EnableCollect and (tick() - lastCollect) >= CONFIG.CollectInterval then
                collectGold()
                lastCollect = tick()
            end
            
            if CONFIG.AutoLoot then
                local lootItem, lootDist = getNearestLoot()
                if lootItem and lootDist < 30 then
                    instantLoot()
                end
            end
            
            for _, action in ipairs({"Sell", "Dismantle", "Upgrade"}) do
                if actionToggles[action] and actionToggles[action].enabled() then
                    performAction(action)
                    task.wait(0.3)
                end
            end
            
            if cheats.antiAFK and tick() - lastAFK > CONFIG.AntiAFKInterval then
                doAntiAFK()
                lastAFK = tick()
            end
        end
    end)
end

local function stopFarm()
    running = false
    isAtGoldMine = false
    status.Text = "Status: Stopped"
    status.TextColor3 = Color3.fromRGB(255,100,100)
end

