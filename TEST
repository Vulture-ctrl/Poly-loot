local function closeGUI()
    running = false
    cheats.fly = false
    cheats.autoClick = false

    pcall(disableFly)

    if clickConnection then clickConnection:Disconnect(); clickConnection = nil end
    if gargoyleFarmThread then task.cancel(gargoyleFarmThread); gargoyleFarmThread = nil end

    for key, data in pairs(bossFarms) do
        data.running = false
        if bossFarmThreads[key] then
            task.cancel(bossFarmThreads[key])
            bossFarmThreads[key] = nil
        end
        if data.timerConnection then
            data.timerConnection:Disconnect()
            data.timerConnection = nil
        end
    end

    local char = player.Character
    if char then
        local root = char:FindFirstChild("HumanoidRootPart")
        if root then
            for _, obj in ipairs(root:GetChildren()) do
                if obj.Name == "PolyFlyVelocity" or obj.Name == "PolyFlyAttachment" then
                    obj:Destroy()
                end
            end
        end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then hum.AutoRotate = true end
    end

    pcall(function() screenGui:Destroy() end)
end

