-- ============================================================
-- MOVEMENT HELPERS
-- Path-based TweenService movement: follows Roblox path waypoints
-- while moving slightly above the ground for a "flying" look.
-- ============================================================
local function tweenAlongPath(targetPos, speed)
    local char = player.Character
    if not char then return false end
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not root then return false end

    speed = math.max(tonumber(speed) or 30, 1)

    local startPos = root.Position
    local path = PathfindingService:CreatePath({
        AgentRadius = 2,
        AgentHeight = 5,
        AgentCanJump = true,
        AgentCanClimb = true,
        WaypointSpacing = 5,
    })

    local computed = pcall(function()
        path:ComputeAsync(startPos, targetPos)
    end)

    local waypoints = {}
    if computed and path.Status == Enum.PathStatus.Success then
        waypoints = path:GetWaypoints()
    end

    -- If Roblox cannot build a path, use a short direct tween instead of
    -- getting stuck waiting for a path that does not exist.
    if #waypoints < 2 then
        waypoints = {
            {Position = startPos, Action = Enum.PathWaypointAction.Walk},
            {Position = targetPos, Action = Enum.PathWaypointAction.Walk},
        }
    end

    local oldAutoRotate = hum and hum.AutoRotate
    local oldPlatformStand = hum and hum.PlatformStand
    local wasAnchored = root.Anchored
    if hum then
        hum.AutoRotate = false
        hum.PlatformStand = true
    end
    -- Keep physics from fighting the tween and causing a fling on arrival.
    root.Anchored = true
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero

    for i = 2, #waypoints do
        if not root.Parent then
            if hum then
                hum.AutoRotate = oldAutoRotate
                hum.PlatformStand = oldPlatformStand
            end
            root.Anchored = wasAnchored
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
            return false
        end

        local waypointPos = waypoints[i].Position

        -- Stay a little above the normal walking surface. This makes the
        -- movement look like a smooth low flight instead of walking.
        local isFinal = (i == #waypoints)
        local flyHeight = isFinal and 2.5 or 4
        local movePos = waypointPos + Vector3.new(0, flyHeight, 0)

        -- Handle path jump points without forcing the Humanoid to jump.
        -- The tween simply flies over the obstacle.
        local distance = (movePos - root.Position).Magnitude
        local duration = math.max(distance / speed, 0.08)

        local direction = movePos - root.Position
        local lookAt = direction.Magnitude > 0.05 and (movePos + direction.Unit) or (movePos + root.CFrame.LookVector)
        local targetCFrame = CFrame.lookAt(movePos, lookAt)

        local tweenInfo = TweenInfo.new(
            duration,
            Enum.EasingStyle.Linear,
            Enum.EasingDirection.Out
        )

        local tween = TweenService:Create(root, tweenInfo, {
            CFrame = targetCFrame
        })
        tween:Play()
        tween.Completed:Wait()

        -- Recompute if the character drifted badly from the planned path.
        if (root.Position - movePos).Magnitude > 7 then
            break
        end
    end

    -- Always finish exactly at the requested target.
    if root.Parent then
        local finalPos = targetPos + Vector3.new(0, 2.5, 0)
        local distance = (finalPos - root.Position).Magnitude
        local duration = math.max(distance / speed, 0.08)
        local direction = finalPos - root.Position
        local lookAt = direction.Magnitude > 0.05 and (finalPos + direction.Unit) or (finalPos + root.CFrame.LookVector)

        local finalTween = TweenService:Create(
            root,
            TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out),
            {CFrame = CFrame.lookAt(finalPos, lookAt)}
        )
        finalTween:Play()
        finalTween.Completed:Wait()
    end

    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
    root.Anchored = wasAnchored
    if hum then
        hum.AutoRotate = oldAutoRotate
        hum.PlatformStand = oldPlatformStand
    end
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero

    return true
end

local function tweenAtWalkSpeed(targetPos)
    return tweenAlongPath(targetPos, 30)
end

local function tweenAtSpeed(targetPos, speed)
    return tweenAlongPath(targetPos, math.max(tonumber(speed) or CONFIG.LootPickupSpeed or 50, 1))
end

