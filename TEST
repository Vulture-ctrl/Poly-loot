local function getNearestLoot()
    local char = player.Character
    if not char then return nil end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    local pos = root.Position
    local nearest, nearestDist = nil, 50
    
    local dropsFolder = Workspace:FindFirstChild("Drops")
    if dropsFolder then
        for _, obj in ipairs(dropsFolder:GetDescendants()) do
            if obj:IsA("BasePart") or obj:IsA("Model") then
                local d = 999
                if obj:IsA("BasePart") then
                    d = (obj.Position - pos).Magnitude
                elseif obj:IsA("Model") and obj.PrimaryPart then
                    d = (obj.PrimaryPart.Position - pos).Magnitude
                elseif obj:IsA("Model") then
                    local part = obj:FindFirstChildWhichIsA("BasePart")
                    if part then
                        d = (part.Position - pos).Magnitude
                    end
                end
                if d < nearestDist then
                    nearestDist = d
                    nearest = obj
                end
            end
        end
    end
    
    local serverDrops = Workspace:FindFirstChild("Animal_ServerDrops")
    if serverDrops then
        for _, obj in ipairs(serverDrops:GetDescendants()) do
            if obj:IsA("BasePart") or obj:IsA("Model") then
                local d = 999
                if obj:IsA("BasePart") then
                    d = (obj.Position - pos).Magnitude
                elseif obj:IsA("Model") and obj.PrimaryPart then
                    d = (obj.PrimaryPart.Position - pos).Magnitude
                end
                if d < nearestDist then
                    nearestDist = d
                    nearest = obj
                end
            end
        end
    end
    
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Parent and obj.Parent:IsA("Model") then
            local name = string.lower(obj.Name)
            if name:match("drop") or name:match("crate") or name:match("item") or name:match("loot") or name:match("chest") or name:match("bag") then
                local d = (obj.Position - pos).Magnitude
                if d < nearestDist then
                    nearestDist = d
                    nearest = obj
                end
            end
        end
    end
    return nearest, nearestDist
end

local function lootStillExists(item)
    if not item then return false end
    if item:IsA("BasePart") then
        return item.Parent ~= nil and item.Parent:IsDescendantOf(Workspace)
    elseif item:IsA("Model") then
        return item.Parent ~= nil and item:IsDescendantOf(Workspace)
    end
    return false
end

local function getLootPosition(item)
    if not item then return nil end
    if item:IsA("BasePart") then
        return item.Position + Vector3.new(0, 2, 0)
    elseif item:IsA("Model") and item.PrimaryPart then
        return item.PrimaryPart.Position + Vector3.new(0, 2, 0)
    elseif item:IsA("Model") then
        local part = item:FindFirstChildWhichIsA("BasePart")
        if part then
            return part.Position + Vector3.new(0, 2, 0)
        end
    end
    return nil
end

local function instantLoot()
    local char = player.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    local originalPos = root.Position
    local lootSpeed = CONFIG.LootPickupSpeed or 50
    
    local item, dist = getNearestLoot()
    if not item then
        status.Text = "No loot found nearby"
        return
    end
    
    local targetPos = getLootPosition(item)
    if not targetPos then
        status.Text = "Could not determine loot position"
        return
    end
    
    status.Text = "Walking to loot..."
    tweenAtSpeed(targetPos, lootSpeed)
    task.wait(0.1)
    
    if not lootStillExists(item) then
        status.Text = "Loot disappeared, returning..."
        tweenAtSpeed(originalPos, lootSpeed)
        return
    end
    
    -- Remote pickup first
    local remoteSuccess = false
    pcall(function()
        local pickupRemote = ReplicatedStorage:FindFirstChild("Pickup_Client", true)
        if pickupRemote and pickupRemote:IsA("RemoteEvent") then
            pickupRemote:FireServer(item)
            remoteSuccess = true
            return
        end
        local itemEngine = ReplicatedStorage:FindFirstChild("Item_Engine", true)
        if itemEngine then
            local pickup = itemEngine:FindFirstChild("PickupItem", true)
            if pickup and pickup:IsA("RemoteEvent") then
                pickup:FireServer(item)
                remoteSuccess = true
                return
            end
        end
        local remote = ReplicatedStorage:FindFirstChild("Remote", true)
        if remote and remote:IsA("RemoteEvent") then
            remote:FireServer("Pickup", item)
            remoteSuccess = true
            return
        end
        local prompt = nil
        if item.Parent then
            prompt = item.Parent:FindFirstChildWhichIsA("ProximityPrompt")
        end
        if not prompt then
            prompt = item:FindFirstChildWhichIsA("ProximityPrompt")
        end
        if prompt then
            prompt:Fire(player)
            remoteSuccess = true
        end
    end)
    
    if remoteSuccess then
        status.Text = "Picked up via remote, returning..."
        tweenAtSpeed(originalPos, lootSpeed)
        return
    end
    
    -- Hold E
    status.Text = "Holding E..."
    local startTime = tick()
    local holdDuration = CONFIG.LootHoldSeconds or 2
    
    pcall(function()
        if VirtualInputManager then
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, nil)
        else
            local downInput = Instance.new("InputObject")
            downInput.UserInputType = Enum.UserInputType.Keyboard
            downInput.KeyCode = Enum.KeyCode.E
            downInput.UserInputState = Enum.UserInputState.Begin
            UserInputService:FireInput(downInput)
        end
    end)
    
    while (tick() - startTime) < holdDuration do
        if not lootStillExists(item) then
            status.Text = "Loot picked up! Returning..."
            break
        end
        task.wait(0.15)
    end
    
    pcall(function()
        if VirtualInputManager then
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, nil)
        else
            local upInput = Instance.new("InputObject")
            upInput.UserInputType = Enum.UserInputType.Keyboard
            upInput.KeyCode = Enum.KeyCode.E
            upInput.UserInputState = Enum.UserInputState.End
            UserInputService:FireInput(upInput)
        end
    end)
    
    tweenAtSpeed(originalPos, lootSpeed)
    status.Text = "Loot done."
end

