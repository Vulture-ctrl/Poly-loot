function toggleAutoClicker()
    if not cheats.autoClick and cheats.autoClickCooldown > tick() then
        local remaining = math.ceil(cheats.autoClickCooldown - tick())
        status.Text = "Cooldown: wait " .. remaining .. "s"
        return
    end
    cheats.autoClick = not cheats.autoClick
    if cheats.autoClick then
        cheats.autoClickStartTime = tick() + 3
        cheats.autoClickActive = false
        playerToggles.autoClickToggle.label.Text = "Auto Clicker: Starting in 3s..."
        playerToggles.autoClickToggle.button.Text = "Wait"
        playerToggles.autoClickToggle.button.BackgroundColor3 = Color3.fromRGB(200,200,50)
        miniACBtn.Text = "AC: Wait"
        miniACBtn.BackgroundColor3 = Color3.fromRGB(200,200,50)
    else
        cheats.autoClickStartTime = 0
        cheats.autoClickActive = false
        cheats.autoClickCooldown = tick() + 2
        playerToggles.autoClickToggle.label.Text = "Auto Clicker: OFF (cooldown 2s)"
        playerToggles.autoClickToggle.button.Text = "OFF"
        playerToggles.autoClickToggle.button.BackgroundColor3 = Color3.fromRGB(200,60,60)
        miniACBtn.Text = "AC: CD 2s"
        miniACBtn.BackgroundColor3 = Color3.fromRGB(200,200,50)
    end
end
playerToggles.autoClickToggle.button.Activated:Connect(toggleAutoClicker)
miniACBtn.Activated:Connect(toggleAutoClicker)

RunService.Heartbeat:Connect(function()
    if not cheats.autoClick and cheats.autoClickCooldown > tick() then
        local remaining = cheats.autoClickCooldown - tick()
        if remaining > 0 then
            local display = math.floor(remaining)
            if display < 1 then display = 0 end
            miniACBtn.Text = "AC: CD " .. display .. "s"
            miniACBtn.BackgroundColor3 = Color3.fromRGB(200,200,50)
            playerToggles.autoClickToggle.label.Text = "Auto Clicker: OFF (cooldown " .. display .. "s)"
        else
            cheats.autoClickCooldown = 0
            miniACBtn.Text = "AC: OFF"
            miniACBtn.BackgroundColor3 = Color3.fromRGB(200,60,60)
            playerToggles.autoClickToggle.label.Text = "Auto Clicker: OFF"
            playerToggles.autoClickToggle.button.Text = "OFF"
            playerToggles.autoClickToggle.button.BackgroundColor3 = Color3.fromRGB(200,60,60)
        end
    elseif not cheats.autoClick and cheats.autoClickCooldown ~= 0 then
        cheats.autoClickCooldown = 0
        miniACBtn.Text = "AC: OFF"
        miniACBtn.BackgroundColor3 = Color3.fromRGB(200,60,60)
        playerToggles.autoClickToggle.label.Text = "Auto Clicker: OFF"
        playerToggles.autoClickToggle.button.Text = "OFF"
        playerToggles.autoClickToggle.button.BackgroundColor3 = Color3.fromRGB(200,60,60)
    end
    if not cheats.autoClick then
        if clickConnection then
            clickConnection:Disconnect()
            clickConnection = nil
        end
        return
    end
    if not clickConnection then
        clickConnection = RunService.Heartbeat:Connect(function()
            if not cheats.autoClick then
                clickConnection:Disconnect()
                clickConnection = nil
                return
            end
            if cheats.autoClickStartTime > 0 then
                local remaining = cheats.autoClickStartTime - tick()
                if remaining > 0 then
                    local txt = string.format("AC: Wait %.1fs", remaining)
                    playerToggles.autoClickToggle.label.Text = "Auto Clicker: Starting in " .. string.format("%.1f", remaining) .. "s"
                    playerToggles.autoClickToggle.button.Text = "Wait"
                    miniACBtn.Text = txt
                    miniACBtn.BackgroundColor3 = Color3.fromRGB(200,200,50)
                    return
                else
                    cheats.autoClickActive = true
                    cheats.autoClickStartTime = 0
                    playerToggles.autoClickToggle.label.Text = "Auto Clicker: ACTIVE"
                    playerToggles.autoClickToggle.button.Text = "ON"
                    playerToggles.autoClickToggle.button.BackgroundColor3 = Color3.fromRGB(0,200,100)
                    miniACBtn.Text = "AC: ON"
                    miniACBtn.BackgroundColor3 = Color3.fromRGB(0,200,100)
                end
            end
            if cheats.autoClickActive then
                performClick()
                task.wait(CONFIG.AutoClickSpeed)
            end
        end)
    end
end)

