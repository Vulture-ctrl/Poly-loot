    local originalPos = root.Position
    
    status.Text = "Walking to Gold Mine..."
    tweenAtWalkSpeed(GOLD_MINE_POS + Vector3.new(0, 5, 0))
    task.wait(0.2)
    
    isAtGoldMine = true
    goldMineStartTime = tick()
    status.Text = "Collecting gold..."
    
    while isAtGoldMine and (tick() - goldMineStartTime) < CONFIG.CollectHoldTime do
        local collectRemote = ReplicatedStorage:FindFirstChild("CollectRequest", true)
        if collectRemote and collectRemote:IsA("RemoteEvent") then
            pcall(function()
                collectRemote:FireServer(CONFIG.CollectAmount)
                collectCount = collectCount + 1
            end)
        end
        local goldEngine = ReplicatedStorage:FindFirstChild("GoldMine_Engine", true)
        if goldEngine then
            local collect = goldEngine:FindFirstChild("CollectRequest", true)
            if collect and collect:IsA("RemoteEvent") then
                pcall(function()
                    collect:FireServer(CONFIG.CollectAmount)
                    collectCount = collectCount + 1
                end)
            end
        end
        task.wait(0.5)
    end
    
    isAtGoldMine = false
    status.Text = "Gold collected, returning..."
    tweenAtWalkSpeed(originalPos)
    status.Text = "Gold done."
end

