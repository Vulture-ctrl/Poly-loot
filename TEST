-- ============================================================
-- AUTO ACTION (sell/dismantle/upgrade)
-- ============================================================
local function performAction(action)
    refreshInventory()
    if #inventoryItems == 0 then
        status.Text = "Inventory empty or not found"
        return
    end
    local processed = 0
    local skipped = 0
    local failed = 0
    for _, item in ipairs(inventoryItems) do
        local itemName = item.Name or item.name or "unknown"
        if isItemFavorite(item) then
            skipped = skipped + 1
            skippedItems[itemName] = true
        else
            local success, result = pcall(function()
                if action == "Sell" then
                    return sellItem(item)
                elseif action == "Dismantle" then
                    return dismantleItem(item)
                elseif action == "Upgrade" then
                    return upgradeItem(item, "Damage")
                end
            end)
            if success and result then
                processed = processed + 1
            else
                failed = failed + 1
                skippedItems[itemName] = true
            end
        end
        if not CONFIG.BatchMode then
            task.wait(0.05)
        end
    end
    if processed > 0 then
        status.Text = "Auto-" .. action .. " processed " .. processed .. " items"
    elseif skipped > 0 then
        status.Text = "Auto-" .. action .. " skipped " .. skipped .. " favorites"
    elseif failed > 0 then
        status.Text = "Auto-" .. action .. " failed " .. failed .. " items"
    end
end

